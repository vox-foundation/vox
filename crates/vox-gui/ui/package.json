{
  "name": "vox-gui-ui",
  "version": "0.6.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "tokens:build": "node style-dictionary.config.mjs",
    "bundle": "vite build",
    "build": "pnpm tokens:build && run-p typecheck bundle",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "review:cv-flywheel": "playwright test e2e/review/cv-flywheel.spec.ts --project=chromium",
    "review:capture": "playwright test e2e/review/capture.spec.ts --project=chromium --project=firefox-review --workers=4",
    "review:all": "pnpm review:cv-flywheel && VOX_REVIEW_CAPTURE=1 pnpm review:capture",
    "lint": "tsc --noEmit && vite build",
    "knip": "knip --config knip.jsonc",
    "knip:files": "knip --config knip.jsonc --include files,dependencies",
    "knip:exports": "knip --config knip.jsonc --include exports"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@msgpack/msgpack": "^3.1.3",
    "@tanstack/react-query": "^5.108.3",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "^3.14.28",
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.11.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dockview": "6.6.1",
    "lucide-react": "^1.77.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-resizable-panels": "^4.24.1",
    "recharts": "^3.11.0",
    "tailwind-merge": "^3.7.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^30.0.1",
    "npm-run-all2": "^9.1.0",
    "postcss": "^8.5.33",
    "style-dictionary": "^5.8.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.0.2",
    "vite": "^8.3.8",
    "vitest": "^3.2.6",
    "knip": "5.50.0"
  }
}
