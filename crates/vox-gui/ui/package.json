{
  "name": "vox-gui-ui",
  "version": "0.6.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "tokens:build": "node style-dictionary.config.mjs",
    "bundle": "vite build",
    "build": "pnpm tokens:build && run-p typecheck bundle",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "review:cv-flywheel": "playwright test e2e/review/cv-flywheel.spec.ts --project=chromium",
    "review:capture": "playwright test e2e/review/capture.spec.ts --project=chromium --project=firefox-review --workers=4",
    "review:all": "pnpm review:cv-flywheel && VOX_REVIEW_CAPTURE=1 pnpm review:capture",
    "lint": "tsc --noEmit && vite build"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@msgpack/msgpack": "^3.1.3",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-virtual": "^3.14.22",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.12.0",
    "clsx": "^2.1.1",
    "dockview": "6.6.1",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^30.1.3",
    "npm-run-all2": "^9.0.4",
    "postcss": "^8.5.31",
    "style-dictionary": "^5.7.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.0.2",
    "vite": "^8.3.5",
    "vitest": "^3.2.6"
  },
  "pnpm": {
    "overrides": {
      "esbuild": ">=0.28.1"
    }
  }
}
