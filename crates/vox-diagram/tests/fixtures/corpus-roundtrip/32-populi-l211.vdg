graph {
    node start: "Start" { shape: start }
    node Pending: "Pending"
    node Leased: "Leased"
    node Done: "Done"
    node end: "End" { shape: end }
    start -> Pending: "deliver"
    Pending -> Leased: "inbox+claimer"
    Leased -> Leased: "lease-renew"
    Leased -> Pending: "lease expiry (swept)"
    Leased -> Done: "ack"
    Done -> end
}
