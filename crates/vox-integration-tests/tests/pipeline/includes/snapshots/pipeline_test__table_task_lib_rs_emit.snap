use serde::{Serialize, Deserialize};
use vox_db::Codex;
/// Set by the app shell at startup; lib fns reach the database through it.
pub static VOX_APP_DB: std::sync::OnceLock<std::sync::Arc<Codex>> = std::sync::OnceLock::new();
pub fn as_string<T: serde::Serialize>(v: &T) -> String {
    let val = serde_json::to_value(v).expect("vox codegen: serde_json::to_value failed");
    if let Some(s) = val.as_str() {
        return s.to_string();
    }
    if val.is_f64() {
        if let Some(f) = val.as_f64() {
            if f.is_finite() && f.fract() == 0.0 {
                return format!("{}", f as i64);
            }
        }
    }
    val.to_string()
}
#[derive(Debug, Clone, Serialize, Deserialize)]
pub struct Task {
    #[serde(skip_serializing_if = "Option::is_none")]
    pub _id: Option<i64>,
    pub title: String,
    pub done: bool,
    pub priority: i64,
}
impl Task {
    pub async fn insert(db: &Codex, item: &Self) -> Result<i64, turso::Error> {
        db.connection()
            .execute(
                "INSERT INTO task (title, done, priority) VALUES (?1, ?2, ?3)",
                (
                    turso::Value::Text(item.title.clone()),
                    turso::Value::Integer(item.done as i64),
                    turso::Value::Integer(item.priority),
                ),
            )
            .await?;
        Ok(db.connection().last_insert_rowid())
    }
    pub async fn update(
        db: &Codex,
        id: i64,
        item: &Self,
    ) -> Result<usize, turso::Error> {
        let n = db
            .connection()
            .execute(
                "UPDATE task SET title = ?1, done = ?2, priority = ?3 WHERE _id = ?4",
                (
                    turso::Value::Text(item.title.clone()),
                    turso::Value::Integer(item.done as i64),
                    turso::Value::Integer(item.priority),
                    turso::Value::from(id),
                ),
            )
            .await?;
        Ok(n as usize)
    }
    pub async fn get(db: &Codex, id: i64) -> Result<Option<Self>, turso::Error> {
        let mut rows = db
            .connection()
            .query("SELECT * FROM task WHERE _id = ?1", (id,))
            .await?;
        Ok(
            match rows.next().await? {
                Some(row) => Some(Self::from_row(&row)?),
                None => None,
            },
        )
    }
    pub async fn all(db: &Codex) -> Result<Vec<Self>, turso::Error> {
        let mut rows = db.connection().query("SELECT * FROM task", ()).await?;
        let mut out = Vec::new();
        while let Some(row) = rows.next().await? {
            out.push(Self::from_row(&row)?);
        }
        Ok(out)
    }
    pub async fn all_order_limit(
        db: &Codex,
        order_clause: &str,
        limit: Option<i64>,
    ) -> Result<Vec<Self>, turso::Error> {
        let mut sql = "SELECT * FROM task".to_string();
        if !order_clause.trim().is_empty() {
            sql.push_str(" ORDER BY ");
            sql.push_str(order_clause);
        }
        if let Some(l) = limit {
            sql.push_str(&format!(" LIMIT {}", l.max(0)));
        }
        let mut rows = db.connection().query(&sql, ()).await?;
        let mut out = Vec::new();
        while let Some(row) = rows.next().await? {
            out.push(Self::from_row(&row)?);
        }
        Ok(out)
    }
    pub async fn count(db: &Codex) -> Result<i64, turso::Error> {
        let mut rows = db.connection().query("SELECT COUNT(*) FROM task", ()).await?;
        let row = rows.next().await?.ok_or(turso::Error::QueryReturnedNoRows)?;
        let c: i64 = row.get(0)?;
        Ok(c)
    }
    pub async fn count_where(
        db: &Codex,
        where_clause: &str,
        params: impl turso::IntoParams + Send,
    ) -> Result<i64, turso::Error> {
        let sql = format!("SELECT COUNT(*) FROM task WHERE {}", where_clause);
        let mut rows = db.connection().query(&sql, params).await?;
        let row = rows.next().await?.ok_or(turso::Error::QueryReturnedNoRows)?;
        let c: i64 = row.get(0)?;
        Ok(c)
    }
    /// `WHERE` fragment uses `?1`, `?2`, … placeholders; bind with a positional tuple or `params_from_iter`.
    pub async fn filter_where(
        db: &Codex,
        where_clause: &str,
        params: impl turso::IntoParams + Send,
    ) -> Result<Vec<Self>, turso::Error> {
        let sql = format!("SELECT * FROM task WHERE {}", where_clause);
        let mut rows = db.connection().query(&sql, params).await?;
        let mut out = Vec::new();
        while let Some(row) = rows.next().await? {
            out.push(Self::from_row(&row)?);
        }
        Ok(out)
    }
    pub async fn filter_where_order_limit(
        db: &Codex,
        where_clause: &str,
        params: impl turso::IntoParams + Send,
        order_clause: &str,
        limit: Option<i64>,
    ) -> Result<Vec<Self>, turso::Error> {
        let mut sql = format!("SELECT * FROM task WHERE {}", where_clause);
        if !order_clause.trim().is_empty() {
            sql.push_str(" ORDER BY ");
            sql.push_str(order_clause);
        }
        if let Some(l) = limit {
            sql.push_str(&format!(" LIMIT {}", l.max(0)));
        }
        let mut rows = db.connection().query(&sql, params).await?;
        let mut out = Vec::new();
        while let Some(row) = rows.next().await? {
            out.push(Self::from_row(&row)?);
        }
        Ok(out)
    }
    /// Builds `format!("SELECT * FROM <table> {}", clause)` — use [`Self::all`] or [`Self::get`] when possible.
    pub async fn unsafe_query_raw_clause(
        db: &Codex,
        clause: &str,
    ) -> Result<Vec<Self>, turso::Error> {
        let sql = format!("SELECT * FROM task {}", clause);
        let mut rows = db.connection().query(&sql, ()).await?;
        let mut out = Vec::new();
        while let Some(row) = rows.next().await? {
            out.push(Self::from_row(&row)?);
        }
        Ok(out)
    }
    pub async fn delete(db: &Codex, id: i64) -> Result<usize, turso::Error> {
        let n = db.connection().execute("DELETE FROM task WHERE _id = ?1", (id,)).await?;
        Ok(n as usize)
    }
    pub async fn patch(
        db: &Codex,
        id: i64,
        patch_fields: &serde_json::Map<String, serde_json::Value>,
    ) -> Result<usize, turso::Error> {
        let mut sets: Vec<String> = Vec::new();
        let mut binds: Vec<turso::Value> = Vec::new();
        if let Some(v) = patch_fields.get("title") {
            binds
                .push(
                    match v {
                        serde_json::Value::Null => turso::Value::Null,
                        serde_json::Value::Bool(b) => {
                            turso::Value::Integer(if *b { 1 } else { 0 })
                        }
                        serde_json::Value::Number(n) => {
                            if let Some(i) = n.as_i64() {
                                turso::Value::Integer(i)
                            } else {
                                turso::Value::Real(n.as_f64().unwrap_or(0.0))
                            }
                        }
                        serde_json::Value::String(s) => turso::Value::Text(s.clone()),
                        other => turso::Value::Text(other.to_string()),
                    },
                );
            sets.push(format!("title = ?{}", binds.len()));
        }
        if let Some(v) = patch_fields.get("done") {
            binds
                .push(
                    match v {
                        serde_json::Value::Null => turso::Value::Null,
                        serde_json::Value::Bool(b) => {
                            turso::Value::Integer(if *b { 1 } else { 0 })
                        }
                        serde_json::Value::Number(n) => {
                            if let Some(i) = n.as_i64() {
                                turso::Value::Integer(i)
                            } else {
                                turso::Value::Real(n.as_f64().unwrap_or(0.0))
                            }
                        }
                        serde_json::Value::String(s) => turso::Value::Text(s.clone()),
                        other => turso::Value::Text(other.to_string()),
                    },
                );
            sets.push(format!("done = ?{}", binds.len()));
        }
        if let Some(v) = patch_fields.get("priority") {
            binds
                .push(
                    match v {
                        serde_json::Value::Null => turso::Value::Null,
                        serde_json::Value::Bool(b) => {
                            turso::Value::Integer(if *b { 1 } else { 0 })
                        }
                        serde_json::Value::Number(n) => {
                            if let Some(i) = n.as_i64() {
                                turso::Value::Integer(i)
                            } else {
                                turso::Value::Real(n.as_f64().unwrap_or(0.0))
                            }
                        }
                        serde_json::Value::String(s) => turso::Value::Text(s.clone()),
                        other => turso::Value::Text(other.to_string()),
                    },
                );
            sets.push(format!("priority = ?{}", binds.len()));
        }
        if sets.is_empty() {
            return Ok(0);
        }
        binds.push(turso::Value::from(id));
        let sql = format!(
            "UPDATE task SET {} WHERE _id = ?{}", sets.join(", "), binds.len()
        );
        let n = db.connection().execute(&sql, turso::params_from_iter(binds)).await?;
        Ok(n as usize)
    }
    pub async fn search_hybrid(
        db: &Codex,
        query: &str,
        limit: usize,
    ) -> Result<Vec<Self>, turso::Error> {
        let pattern = format!("%{}%", query.trim().to_ascii_lowercase());
        let sql = format!(
            "SELECT * FROM task WHERE (LOWER(title) LIKE ?1) LIMIT {}", limit.max(1)
        );
        let mut rows = db
            .connection()
            .query(&sql, (turso::Value::Text(pattern),))
            .await?;
        let mut out = Vec::new();
        while let Some(row) = rows.next().await? {
            out.push(Self::from_row(&row)?);
        }
        Ok(out)
    }
    pub async fn bucket_count(
        db: &Codex,
        column: &str,
        limit: usize,
    ) -> Result<Vec<(String, i64)>, turso::Error> {
        let allowed: &[&str] = &["title", "done", "priority"];
        if !allowed.contains(&column) {
            return Err(
                turso::Error::ConversionFailure(
                    format!("invalid bucket column: {}", column),
                ),
            );
        }
        let sql = format!(
            "SELECT CAST({} AS TEXT), COUNT(*) FROM task GROUP BY {} ORDER BY COUNT(*) DESC LIMIT {}",
            column, column, limit.max(1)
        );
        let mut rows = db.connection().query(&sql, ()).await?;
        let mut buckets = Vec::new();
        while let Some(row) = rows.next().await? {
            let key: String = row.get(0).unwrap_or_default();
            let cnt: i64 = row.get(1)?;
            buckets.push((key, cnt));
        }
        Ok(buckets)
    }
    fn from_row(row: &turso::Row) -> Result<Self, turso::Error> {
        let _id_val: i64 = row.get(0)?;
        Ok(Self {
            _id: Some(_id_val),
            title: row.get(1)?,
            done: row.get(2)?,
            priority: row.get(3)?,
        })
    }
}
