NAMESPACE = os.environ.get("VOX_MENS_HF_NAMESPACE", "{{NAMESPACE}}")
INDEX_REPO = f"{NAMESPACE}/vox-mens-index"
PROMPT_PREFIX = "Write a Vox program that: "
_SHA40_RE = re.compile(r"^[0-9a-f]{40}$")

VOX_SYSTEM_PROMPT = """You are a Vox programming language expert and code generation assistant. Vox is an AI-native, full-stack language that compiles to native Rust and TypeScript.

## Rules
- Brace-delimited blocks, no semicolons, no significant indentation. Comments are `//` and `///`.
- Return types use `to`: `fn name(p: T) to U { ... }`. Never `->` for returns (`->` appears only in `state_machine` transitions).
- No null: use `Option[T]`, `Result[T]` (or `Result[T, E]` at API boundaries), and tagged unions.
- `let x = expr`, `let mut x = expr`, `return expr`, `if c { } else { }`, `for x in xs { }`, `match e { Variant(f) => body }`.
- Operators are `and`, `or`, `not`, `is`, `is not`.

## Declarations (bare keywords)
- `type Name { field: T }`, `type Name = | A | B(field: T)`
- `table Name { field: T }`, `query name(p: T) to U { }`, `mutation name(p: T) to U { }`, `server name(p: T) to U { }`
- `tool "name: description" name(p: T) to U { }`, `resource "uri" "description" name() to U { }`
- `component Name() { view: column() { text() { "{x}" } } }`
- `actor Name { on handler(p: T) to U { } }`, `spawn(Name)`
- `workflow name(p: T) to Result[U] { }` calling `activity name(p: T) to Result[U] { }`
- `routes { "/" to Home }`, `state_machine Name { state A state B on Ev() from A -> B }`, `import module.name`
- Modifiers: `@test`, `@pure`, `@uses(net)`, `@scheduled("1h")`, `@auth(scheme: bearer)`, `@deprecated`, `@durable`."""

ACTIVE_SIZES: List[str] = ["0.8B", "2B", "4B", "9B", "27B"]
LADDER_DEFAULTS: Dict[str, Dict[str, Any]] = {
    "0.8B": {"family": "qwen3.5", "base": "Qwen/Qwen3.5-0.8B", "slug": "vox-mens-qwen3.5-0.8b", "no_think_switch": False},
    "2B": {"family": "qwen3.5", "base": "Qwen/Qwen3.5-2B", "slug": "vox-mens-qwen3.5-2b", "no_think_switch": False},
    "4B": {"family": "qwen3.5", "base": "Qwen/Qwen3.5-4B", "slug": "vox-mens-qwen3.5-4b", "no_think_switch": False},
    "9B": {"family": "qwen3.5", "base": "Qwen/Qwen3.5-9B", "slug": "vox-mens-qwen3.5-9b", "no_think_switch": False},
    "27B": {"family": "qwen3.8", "base": "Qwen/Qwen3.8-27B", "slug": "vox-mens-qwen3.8-27b", "no_think_switch": False},
}


def fetch_hub_json(repo_id: str, filename: str) -> Optional[Dict[str, Any]]:
    try:
        path = hf_hub_download(repo_id=repo_id, filename=filename)
        with open(path, "r", encoding="utf-8") as f:
            return json.load(f)
    except Exception:
        return None


def load_live_ladder_index() -> List[Dict[str, Any]]:
    data = fetch_hub_json(INDEX_REPO, "ladder_index.json")
    if not data or "sizes" not in data:
        return []
    return data["sizes"]


def infer_family(base_or_repo: str, size_label: str) -> str:
    low = base_or_repo.lower()
    if "qwen3.8" in low:
        return "qwen3.8"
    if "qwen3.5" in low:
        return "qwen3.5"
    if "qwen3-" in low:
        return "qwen3"
    return LADDER_DEFAULTS.get(size_label, {}).get("family", "qwen3")


def resolve_ladder_meta(size_label: str) -> Dict[str, Any]:
    default = LADDER_DEFAULTS.get(
        size_label,
        {
            "family": "qwen3",
            "base": f"Qwen/Qwen3-{size_label}",
            "slug": f"vox-mens-qwen3-{size_label.lower()}",
            "no_think_switch": True,
        },
    )
    meta = {
        "size": size_label,
        "family": default["family"],
        "base": default["base"],
        "repo_id": f"{NAMESPACE}/{default['slug']}",
        "no_think_switch": default["no_think_switch"],
    }
    for row in load_live_ladder_index():
        if str(row.get("size", "")).upper() == size_label.upper():
            if row.get("repo_id"):
                meta["repo_id"] = str(row["repo_id"])
            if row.get("base_pin"):
                meta["base"] = str(row["base_pin"])
            fam = str(row.get("family") or infer_family(meta["base"] + " " + meta["repo_id"], size_label))
            meta["family"] = fam
            meta["no_think_switch"] = fam == "qwen3"
            break
    return meta


def _traverse_module_path(model: torch.nn.Module, mod_path: str) -> Optional[torch.nn.Module]:
    cur: Any = model
    for part in mod_path.split("."):
        if not hasattr(cur, part):
            return None
        cur = getattr(cur, part)
    return cur


def resolve_target_linear_module(
    model: torch.nn.Module, logical: str, weight_key: str
) -> Optional[torch.nn.Module]:
    if logical == "lm_head" or weight_key in ("lm_head.weight", "model.lm_head.weight"):
        return getattr(model, "lm_head", None)
    if not weight_key.endswith(".weight"):
        return None
    mod_path = weight_key[: -len(".weight")]
    candidates = [mod_path]
    if mod_path.startswith("model.language_model."):
        candidates.append("model." + mod_path[len("model.language_model.") :])
    elif mod_path.startswith("model."):
        candidates.append("model.language_model." + mod_path[len("model.") :])
    for cand in candidates:
        found = _traverse_module_path(model, cand)
        if found is not None:
            return found
    return None


def resolve_use_rslora(
    manifest: Optional[Dict[str, Any]],
    training_manifest: Optional[Dict[str, Any]],
    adapter_meta_v2: Optional[Dict[str, Any]],
    peft_config: Optional[Dict[str, Any]],
) -> bool:
    for src in (peft_config, manifest, training_manifest, adapter_meta_v2):
        if isinstance(src, dict) and isinstance(src.get("use_rslora"), bool):
            return src["use_rslora"]
    return False


class CandleLoRAArm:
    """Attaches Candle (`{logical}.lora_{a,b}.weight`) or PEFT (`lora_{A,B}.weight`) adapters with rsLoRA scaling."""

    def __init__(
        self,
        model: torch.nn.Module,
        manifest: Dict[str, Any],
        tensors: Dict[str, torch.Tensor],
        use_rslora: bool = False,
        peft_config: Optional[Dict[str, Any]] = None,
    ):
        self.enabled = True
        self._handles = []
        rank = max(int((peft_config or {}).get("r") or manifest.get("rank", 16)), 1)
        alpha = float((peft_config or {}).get("lora_alpha") or manifest.get("alpha", 32.0))
        scale = alpha / math.sqrt(rank) if use_rslora else alpha / float(rank)
        base_key_map: Dict[str, str] = manifest.get("base_key_map", {})

        pairs: List[Tuple[str, str, str, str]] = []
        if base_key_map:
            for logical, base_key in base_key_map.items():
                a_key = f"{logical}.lora_a.weight"
                b_key = f"{logical}.lora_b.weight"
                if a_key in tensors and b_key in tensors:
                    pairs.append((logical, base_key, a_key, b_key))
        if not pairs:
            for key in tensors:
                m = re.match(r"^(.*)\.lora_([aA])(?:\.default)?\.weight$", key)
                if not m:
                    continue
                prefix, letter = m.group(1), m.group(2)
                b_letter = "B" if letter == "A" else "b"
                for cand_b in (f"{prefix}.lora_{b_letter}.weight", f"{prefix}.lora_{b_letter}.default.weight"):
                    if cand_b in tensors:
                        stem = re.sub(r"^base_model\.model\.", "", prefix)
                        logical = "lm_head" if stem == "lm_head" else stem
                        pairs.append((logical, f"{stem}.weight", key, cand_b))
                        break

        for logical, base_key, a_key, b_key in pairs:
            mod = resolve_target_linear_module(model, logical, base_key)
            if mod is None:
                continue
            lora_a = tensors[a_key].detach().to(dtype=torch.float32)
            lora_b = tensors[b_key].detach().to(dtype=torch.float32)

            def _make_hook(a: torch.Tensor, b: torch.Tensor, s: float):
                def _hook(_module: torch.nn.Module, inputs: Tuple[torch.Tensor, ...], output: torch.Tensor) -> torch.Tensor:
                    if not self.enabled or not inputs:
                        return output
                    x = inputs[0].to(dtype=torch.float32)
                    a_dev = a.to(device=x.device)
                    b_dev = b.to(device=x.device)
                    delta = torch.matmul(torch.matmul(x, a_dev.t()), b_dev.t()) * s
                    return output + delta.to(dtype=output.dtype)

                return _hook

            self._handles.append(mod.register_forward_hook(_make_hook(lora_a, lora_b, scale)))


@lru_cache(maxsize=2)
def load_model_and_adapter(
    repo_id: str, size_label: str = "0.8B"
) -> Tuple[Any, Any, CandleLoRAArm, Dict[str, Any], threading.Lock, bool]:
    manifest = fetch_hub_json(repo_id, "adapter_manifest.json") or {}
    training_manifest = fetch_hub_json(repo_id, "training_manifest.json")
    adapter_meta_v2 = fetch_hub_json(repo_id, "adapter_meta_v2.json")
    peft_config = fetch_hub_json(repo_id, "peft/adapter_config.json") or fetch_hub_json(repo_id, "adapter_config.json")
    use_rslora = resolve_use_rslora(manifest, training_manifest, adapter_meta_v2, peft_config)

    meta = resolve_ladder_meta(size_label)
    default_base_repo = meta["base"].split("@", 1)[0]
    adapter_card = fetch_hub_json(repo_id, "adapter_card.json") or {}
    sync_manifest = fetch_hub_json(repo_id, "hf_sync_manifest.json") or {}
    base_pin = str(
        adapter_card.get("base_hf_id")
        or adapter_card.get("base_model")
        or sync_manifest.get("base_pin")
        or manifest.get("base_model")
        or meta["base"]
    ).strip()
    if "@" in base_pin:
        base_repo, base_rev = base_pin.split("@", 1)
    elif "/" in base_pin:
        base_repo, base_rev = base_pin, None
    elif _SHA40_RE.match(base_pin):
        base_repo, base_rev = default_base_repo, base_pin
    else:
        base_repo, base_rev = default_base_repo, None

    tokenizer = AutoTokenizer.from_pretrained(base_repo, revision=base_rev)
    dtype = torch.bfloat16 if torch.cuda.is_available() else torch.float32
    device_map = "auto" if torch.cuda.is_available() else None
    model = AutoModelForCausalLM.from_pretrained(
        base_repo,
        revision=base_rev,
        torch_dtype=dtype,
        device_map=device_map,
    )
    model.eval()

    st_path = None
    for candidate in ("candle_qlora_adapter.safetensors", "peft/adapter_model.safetensors", "adapter_model.safetensors"):
        try:
            st_path = hf_hub_download(repo_id=repo_id, filename=candidate)
            break
        except Exception:
            continue
    if st_path is None:
        raise FileNotFoundError(f"No Candle or PEFT adapter weights found in {repo_id}")
    tensors = load_file(st_path, device="cpu")
    arm = CandleLoRAArm(model, manifest, tensors, use_rslora=use_rslora, peft_config=peft_config)
    uses_no_think_switch = infer_family(base_repo + " " + repo_id, size_label) == "qwen3"
    lock = threading.Lock()
    return tokenizer, model, arm, {**manifest, "use_rslora": use_rslora}, lock, uses_no_think_switch


def format_qwen_nothink_prompt(description: str, uses_no_think_switch: bool = False) -> str:
    text = re.sub(r"\s*/no_think\b", "", description).strip()
    if not text.startswith(PROMPT_PREFIX):
        text = f"{PROMPT_PREFIX}{text}"
    if uses_no_think_switch:
        text = f"{text} /no_think"
    return (
        f"<|im_start|>system\n{VOX_SYSTEM_PROMPT}<|im_end|>\n"
        f"<|im_start|>user\n{text}<|im_end|>\n"
        f"<|im_start|>assistant\n<think>\n\n</think>\n\n"
    )


def decode_once(tokenizer: Any, model: Any, raw_prompt: str, max_new_tokens: int) -> str:
    inputs = tokenizer(raw_prompt, return_tensors="pt")
    device = next(model.parameters()).device
    inputs = {k: v.to(device) for k, v in inputs.items()}
    prompt_len = inputs["input_ids"].shape[1]
    with torch.no_grad():
        out = model.generate(
            **inputs,
            max_new_tokens=int(max_new_tokens),
            do_sample=False,
            pad_token_id=tokenizer.eos_token_id,
        )
    gen_ids = out[0][prompt_len:]
    return tokenizer.decode(gen_ids, skip_special_tokens=True).strip()


def run_side_by_side(size_label: str, description: str, max_new_tokens: int) -> Tuple[str, str, str]:
    meta_row = resolve_ladder_meta(size_label)
    repo_id = meta_row["repo_id"]
    try:
        tokenizer, model, arm, manifest, lock, uses_no_think_switch = load_model_and_adapter(repo_id, size_label)
    except Exception as exc:
        msg = f"Adapter weights not yet published in {repo_id}: {exc}"
        return msg, msg, msg

    raw_prompt = format_qwen_nothink_prompt(description, uses_no_think_switch=uses_no_think_switch)
    with lock:
        arm.enabled = False
        base_out = decode_once(tokenizer, model, raw_prompt, max_new_tokens)
        arm.enabled = True
        adapter_out = decode_once(tokenizer, model, raw_prompt, max_new_tokens)
    meta = (
        f"Loaded `{repo_id}` (`rank={manifest.get('rank')}`, `alpha={manifest.get('alpha')}`, "
        f"`use_rslora={manifest.get('use_rslora', False)}`, `{len(arm._handles)}` LoRA projections attached)"
    )
    return meta, base_out, adapter_out


def load_heldout_items(size_label: str) -> Tuple[gr.Dropdown, str, str, str]:
    repo_id = resolve_ladder_meta(size_label)["repo_id"]
    base_rep = fetch_hub_json(repo_id, "evidence/heldout_base_nothink.json")
    adap_rep = fetch_hub_json(repo_id, "evidence/heldout_adapter_nothink.json")
    if not base_rep or not adap_rep:
        return gr.Dropdown(choices=[], value=None), f"No recorded held-out evidence found in `{repo_id}`.", "", ""

    b_map = {r["id"]: r for r in base_rep.get("results", []) if "id" in r}
    choices = []
    first_val = None
    for ar in adap_rep.get("results", []):
        iid = ar.get("id")
        if not iid:
            continue
        br = b_map.get(iid, {})
        a_pass = bool((ar.get("samples") or [{}])[0].get("pass"))
        b_pass = bool((br.get("samples") or [{}])[0].get("pass"))
        tag = "FIXED" if (not b_pass and a_pass) else ("PASS" if a_pass else "FAIL")
        label = f"[{tag}] {iid} — {ar.get('description', '')[:80]}"
        choices.append((label, iid))
        if first_val is None and tag == "FIXED":
            first_val = iid
    if first_val is None and choices:
        first_val = choices[0][1]

    summary, b_code, a_code = inspect_heldout_item(size_label, first_val) if first_val else ("", "", "")
    return gr.Dropdown(choices=choices, value=first_val), summary, b_code, a_code


def inspect_heldout_item(size_label: str, item_id: Optional[str]) -> Tuple[str, str, str]:
    if not item_id:
        return "", "", ""
    repo_id = resolve_ladder_meta(size_label)["repo_id"]
    base_rep = fetch_hub_json(repo_id, "evidence/heldout_base_nothink.json") or {}
    adap_rep = fetch_hub_json(repo_id, "evidence/heldout_adapter_nothink.json") or {}
    br = next((r for r in base_rep.get("results", []) if r.get("id") == item_id), {})
    ar = next((r for r in adap_rep.get("results", []) if r.get("id") == item_id), {})
    b_sample = (br.get("samples") or [{}])[0]
    a_sample = (ar.get("samples") or [{}])[0]
    desc = ar.get("description") or br.get("description") or ""
    summary = (
        f"**Item `{item_id}`** (`{ar.get('category', 'general')}`): `{PROMPT_PREFIX}{desc}`  \n"
        f"**Base `{size_label}`**: `{'PASS' if b_sample.get('pass') else 'FAIL'}` | "
        f"**MENS `{size_label}` Adapter**: `{'PASS' if a_sample.get('pass') else 'FAIL'}`"
    )
    return summary, b_sample.get("completion_preview", ""), a_sample.get("completion_preview", "")


def build_ladder_markdown() -> str:
    rows = load_live_ladder_index()
    if not rows:
        return f"Could not fetch `{INDEX_REPO}/ladder_index.json`."
    lines = [
        "| Size | Family | Gate Status | Hub Sync Status | Version | Repository |",
        "| :--- | :--- | :--- | :--- | :--- | :--- |",
    ]
    for r in rows:
        size = r.get("size", "")
        family = r.get("family") or infer_family(str(r.get("base_pin") or r.get("repo_id") or ""), size)
        gate = r.get("gate_status") or "not evaluated"
        sync = r.get("sync_status", "")
        ver = r.get("latest_version") or "—"
        repo = r.get("repo_id", "")
        lines.append(f"| **{size}** | `{family}` | `{gate}` | `{sync}` | `{ver}` | [{repo}](https://huggingface.co/{repo}) |")
    return "\n".join(lines)


with gr.Blocks(title="Vox MENS Coding Playground") as demo:
    gr.Markdown(
        f"# ⚡ Vox MENS — AI Coding Playground for Vox\n"
        f"Compare compiler-verified Vox coding models side by side against base Qwen models using live checkpoints from [`{INDEX_REPO}`](https://huggingface.co/{INDEX_REPO}) · [Vox & Python Guide](https://voxlang.org/reference/mens-models/#vox-and-python-bindings)."
    )
    ladder_md = gr.Markdown(value=build_ladder_markdown)
    refresh_btn = gr.Button("Refresh Live Hub Ladder State", size="sm")
    refresh_btn.click(fn=build_ladder_markdown, outputs=ladder_md)

    with gr.Tabs():
        with gr.Tab("Live Model Inference (Base vs MENS Adapter)"):
            with gr.Row():
                infer_size = gr.Dropdown(
                    choices=ACTIVE_SIZES,
                    value="0.8B",
                    label="Ladder Size",
                )
                max_toks = gr.Slider(minimum=32, maximum=512, step=32, value=256, label="Max New Tokens")
            prompt_box = gr.Textbox(
                lines=3,
                value="define a record type `Point` with `x: int` and `y: int`, and a pure function `manhattan(p: Point) to int`",
                label="Task Description (prefixed with 'Write a Vox program that: ')",
            )
            run_btn = gr.Button("Generate Side-by-Side (Greedy T=0)", variant="primary")
            status_md = gr.Markdown()
            with gr.Row():
                base_code = gr.Code(label="Base Qwen Output", language="typescript")
                adap_code = gr.Code(label="Vox MENS Coding Assistant Output", language="typescript")
            run_btn.click(
                fn=run_side_by_side,
                inputs=[infer_size, prompt_box, max_toks],
                outputs=[status_md, base_code, adap_code],
            )

        with gr.Tab("Live Hub Held-Out Evidence Explorer"):
            ev_size = gr.Dropdown(
                choices=ACTIVE_SIZES,
                value="0.8B",
                label="Ladder Size",
            )
            ev_item = gr.Dropdown(choices=[], label="Held-Out Benchmark Item (52 items)")
            ev_summary = gr.Markdown()
            with gr.Row():
                ev_base = gr.Code(label="Recorded Base Output", language="typescript")
                ev_adap = gr.Code(label="Recorded MENS Adapter Output", language="typescript")

            ev_size.change(
                fn=load_heldout_items,
                inputs=[ev_size],
                outputs=[ev_item, ev_summary, ev_base, ev_adap],
            )
            ev_item.change(
                fn=inspect_heldout_item,
                inputs=[ev_size, ev_item],
                outputs=[ev_summary, ev_base, ev_adap],
            )
            demo.load(
                fn=load_heldout_items,
                inputs=[ev_size],
                outputs=[ev_item, ev_summary, ev_base, ev_adap],
            )

if __name__ == "__main__":
    demo.launch()
