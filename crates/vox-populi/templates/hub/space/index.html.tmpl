<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Vox MENS — Qwen3 WebGPU &amp; Hub Playground</title>
  <style>
    :root {
      --bg: #0b0d13;
      --panel: #121621;
      --panel-alt: #171c2b;
      --border: #262e45;
      --gold: #e2b857;
      --gold-dim: rgba(226, 184, 87, 0.16);
      --indigo: #6366f1;
      --emerald: #10b981;
      --crimson: #ef4444;
      --amber: #f59e0b;
      --text: #e5e7eb;
      --muted: #9ca3af;
      --mono: "JetBrains Mono", "SFMono-Regular", Consolas, monospace;
      --sans: "Inter", -apple-system, BlinkMacSystemFont, sans-serif;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      padding: 0;
      background: var(--bg);
      color: var(--text);
      font-family: var(--sans);
      line-height: 1.5;
    }
    header {
      padding: 20px 28px;
      border-bottom: 1px solid var(--border);
      background: linear-gradient(180deg, #131826 0%, #0b0d13 100%);
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
    }
    .brand h1 {
      margin: 0;
      font-size: 1.35rem;
      letter-spacing: 0.02em;
      color: #fff;
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .brand p {
      margin: 4px 0 0;
      font-size: 0.86rem;
      color: var(--muted);
    }
    .badge {
      display: inline-flex;
      align-items: center;
      padding: 3px 9px;
      border-radius: 999px;
      font-size: 0.74rem;
      font-family: var(--mono);
      font-weight: 600;
      border: 1px solid var(--border);
      background: var(--panel-alt);
    }
    .badge-pass { color: #34d399; border-color: rgba(16, 185, 129, 0.4); background: rgba(16, 185, 129, 0.1); }
    .badge-fail { color: #f87171; border-color: rgba(239, 68, 68, 0.4); background: rgba(239, 68, 68, 0.1); }
    .badge-warn { color: #fbbf24; border-color: rgba(245, 158, 11, 0.4); background: rgba(245, 158, 11, 0.1); }
    .container {
      max-width: 1440px;
      margin: 0 auto;
      padding: 22px 28px 48px;
    }
    .ladder-strip {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(195px, 1fr));
      gap: 12px;
      margin-bottom: 22px;
    }
    .rung-card {
      background: var(--panel);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 12px 14px;
      cursor: pointer;
      transition: border-color 0.15s, transform 0.1s;
    }
    .rung-card:hover { border-color: var(--gold); }
    .rung-card.active {
      border-color: var(--gold);
      box-shadow: 0 0 0 1px var(--gold);
      background: linear-gradient(180deg, rgba(226, 184, 87, 0.09) 0%, var(--panel) 100%);
    }
    .rung-top {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 6px;
    }
    .rung-size {
      font-family: var(--mono);
      font-size: 1.05rem;
      font-weight: 700;
      color: #fff;
    }
    .rung-meta {
      font-size: 0.78rem;
      color: var(--muted);
      font-family: var(--mono);
    }
    .tabs {
      display: flex;
      gap: 8px;
      margin-bottom: 18px;
      border-bottom: 1px solid var(--border);
      padding-bottom: 10px;
    }
    .tab-btn {
      background: var(--panel);
      color: var(--muted);
      border: 1px solid var(--border);
      padding: 8px 16px;
      border-radius: 8px;
      cursor: pointer;
      font-weight: 600;
      font-size: 0.88rem;
    }
    .tab-btn.active {
      color: #0b0d13;
      background: var(--gold);
      border-color: var(--gold);
    }
    .panel {
      background: var(--panel);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 18px 20px;
      margin-bottom: 18px;
    }
    .panel h2 {
      margin: 0 0 12px;
      font-size: 1.02rem;
      color: var(--gold);
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .grid-2 {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
    }
    @media (max-width: 960px) {
      .grid-2 { grid-template-columns: 1fr; }
    }
    label {
      display: block;
      font-size: 0.8rem;
      color: var(--muted);
      margin-bottom: 6px;
      font-family: var(--mono);
    }
    select, textarea, input[type="number"] {
      width: 100%;
      background: #0d1018;
      color: var(--text);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 10px 12px;
      font-family: var(--mono);
      font-size: 0.84rem;
    }
    textarea { min-height: 96px; resize: vertical; }
    button.primary {
      background: var(--gold);
      color: #0b0d13;
      border: none;
      border-radius: 8px;
      padding: 10px 18px;
      font-weight: 700;
      font-size: 0.88rem;
      cursor: pointer;
    }
    button.primary:disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }
    button.secondary {
      background: var(--panel-alt);
      color: var(--text);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 8px 14px;
      font-size: 0.82rem;
      cursor: pointer;
    }
    pre.code-box {
      background: #080a10;
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 14px;
      margin: 0;
      overflow-x: auto;
      font-family: var(--mono);
      font-size: 0.82rem;
      min-height: 220px;
      white-space: pre-wrap;
      word-break: break-word;
    }
    .status-bar {
      margin-top: 12px;
      padding: 10px 14px;
      border-radius: 8px;
      background: var(--panel-alt);
      border: 1px solid var(--border);
      font-family: var(--mono);
      font-size: 0.8rem;
      color: var(--muted);
    }
    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.84rem;
      font-family: var(--mono);
    }
    th, td {
      text-align: left;
      padding: 8px 10px;
      border-bottom: 1px solid var(--border);
    }
    th { color: var(--gold); font-weight: 600; }
    a { color: var(--gold); text-decoration: none; }
    a:hover { text-decoration: underline; }
    .hidden { display: none !important; }
  </style>
</head>
<body>
  <header>
    <div class="brand">
      <h1>
        <span>⚡ Vox MENS — Qwen3 Adapter Ladder Playground</span>
        <span class="badge" id="webgpu-badge">Checking WebGPU…</span>
      </h1>
      <p>
        Live Hugging Face Hub Evidence Explorer &amp; In-Browser WebGPU LoRA Runner for
        <a href="https://huggingface.co/{{NAMESPACE}}/vox-mens-index" target="_blank" rel="noopener">{{NAMESPACE}}/vox-mens-index</a>
        · <a href="https://voxlang.org/reference/mens-models/" target="_blank" rel="noopener">voxlang.org/reference/mens-models</a>
      </p>
    </div>
    <div style="display:flex; gap:10px; align-items:center;">
      <label style="margin:0;">Active Rung:</label>
      <select id="size-select" style="width:auto; min-width:140px;">
        <option value="0.6B" selected>Qwen3-0.6B</option>
        <option value="1.7B">Qwen3-1.7B</option>
        <option value="4B">Qwen3-4B</option>
        <option value="8B">Qwen3-8B</option>
        <option value="14B">Qwen3-14B</option>
        <option value="32B">Qwen3-32B</option>
      </select>
    </div>
  </header>

  <div class="container">
    <div class="ladder-strip" id="ladder-strip"></div>

    <div class="tabs">
      <button class="tab-btn active" id="tab-btn-evidence" type="button">1. Live Hub Held-Out &amp; Gate Evidence</button>
      <button class="tab-btn" id="tab-btn-webgpu" type="button">2. Live Inference &amp; Provider Router (WebGPU / HF Router / Local Serve)</button>
    </div>

    <!-- TAB 1: LIVE HUB EVIDENCE -->
    <div id="tab-evidence">
      <div class="panel">
        <h2>
          <span id="rung-summary-title">Rung Evidence Summary</span>
          <span id="rung-repo-link" style="font-size:0.82rem; font-family:var(--mono);"></span>
        </h2>
        <div id="rung-summary-body" style="font-family:var(--mono); font-size:0.83rem; color:var(--muted);">
          Fetching live records from Hugging Face Hub…
        </div>
      </div>

      <div class="panel">
        <h2>
          <span>Held-Out Vox Benchmark (52 Prompts — Base vs. LoRA Adapter)</span>
          <div style="display:flex; gap:8px; align-items:center;">
            <select id="filter-verdict" style="width:auto;">
              <option value="ALL">All Verdicts</option>
              <option value="FIXED">Fixed (Adapter Wins)</option>
              <option value="BOTH_PASS">Both Pass</option>
              <option value="REGRESSION">Regression</option>
              <option value="STILL_FAILS">Still Fails</option>
            </select>
            <button class="secondary" id="copy-to-webgpu-btn" type="button">Test Prompt in WebGPU Tab →</button>
          </div>
        </h2>
        <div style="margin-bottom:12px;">
          <label for="sample-select">Select Held-Out Sample (`qwen3_non_thinking_codegen_v1`):</label>
          <select id="sample-select"></select>
        </div>
        <div id="sample-prompt-box" class="status-bar" style="margin-bottom:14px; color:var(--text);"></div>
        <div class="grid-2">
          <div>
            <label id="base-sample-label">Pinned Base Qwen3 Output</label>
            <pre class="code-box" id="base-sample-code"></pre>
          </div>
          <div>
            <label id="adapter-sample-label">Vox MENS LoRA Adapter Output (`nf4_base_plus_lora_arm v2`)</label>
            <pre class="code-box" id="adapter-sample-code"></pre>
          </div>
        </div>
      </div>

      <div class="panel">
        <h2><span>Reasoning Collateral Check (Thinking Mode — McNemar Paired Test)</span></h2>
        <div id="collateral-table-wrap"></div>
      </div>
    </div>

    <!-- TAB 2: IN-BROWSER WEBGPU & UNIVERSAL INFERENCE PROVIDER ROUTER -->
    <div id="tab-webgpu" class="hidden">
      <div class="panel">
        <h2>
          <span>Universal Side-by-Side Decoder (WebGPU SafeTensors LoRA · HF Inference Provider Router · Local `vox mens serve`)</span>
          <span class="badge" id="lora-manifest-badge">Adapter: Not Loaded</span>
        </h2>
        <p style="margin:0 0 14px; font-size:0.85rem; color:var(--muted);">
          Supports every rung on the ladder (<strong>0.6B, 1.7B, 4B, 8B, 14B, 32B</strong>):
          <strong>In-Browser WebGPU</strong> downloads <code>candle_qlora_adapter.safetensors</code> and <code>adapter_manifest.json</code> live from
          <code>{{NAMESPACE}}/vox-mens-qwen3-&lt;size&gt;</code> and merges every rank-<code>r</code> LoRA pair
          (<code>ΔW = (B @ A) * (alpha / rank)</code>) into the Qwen3 4-bit ONNX weights in-memory (<code>0.6B</code>–<code>8B</code>);
          <strong>HF Inference Provider Router</strong> queries <code>https://router.huggingface.co/v1/chat/completions</code> for all 6 sizes (<code>0.6B</code>–<code>32B</code>) while verifying live Hub SafeTensors and recorded adapter checkpoints;
          <strong>Local `vox mens serve`</strong> connects to your local Metal/CUDA OpenAI endpoint (<code>http://127.0.0.1:11435/v1/chat/completions</code>) for any size.
        </p>
        <div class="grid-2" style="margin-bottom:12px;">
          <div>
            <label for="inference-provider-select">Inference Provider Backend:</label>
            <select id="inference-provider-select">
              <option value="auto" selected>Auto (In-Browser WebGPU 0.6B–4B · HF Router / Local Serve 8B–32B)</option>
              <option value="webgpu">In-Browser WebGPU + Live SafeTensors LoRA Merger (0.6B / 1.7B / 4B / 8B)</option>
              <option value="hf-router">Hugging Face Inference Provider Router (All Sizes 0.6B–32B · router.huggingface.co)</option>
              <option value="local-serve">Local `vox mens serve` OpenAI Endpoint (All Sizes 0.6B–32B · 127.0.0.1:11435)</option>
            </select>
          </div>
          <div>
            <label for="provider-endpoint-input">HF Token (`hf_...` for HF Router) or Local Endpoint URL:</label>
            <input type="password" id="provider-endpoint-input" placeholder="Optional: hf_... token for router.huggingface.co, or http://127.0.0.1:11435/v1/chat/completions" style="width:100%; background:#181617; color:var(--text); border:1px solid var(--border); border-radius:6px; padding:8px 10px; font-family:var(--mono); font-size:0.82rem;" />
          </div>
        </div>
        <div class="grid-2" style="margin-bottom:12px;">
          <div>
            <label for="system-prompt-input">System Prompt (`qwen3_non_thinking_codegen_v1`):</label>
            <textarea id="system-prompt-input">You are a Vox compiler engineer. Output only valid Vox source code that satisfies the user request. Do not wrap the response in markdown prose or explanations.</textarea>
          </div>
          <div>
            <label for="user-prompt-input">User Prompt:</label>
            <textarea id="user-prompt-input">Write a Vox program that: write a test named `smoke` that calls `add(1, 2)` and asserts the result equals 3</textarea>
          </div>
        </div>
        <div style="display:flex; flex-wrap:wrap; gap:12px; align-items:center; margin-bottom:14px;">
          <div style="width:160px;">
            <label for="max-tokens-input">Max New Tokens:</label>
            <input type="number" id="max-tokens-input" value="192" min="16" max="512" step="16" />
          </div>
          <div style="padding-top:18px; display:flex; gap:10px;">
            <button class="primary" id="run-webgpu-btn" type="button">⚡ Decode Base vs. LoRA Adapter</button>
            <button class="secondary" id="inspect-safetensors-btn" type="button">Inspect Live `candle_qlora_adapter.safetensors` Header</button>
          </div>
        </div>
        <div class="status-bar" id="webgpu-status">Ready. Select any ladder size (0.6B–32B) and click Decode to run inference.</div>
        <div class="grid-2" style="margin-top:14px;">
          <div>
            <label id="webgpu-base-label">Base Qwen3 Live Output</label>
            <pre class="code-box" id="webgpu-base-output"></pre>
          </div>
          <div>
            <label id="webgpu-adapter-label">Vox MENS LoRA Adapter Output (`ΔW = (B @ A) * α/r`)</label>
            <pre class="code-box" id="webgpu-adapter-output"></pre>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script type="module">
    const NAMESPACE = "{{NAMESPACE}}";
    const SIZES = ["0.6B", "1.7B", "4B", "8B", "14B", "32B"];
    const ONNX_REPO_BY_SIZE = {
      "0.6B": "onnx-community/Qwen3-0.6B-ONNX",
      "1.7B": "onnx-community/Qwen3-1.7B-ONNX",
      "4B": "onnx-community/Qwen3-4B-ONNX",
      "8B": "onnx-community/Qwen3-8B-ONNX",
    };
    const HF_BASE_MODEL_BY_SIZE = {
      "0.6B": "Qwen/Qwen3-0.6B",
      "1.7B": "Qwen/Qwen3-1.7B",
      "4B": "Qwen/Qwen3-4B",
      "8B": "Qwen/Qwen3-8B",
      "14B": "Qwen/Qwen3-14B",
      "32B": "Qwen/Qwen3-32B",
    };

    const state = {
      activeSize: "0.6B",
      ladderIndex: null,
      rungCache: {},
      filteredSamples: [],
      webgpuBusy: false,
      cachedSessions: {},
    };

    const el = (id) => document.getElementById(id);

    async function checkWebGPU() {
      const badge = el("webgpu-badge");
      if (!("gpu" in navigator)) {
        badge.textContent = "WASM SIMD Fallback (WebGPU Unavailable)";
        badge.className = "badge badge-warn";
        return false;
      }
      try {
        const adapter = await navigator.gpu.requestAdapter();
        if (!adapter) {
          badge.textContent = "WASM SIMD Fallback (No WebGPU Adapter)";
          badge.className = "badge badge-warn";
          return false;
        }
        badge.textContent = "WebGPU Ready";
        badge.className = "badge badge-pass";
        return true;
      } catch (err) {
        badge.textContent = "WASM SIMD Fallback";
        badge.className = "badge badge-warn";
        return false;
      }
    }

    function hfUrl(repoId, path) {
      return `https://huggingface.co/${repoId}/resolve/main/${path}`;
    }

    function repoIdForSize(size) {
      return `${NAMESPACE}/vox-mens-qwen3-${size.toLowerCase()}`;
    }

    async function fetchJsonOptional(repoId, path) {
      try {
        const res = await fetch(hfUrl(repoId, path));
        if (!res.ok) return null;
        return await res.json();
      } catch {
        return null;
      }
    }

    async function fetchJsonlOptional(repoId, path) {
      try {
        const res = await fetch(hfUrl(repoId, path));
        if (!res.ok) return [];
        const text = await res.text();
        return text
          .split("\n")
          .map((l) => l.trim())
          .filter(Boolean)
          .map((l) => {
            try { return JSON.parse(l); } catch { return null; }
          })
          .filter(Boolean);
      } catch {
        return [];
      }
    }

    function parsePromptTurn(promptJson) {
      if (!promptJson) return "";
      try {
        const parsed = JSON.parse(promptJson);
        if (Array.isArray(parsed)) {
          const userMsg = parsed.find((m) => m && m.role === "user");
          if (userMsg && typeof userMsg.content === "string") return userMsg.content;
        }
      } catch {}
      return String(promptJson);
    }

    function escapeHtml(str) {
      return String(str ?? "")
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#39;");
    }

    function extractAnswerRegion(text) {
      if (typeof text !== "string") return "";
      const closeIdx = text.lastIndexOf("</think>");
      if (closeIdx !== -1) return text.slice(closeIdx + "</think>".length).trimStart();
      if (text.trimStart().startsWith("<think>")) return "";
      return text;
    }

    function extractShownCode(text) {
      const body = extractAnswerRegion(text);
      const start = body.indexOf("```");
      if (start === -1) return body.trim();
      const after = body.slice(start + 3);
      const nl = after.indexOf("\n");
      const code = nl === -1 ? after : after.slice(nl + 1);
      const end = code.indexOf("```");
      return (end === -1 ? code : code.slice(0, end)).trim();
    }

    function matchCkptText(preview, texts) {
      if (!preview || typeof preview !== "string") return null;
      if (Array.isArray(texts) && texts.length > 0) {
        const pHead = Array.from(preview).slice(0, 240).join("");
        const hits = texts.filter(
          (t) =>
            extractAnswerRegion(t).slice(0, 240) === preview.slice(0, 240) ||
            Array.from(extractAnswerRegion(t)).slice(0, 240).join("") === pHead
        );
        if (hits.length === 1) return extractShownCode(hits[0]);
      }
      return extractShownCode(preview);
    }

    function parseCkptLines(rows) {
      if (!Array.isArray(rows) || rows.length === 0) return { texts: [], serving: null };
      const header = rows[0] || {};
      const serving = header?.inputs?.model?.adapter_serving || null;
      const texts = [];
      for (let i = 1; i < rows.length; i++) {
        const r = rows[i];
        if (!r || typeof r.response !== "string") continue;
        try {
          const parsed = JSON.parse(r.response);
          if (typeof parsed.generated_text === "string") texts.push(parsed.generated_text);
        } catch {}
      }
      return { texts, serving };
    }

    async function loadLadderIndex() {
      const indexData = await fetchJsonOptional(`${NAMESPACE}/vox-mens-index`, "ladder_index.json");
      state.ladderIndex = indexData;
      renderLadderStrip();
    }

    function renderLadderStrip() {
      const strip = el("ladder-strip");
      strip.innerHTML = "";
      const rowsBySize = {};
      if (state.ladderIndex && Array.isArray(state.ladderIndex.sizes)) {
        for (const r of state.ladderIndex.sizes) {
          rowsBySize[r.size] = r;
        }
      }
      for (const size of SIZES) {
        const r = rowsBySize[size] || {};
        const card = document.createElement("div");
        card.className = `rung-card${state.activeSize === size ? " active" : ""}`;
        const status = r.gate_status || r.remote_gate_status || r.local_gate_status || "untrained";
        const statusShort = status.startsWith("ungated") ? "ungated" : status;
        let badgeClass = "badge-warn";
        if (status === "passed") badgeClass = "badge-pass";
        else if (status.startsWith("failed") || status.startsWith("ungated")) badgeClass = "badge-fail";
        const rev = r.latest_version || (r.remote_revision ? `v${r.remote_revision}` : (r.sync_status || "n/a"));
        card.innerHTML = `
          <div class="rung-top">
            <span class="rung-size">${escapeHtml(size)}</span>
            <span class="badge ${escapeHtml(badgeClass)}" title="${escapeHtml(status)}">${escapeHtml(statusShort)}</span>
          </div>
          <div class="rung-meta">Hub: ${escapeHtml(rev)} · ${escapeHtml(r.sync_status || "unknown")}</div>
        `;
        card.addEventListener("click", () => selectSize(size));
        strip.appendChild(card);
      }
    }

    async function loadRungEvidence(size) {
      if (state.rungCache[size]) return state.rungCache[size];
      const repoId = repoIdForSize(size);
      const [
        syncManifest,
        adapterManifest,
        gateReceipt,
        collateral,
        baseReport,
        adapterReport,
        baseCkpt,
        adapterCkpt,
      ] = await Promise.all([
        fetchJsonOptional(repoId, "hf_sync_manifest.json"),
        fetchJsonOptional(repoId, "adapter_manifest.json"),
        fetchJsonOptional(repoId, "gate_receipt.json"),
        fetchJsonOptional(repoId, "collateral_damage_report.json"),
        fetchJsonOptional(repoId, "evidence/heldout_base_nothink.json"),
        fetchJsonOptional(repoId, "evidence/heldout_adapter_nothink.json"),
        fetchJsonlOptional(repoId, "evidence/heldout_base_nothink.ckpt.jsonl"),
        fetchJsonlOptional(repoId, "evidence/heldout_adapter_nothink.ckpt.jsonl"),
      ]);

      const baseCkptParsed = parseCkptLines(baseCkpt);
      const adapterCkptParsed = parseCkptLines(adapterCkpt);
      const adapterServing =
        adapterCkptParsed.serving ||
        (adapterReport && adapterReport.adapter_serving) ||
        "none";

      const baseResults =
        baseReport && Array.isArray(baseReport.results)
          ? baseReport.results
          : baseReport && Array.isArray(baseReport.samples)
            ? baseReport.samples
            : [];
      const adapterResults =
        adapterReport && Array.isArray(adapterReport.results)
          ? adapterReport.results
          : adapterReport && Array.isArray(adapterReport.samples)
            ? adapterReport.samples
            : [];
      const adapterById = {};
      for (const r of adapterResults) {
        const id = r.id || r.sample_id;
        if (id) adapterById[id] = r;
      }

      const joined = [];
      for (const b of baseResults) {
        const itemId = b.id || b.sample_id;
        if (!itemId) continue;
        const a = adapterById[itemId] || null;
        const bSample = Array.isArray(b.samples) && b.samples[0] ? b.samples[0] : b;
        const aSample = a ? (Array.isArray(a.samples) && a.samples[0] ? a.samples[0] : a) : null;

        const bPass = Boolean(bSample?.pass ?? bSample?.constructed);
        const aPass = aSample ? Boolean(aSample?.pass ?? aSample?.constructed) : false;
        let verdict = "STILL_FAILS";
        if (!bPass && aPass) verdict = "FIXED";
        else if (bPass && aPass) verdict = "BOTH_PASS";
        else if (bPass && !aPass) verdict = "REGRESSION";

        const bPreview = typeof bSample?.completion_preview === "string" ? bSample.completion_preview : null;
        const aPreview = typeof aSample?.completion_preview === "string" ? aSample.completion_preview : null;
        const baseOutput = matchCkptText(bPreview, baseCkptParsed.texts);
        const adapterOutput = matchCkptText(aPreview, adapterCkptParsed.texts);
        const promptText = "Write a Vox program that: " + (b.description || itemId);

        joined.push({
          sample_id: itemId,
          category: b.category || "vox",
          verdict,
          base: bSample,
          adapter: aSample,
          baseOutput,
          adapterOutput,
          promptText,
        });
      }

      const bundle = {
        size,
        repoId,
        syncManifest,
        adapterManifest,
        gateReceipt,
        collateral,
        baseReport,
        adapterReport,
        adapterServing,
        joined,
      };
      state.rungCache[size] = bundle;
      return bundle;
    }

    function formatDiag(sample) {
      if (!sample) return "not evaluated";
      const passed = Boolean(sample.pass ?? sample.constructed);
      if (passed) return "PASS (parse + HIR + typecheck + AST checks)";
      const c = sample.checks || sample;
      if (c.non_empty === false) return "FAIL: empty output";
      if (c.parse_ok === false) return `FAIL: parse (${c.parse_error || sample.error_Preview || "syntax error"})`;
      if (c.hir_ok === false) return "FAIL: HIR lowering";
      if (c.typecheck_ok === false) {
        const errDetail =
          typeof c.diag_errors === "number"
            ? `${c.diag_errors} type error(s)`
            : sample.first_typecheck_error || "type error";
        return `FAIL: typecheck (${errDetail})`;
      }
      if (c.anti_stub_pass === false) return "FAIL: anti-stub check";
      if (c.pass_compile === false) return "FAIL: compile check";
      if (c.pass_ast === false) return "FAIL: AST check";
      if (Array.isArray(sample.ast_check_failures) && sample.ast_check_failures.length > 0) {
        return `FAIL: AST (${sample.ast_check_failures.join(", ")})`;
      }
      return "FAIL: empty/unconstructed";
    }

    async function selectSize(size) {
      state.activeSize = size;
      el("size-select").value = size;
      renderLadderStrip();
      el("rung-summary-title").textContent = `Qwen3-${size} Live Hub Evidence`;
      const repoId = repoIdForSize(size);
      el("rung-repo-link").innerHTML = `<a href="https://huggingface.co/${escapeHtml(repoId)}" target="_blank" rel="noopener">${escapeHtml(repoId)} ↗</a>`;
      el("rung-summary-body").textContent = `Loading live artifacts from ${repoId}…`;

      const bundle = await loadRungEvidence(size);
      const sm = bundle.syncManifest;
      const gr = bundle.gateReceipt;
      const br = bundle.baseReport;
      const ar = bundle.adapterReport;

      const brPassed = br ? (br.passed_at_1 ?? br.constructed ?? 0) : 0;
      const brRate = br ? (br.pass_rate_at_1 ?? br.pass_rate ?? 0) : 0;
      const baseScore = br ? `${brPassed}/${br.total} (${(brRate * 100).toFixed(1)}%)` : "n/a";
      const adapterServing = bundle.adapterServing || (ar && ar.adapter_serving) || "none";
      const adapterCurrent = adapterServing === "nf4_base_plus_lora_arm v2";
      const arPassed = ar ? (ar.passed_at_1 ?? ar.constructed ?? 0) : 0;
      const arRate = ar ? (ar.pass_rate_at_1 ?? ar.pass_rate ?? 0) : 0;
      const adapterScore = (ar && adapterCurrent)
        ? `${arPassed}/${ar.total} (${(arRate * 100).toFixed(1)}%)`
        : (ar ? `stale serving (${adapterServing})` : "n/a");

      const gatePassed = gr ? Boolean(gr.overall_passed ?? gr.passed) : false;
      const gateBlocking = gr
        ? Array.isArray(gr.gates)
          ? gr.gates.filter((g) => g && !g.passed && g.block).map((g) => `${g.name}: ${g.message}`)
          : Array.isArray(gr.blocking_reasons)
            ? gr.blocking_reasons
            : []
        : [];
      const gateText = gr
        ? gatePassed
          ? "PASSED"
          : `FAILED (${gateBlocking.join("; ") || "blocked"})`
        : "not gated";

      const indexRow =
        state.ladderIndex && Array.isArray(state.ladderIndex.sizes)
          ? state.ladderIndex.sizes.find((x) => x && x.size === size)
          : null;
      const latestVersion =
        (indexRow && indexRow.latest_version) ||
        (sm && sm.hub_revision ? `v${sm.hub_revision}` : "published");
      const basePinCommit = sm ? String(sm.base_pin || sm.base_model || "").slice(-12) : "";
      const corpusShort = sm && sm.corpus_hash ? `, corpus ${String(sm.corpus_hash).slice(0, 12)}` : "";
      const revText = sm
        ? `${latestVersion} (base ${basePinCommit || "n/a"}${corpusShort})`
        : "no hf_sync_manifest.json";

      el("rung-summary-body").innerHTML = `
        <div><strong>Hub Manifest:</strong> ${escapeHtml(revText)} · <strong>Gate Receipt:</strong> ${escapeHtml(gateText)}</div>
        <div style="margin-top:4px;">
          <strong>Held-Out Base pass@1:</strong> ${escapeHtml(baseScore)} ·
          <strong>Held-Out Adapter pass@1:</strong> ${escapeHtml(adapterScore)} ·
          <strong>Serving Path:</strong> <code>${escapeHtml(adapterServing)}</code>
        </div>
      `;

      renderSampleList(bundle);
      renderCollateralTable(bundle);
    }

    function renderSampleList(bundle) {
      const filter = el("filter-verdict").value;
      state.filteredSamples = bundle.joined.filter((item) => filter === "ALL" || item.verdict === filter);
      const sel = el("sample-select");
      sel.innerHTML = "";
      if (state.filteredSamples.length === 0) {
        const opt = document.createElement("option");
        opt.textContent = "No held-out samples match filter on Hub";
        sel.appendChild(opt);
        el("sample-prompt-box").textContent = "No recorded held-out sample available for this filter.";
        el("base-sample-code").textContent = "";
        el("adapter-sample-code").textContent = "";
        return;
      }
      state.filteredSamples.forEach((item, idx) => {
        const opt = document.createElement("option");
