<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Vox Mens — Open Code Playground</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet" />
  <style>
    :root {
      --bg: #faf6ee;
      --panel: #ffffff;
      --panel-alt: #f4ede0;
      --border: #d8c394;
      --gold: #b8891e;
      --gold-dim: rgba(197, 155, 39, 0.14);
      --indigo: #1b6b3a;
      --emerald: #1b6b3a;
      --crimson: #b42318;
      --amber: #9a6700;
      --text: #1c140c;
      --muted: #5c4f3d;
      --display: "Cinzel", Georgia, "Times New Roman", serif;
      --mono: "JetBrains Mono", "SFMono-Regular", Consolas, monospace;
      --sans: "Inter", -apple-system, BlinkMacSystemFont, sans-serif;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      padding: 0;
      background: radial-gradient(circle at top right, #fffdf8 0%, #faf6ee 58%, #f3ebd9 100%);
      color: var(--text);
      font-family: var(--sans);
      line-height: 1.5;
    }
    header {
      padding: 18px 28px;
      border-bottom: 2px solid var(--gold);
      background: linear-gradient(180deg, #fffdf9 0%, #f6efe0 100%);
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
    }
    .brand h1 {
      margin: 0;
      font-family: var(--display);
      font-size: 1.38rem;
      letter-spacing: 0.04em;
      color: var(--text);
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .brand p {
      margin: 4px 0 0;
      font-size: 0.86rem;
      color: var(--muted);
    }
    .badge {
      display: inline-flex;
      align-items: center;
      padding: 3px 10px;
      border-radius: 999px;
      font-size: 0.74rem;
      font-family: var(--mono);
      font-weight: 600;
      border: 1px solid var(--border);
      background: var(--panel-alt);
      color: var(--text);
    }
    .badge-pass { color: #ffffff; border-color: #1b6b3a; background: #1b6b3a; }
    .badge-fail { color: #b42318; border-color: rgba(180, 35, 24, 0.35); background: rgba(180, 35, 24, 0.08); }
    .badge-warn { color: #7a4f01; border-color: rgba(197, 155, 39, 0.55); background: rgba(197, 155, 39, 0.14); }
    .container {
      max-width: 1440px;
      margin: 0 auto;
      padding: 20px 28px 48px;
    }
    .ladder-strip {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(195px, 1fr));
      gap: 12px;
      margin-bottom: 20px;
    }
    .rung-card {
      background: var(--panel);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 12px 14px;
      cursor: pointer;
      box-shadow: 0 2px 6px rgba(28, 20, 12, 0.04);
      transition: border-color 0.15s, transform 0.1s;
    }
    .rung-card:hover { border-color: var(--gold); }
    .rung-card.active {
      border-color: var(--gold);
      box-shadow: 0 0 0 1.5px var(--gold);
      background: linear-gradient(180deg, rgba(197, 155, 39, 0.12) 0%, var(--panel) 100%);
    }
    .rung-top {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 6px;
    }
    .rung-size {
      font-family: var(--display);
      font-size: 1.02rem;
      font-weight: 700;
      color: var(--text);
    }
    .rung-meta {
      font-size: 0.78rem;
      color: var(--muted);
      font-family: var(--mono);
    }
    .tabs {
      display: flex;
      gap: 8px;
      margin-bottom: 18px;
      border-bottom: 1px solid var(--border);
      padding-bottom: 10px;
    }
    .tab-btn {
      background: var(--panel);
      color: var(--muted);
      border: 1px solid var(--border);
      padding: 8px 16px;
      border-radius: 999px;
      cursor: pointer;
      font-family: var(--display);
      font-weight: 700;
      font-size: 0.84rem;
      letter-spacing: 0.02em;
    }
    .tab-btn.active {
      color: #fffdf9;
      background: var(--gold);
      border-color: var(--gold);
    }
    .panel {
      background: var(--panel);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 18px 20px;
      margin-bottom: 18px;
      box-shadow: 0 3px 10px rgba(28, 20, 12, 0.05);
    }
    .panel h2 {
      margin: 0 0 12px;
      font-family: var(--display);
      font-size: 1.02rem;
      letter-spacing: 0.03em;
      color: var(--text);
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .grid-2 {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
    }
    @media (max-width: 960px) {
      .grid-2 { grid-template-columns: 1fr; }
    }
    label {
      display: block;
      font-size: 0.8rem;
      color: var(--muted);
      margin-bottom: 6px;
      font-family: var(--mono);
      font-weight: 600;
    }
    select, textarea, input[type="number"] {
      width: 100%;
      background: #fcfaf5;
      color: var(--text);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 10px 12px;
      font-family: var(--mono);
      font-size: 0.84rem;
    }
    textarea { min-height: 96px; resize: vertical; }
    button.primary {
      background: var(--emerald);
      color: #ffffff;
      border: 1px solid #14532d;
      border-radius: 999px;
      padding: 10px 18px;
      font-family: var(--display);
      font-weight: 700;
      letter-spacing: 0.03em;
      font-size: 0.84rem;
      cursor: pointer;
    }
    button.primary:disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }
    button.secondary {
      background: var(--panel-alt);
      color: var(--text);
      border: 1px solid var(--border);
      border-radius: 999px;
      padding: 8px 14px;
      font-size: 0.82rem;
      font-weight: 600;
      cursor: pointer;
    }
    pre.code-box {
      background: #f8f4ea;
      color: var(--text);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 14px;
      margin: 0;
      overflow-x: auto;
      font-family: var(--mono);
      font-size: 0.82rem;
      min-height: 220px;
      white-space: pre-wrap;
      word-break: break-word;
    }
    .status-bar {
      margin-top: 12px;
      padding: 10px 14px;
      border-radius: 8px;
      background: var(--panel-alt);
      border: 1px solid var(--border);
      font-family: var(--mono);
      font-size: 0.8rem;
      color: var(--muted);
    }
    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.84rem;
      font-family: var(--mono);
    }
    th, td {
      text-align: left;
      padding: 8px 10px;
      border-bottom: 1px solid var(--border);
    }
    th { color: #7a580d; font-weight: 700; font-family: var(--display); }
    a { color: #8c640d; font-weight: 600; text-decoration: none; }
    a:hover { text-decoration: underline; }
    .hidden { display: none !important; }
  </style>
</head>
<body>
  <header>
    <div class="brand">
      <h1>
        <span>VOX MENS · CODE PLAYGROUND</span>
        <span class="badge" id="webgpu-badge">Checking WebGPU…</span>
      </h1>
      <p>
        Open models trained to write and fix <code>.vox</code> code (<code>0.8B</code>–<code>27B</code>) — run locally or alongside large cloud planners ·
        <a href="https://huggingface.co/{{NAMESPACE}}/vox-mens-index" target="_blank" rel="noopener">{{NAMESPACE}}/vox-mens-index</a>
        · <a href="https://voxlang.org/reference/mens-models/" target="_blank" rel="noopener">Model Guide &amp; Quickstart</a>
      </p>
    </div>
    <div style="display:flex; gap:10px; align-items:center;">
      <label style="margin:0;">Active Model:</label>
      <select id="size-select" style="width:auto; min-width:170px;">
        <option value="0.8B" selected>Vox Mens 0.8B</option>
        <option value="2B">Vox Mens 2B</option>
        <option value="4B">Vox Mens 4B</option>
        <option value="9B">Vox Mens 9B</option>
        <option value="27B">Vox Mens 27B</option>
      </select>
    </div>
  </header>

  <div class="container">
    <div class="ladder-strip" id="ladder-strip"></div>

    <div class="tabs">
      <button class="tab-btn active" id="tab-btn-evidence" type="button">1. Live Hub Held-Out &amp; Gate Evidence</button>
      <button class="tab-btn" id="tab-btn-webgpu" type="button">2. Live Inference &amp; Provider Router (WebGPU / HF Router / Local Serve)</button>
    </div>

    <!-- TAB 1: LIVE HUB EVIDENCE -->
    <div id="tab-evidence">
      <div class="panel">
        <h2>
          <span id="rung-summary-title">Rung Evidence Summary</span>
          <span id="rung-repo-link" style="font-size:0.82rem; font-family:var(--mono);"></span>
        </h2>
        <div id="rung-summary-body" style="font-family:var(--mono); font-size:0.83rem; color:var(--muted);">
          Fetching live records from Hugging Face Hub…
        </div>
      </div>

      <div class="panel">
        <h2>
          <span>Held-Out Vox Benchmark v1 (52 prompts, compile check only; superseded by the 166-task execution-verified v2, not yet published)</span>
          <div style="display:flex; gap:8px; align-items:center;">
            <select id="filter-verdict" style="width:auto;">
              <option value="ALL">All Verdicts</option>
              <option value="FIXED">Fixed (Adapter Wins)</option>
              <option value="BOTH_PASS">Both Pass</option>
              <option value="REGRESSION">Regression</option>
              <option value="STILL_FAILS">Still Fails</option>
            </select>
            <button class="secondary" id="copy-to-webgpu-btn" type="button">Test Prompt in WebGPU Tab →</button>
          </div>
        </h2>
        <div style="margin-bottom:12px;">
          <label for="sample-select">Select Held-Out Sample (`qwen3_non_thinking_codegen_v1`):</label>
          <select id="sample-select"></select>
        </div>
        <div id="sample-prompt-box" class="status-bar" style="margin-bottom:14px; color:var(--text);"></div>
        <div class="grid-2">
          <div>
            <label id="base-sample-label">Unadapted Base Output</label>
            <pre class="code-box" id="base-sample-code"></pre>
          </div>
          <div>
            <label id="adapter-sample-label">Vox Mens Verified Output</label>
            <pre class="code-box" id="adapter-sample-code"></pre>
          </div>
        </div>
      </div>

      <div class="panel">
        <h2><span>Reasoning Collateral Check (Thinking Mode — McNemar Paired Test)</span></h2>
        <div id="collateral-table-wrap"></div>
      </div>
    </div>

    <!-- TAB 2: IN-BROWSER WEBGPU & UNIVERSAL INFERENCE PROVIDER ROUTER -->
    <div id="tab-webgpu" class="hidden">
      <div class="panel">
        <h2>
          <span>Side-by-Side Coding Playground (Browser WebGPU · HF Inference Providers · Local Serve)</span>
          <span class="badge" id="lora-manifest-badge">Adapter: Not Loaded</span>
        </h2>
        <p style="margin:0 0 14px; font-size:0.85rem; color:var(--muted);">
          Pick any model size from <strong>0.8B</strong> (instant browser checks) up to <strong>27B</strong> (multi-file reasoning):
          <strong>In-Browser WebGPU</strong> runs the <em>base</em> model live in your browser (<code>0.8B</code>–<code>4B</code>); the Vox Mens column shows the adapter's recorded held-out output, labelled as recorded, because a browser-ready merged export of the adapter is not published yet;
          <strong>HF Inference Provider Router</strong> calls Hugging Face's router (<code>https://router.huggingface.co/v1/chat/completions</code>) with your own <code>hf_</code> token; it serves the base models (2B and up), not the Vox Mens adapters, which no provider hosts;
          <strong>Local `vox mens serve`</strong> connects to your own machine (<code>http://127.0.0.1:11435/v1/chat/completions</code>).
        </p>
        <div class="grid-2" style="margin-bottom:12px;">
          <div>
            <label for="inference-provider-select">Inference Provider Backend:</label>
            <select id="inference-provider-select">
              <option value="auto" selected>Auto (In-Browser WebGPU 0.8B–4B · HF Router / Local Serve 9B–27B)</option>
              <option value="webgpu">In-Browser WebGPU: live base model (0.8B / 2B / 4B)</option>
              <option value="hf-router">Hugging Face Inference Provider Router (base models 2B–27B, your token)</option>
              <option value="local-serve">Local `vox mens serve` OpenAI Endpoint (All Sizes 0.8B–27B · 127.0.0.1:11435)</option>
            </select>
          </div>
          <div>
            <label for="provider-endpoint-input">HF Token (`hf_...` kept in sessionStorage only) or Local Endpoint URL:</label>
            <input type="password" id="provider-endpoint-input" placeholder="Optional: hf_... token for router.huggingface.co, or http://127.0.0.1:11435/v1/chat/completions" style="width:100%; background:#fcfaf5; color:var(--text); border:1px solid var(--border); border-radius:8px; padding:10px 12px; font-family:var(--mono); font-size:0.82rem;" />
          </div>
        </div>
        <div class="grid-2" style="margin-bottom:12px;">
          <div>
            <label for="system-prompt-input">Canonical Vox System Prompt (`vox_corpus::training` SSOT):</label>
            <textarea id="system-prompt-input" rows="7">You are a Vox programming language expert and code generation assistant. Vox is an AI-native, full-stack language that compiles to native Rust and TypeScript.

## Rules
- Brace-delimited blocks, no semicolons, no significant indentation. Comments: `//`, `///`.
- Return types use `to`: `fn name(p: T) to U { ... }`. Never `->` for returns (`->` is only in `state_machine`).
- No null: use `Option[T]`, `Result[T]` (or `Result[T, E]`), and tagged unions (`Ok(v)`, `Error(msg)`).
- `let x = expr`, `let mut x = expr`, `return expr`, `if c { } else { }`, `while c { }`, `for x in xs { }`, `for i in range(0, n) { }`, `match e { Variant(f) => body }`. Never `0..n` or `0..=n` ranges.
- Operators: `and`, `or`, `not`, `is`, `is not`, `+`, `-`, `*`, `/`, `%`, `<`, `<=`, `>`, `>=`. Never `&`, `|`, `^`, `<<`, `>>` (use `/ 2` and `% 2`), and never Python `x in xs` (use `xs.contains(x)`).
- Lists (`list[T]`): `xs.len()`, `xs = xs.push(v)`, `xs.remove_at(i)`, `xs.reversed()`, `xs.contains(v)`. Indexing `xs[i]` returns `Option[T]` — unwrap with `xs[i].unwrap()` or `match xs[i] { Some(v) => ... None => {} }`; never slice `xs[a..b]` and never use `(A, B)` tuple types (define `type Pair = | Pair(a: str, b: int)`).
- Strings (`str`, no `char` type): 1-char `str` literals, `s.len()`, `s.chars()`, `s.slice(i, i + 1)`, `c.ord()`, `chr(n)`, `str(n)`, `s.to_int()`, `float(n)`.

## Declarations (bare keywords)
- `type Name { field: T }`, `type Name = | A | B(field: T)`
- `table Name { field: T }`, `query name(p: T) to U { }`, `mutation name(p: T) to U { }`, `server name(p: T) to U { }` (queries/mutations use `db.Name.*` and every parameter; never constant stubs)
- `tool "name: description" name(p: T) to U { }`, `resource "uri" "description" name() to U { }`
- `component Name() { view: column() { text() { "{x}" } } }`
- `actor Name { on handler(p: T) to U { } }`, `spawn(Name)`
- `workflow name(p: T) to Result[U] { }` calling `activity name(p: T) to Result[U] { }`
- `routes { "/" to Home }`, `state_machine Name { state A state B on Ev() from A -> B }`, `import module.name`
- Modifiers: `@test` (must define any helper `fn` it calls), `@pure`, `@uses(net)`, `@scheduled("1h")`, `@auth(scheme: bearer)`, `@deprecated`, `@durable`.</textarea>
          </div>
          <div>
            <label for="user-prompt-input">User Prompt:</label>
            <textarea id="user-prompt-input" rows="7">Write a Vox program that: write a test named `smoke` that calls `add(1, 2)` and asserts the result equals 3</textarea>
          </div>
        </div>
        <div style="display:flex; flex-wrap:wrap; gap:12px; align-items:center; margin-bottom:14px;">
          <div style="width:160px;">
            <label for="max-tokens-input">Max New Tokens:</label>
            <input type="number" id="max-tokens-input" value="192" min="16" max="512" step="16" />
          </div>
          <div style="padding-top:18px; display:flex; gap:10px;">
            <button class="primary" id="run-webgpu-btn" type="button">⚡ Run base live + show Vox Mens output</button>
            <button class="secondary" id="inspect-safetensors-btn" type="button">Inspect Live Adapter SafeTensors Header</button>
          </div>
        </div>
        <div class="status-bar" id="webgpu-status">Ready. Select any ladder size (0.8B–27B) and click Decode to run inference.</div>
        <div class="grid-2" style="margin-top:14px;">
          <div>
            <label id="webgpu-base-label">Unadapted Base Live Output</label>
            <pre class="code-box" id="webgpu-base-output"></pre>
          </div>
          <div>
            <label id="webgpu-adapter-label">Vox Mens Live Output</label>
            <pre class="code-box" id="webgpu-adapter-output"></pre>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script type="module">
    const NAMESPACE = "{{NAMESPACE}}";
    const HF_TOKEN_SESSION_KEY = "vox_mens_playground_hf_token";
    let SIZES = ["0.8B", "2B", "4B", "9B", "27B"];
    const RUNG_DEFAULTS = {
      "0.8B": {
        family: "qwen3.5",
        label: "Vox Mens 0.8B",
        repoSlug: "vox-mens-qwen3.5-0.8b",
        baseModel: "Qwen/Qwen3.5-0.8B",
        onnxRepo: "onnx-community/Qwen3.5-0.8B-ONNX",
        webgpuCapable: true,
        noThinkSwitch: false,
      },
      "2B": {
        family: "qwen3.5",
        label: "Vox Mens 2B",
        repoSlug: "vox-mens-qwen3.5-2b",
        baseModel: "Qwen/Qwen3.5-2B",
        onnxRepo: "onnx-community/Qwen3.5-2B-ONNX",
        webgpuCapable: true,
        noThinkSwitch: false,
      },
      "4B": {
        family: "qwen3.5",
        label: "Vox Mens 4B",
        repoSlug: "vox-mens-qwen3.5-4b",
        baseModel: "Qwen/Qwen3.5-4B",
        onnxRepo: "onnx-community/Qwen3.5-4B-ONNX",
        webgpuCapable: true,
        noThinkSwitch: false,
      },
      "9B": {
        family: "qwen3.5",
        label: "Vox Mens 9B",
        repoSlug: "vox-mens-qwen3.5-9b",
        baseModel: "Qwen/Qwen3.5-9B",
        onnxRepo: null,
        webgpuCapable: false,
        noThinkSwitch: false,
      },
      "27B": {
        family: "qwen3.8",
        label: "Vox Mens 27B",
        repoSlug: "vox-mens-qwen3.8-27b",
        baseModel: "Qwen/Qwen3.8-27B",
        onnxRepo: null,
        webgpuCapable: false,
        noThinkSwitch: false,
      },
    };
    const LEGACY_RUNG_DEFAULTS = {
      "0.6B": { family: "qwen3", label: "Qwen3-0.6B", repoSlug: "vox-mens-qwen3-0.6b", baseModel: "Qwen/Qwen3-0.6B", onnxRepo: "onnx-community/Qwen3-0.6B-ONNX", webgpuCapable: true, noThinkSwitch: true },
      "1.7B": { family: "qwen3", label: "Qwen3-1.7B", repoSlug: "vox-mens-qwen3-1.7b", baseModel: "Qwen/Qwen3-1.7B", onnxRepo: "onnx-community/Qwen3-1.7B-ONNX", webgpuCapable: true, noThinkSwitch: true },
      "8B": { family: "qwen3", label: "Qwen3-8B", repoSlug: "vox-mens-qwen3-8b", baseModel: "Qwen/Qwen3-8B", onnxRepo: "onnx-community/Qwen3-8B-ONNX", webgpuCapable: false, noThinkSwitch: true },
      "14B": { family: "qwen3", label: "Qwen3-14B", repoSlug: "vox-mens-qwen3-14b", baseModel: "Qwen/Qwen3-14B", onnxRepo: null, webgpuCapable: false, noThinkSwitch: true },
      "32B": { family: "qwen3", label: "Qwen3-32B", repoSlug: "vox-mens-qwen3-32b", baseModel: "Qwen/Qwen3-32B", onnxRepo: null, webgpuCapable: false, noThinkSwitch: true },
    };

    const state = {
      activeSize: "0.8B",
      ladderIndex: null,
      ladderBySize: {},
      rungCache: {},
      filteredSamples: [],
      webgpuBusy: false,
      cachedSessions: {},
      hfToken: "",
    };

    const el = (id) => document.getElementById(id);

    function inferFamily(baseOrRepo, size) {
      const low = String(baseOrRepo || "").toLowerCase();
      if (low.includes("qwen3.8")) return "qwen3.8";
      if (low.includes("qwen3.5")) return "qwen3.5";
      if (low.includes("qwen3-")) return "qwen3";
      return (RUNG_DEFAULTS[size] || LEGACY_RUNG_DEFAULTS[size] || { family: "qwen3" }).family;
    }

    function modelLabelFor(_family, size) {
      return `Vox Mens ${size}`;
    }

    function rungInfo(size) {
      const def = RUNG_DEFAULTS[size] || LEGACY_RUNG_DEFAULTS[size] || {
        family: "qwen3.5",
        label: `Vox Mens ${size}`,
        repoSlug: `vox-mens-qwen3.5-${size.toLowerCase()}`,
        baseModel: `Qwen/Qwen3.5-${size}`,
        onnxRepo: null,
        webgpuCapable: false,
        noThinkSwitch: false,
      };
      const row = state.ladderBySize[size] || null;
      const baseRaw = (row && row.base_pin ? String(row.base_pin) : def.baseModel).split("@")[0];
      const repoId = (row && row.repo_id) ? String(row.repo_id) : `${NAMESPACE}/${def.repoSlug}`;
      const family = (row && row.family) ? String(row.family) : inferFamily(`${baseRaw} ${repoId}`, size);
      const label = `Vox Mens ${size}`;
      const localDir = (row && row.local_dir) || `mens/runs/${family}-${size.toLowerCase()}`;
      return {
        size,
        family,
        label,
        repoId,
        baseModel: baseRaw,
        onnxRepo: def.onnxRepo,
        webgpuCapable: Boolean(def.webgpuCapable && def.onnxRepo),
        noThinkSwitch: family === "qwen3",
        localDir,
        row,
      };
    }

    function formatUserPromptForModel(userPrompt, info) {
      const cleaned = String(userPrompt || "").replace(/\s*\/no_think\b/g, "").trim();
      return info && info.noThinkSwitch ? `${cleaned} /no_think` : cleaned;
    }

    function resolveUseRslora(adapterManifest, trainingManifest, adapterMetaV2, peftConfig) {
      for (const src of [peftConfig, adapterManifest, trainingManifest, adapterMetaV2]) {
        if (src && typeof src.use_rslora === "boolean") return src.use_rslora;
      }
      return false;
    }

    function getSessionHfToken() {
      const raw = (el("provider-endpoint-input")?.value || "").trim();
      if (raw.startsWith("hf_")) {
        state.hfToken = raw;
        try { sessionStorage.setItem(HF_TOKEN_SESSION_KEY, raw); } catch {}
        return raw;
      }
      if (state.hfToken) return state.hfToken;
      try {
        const stored = sessionStorage.getItem(HF_TOKEN_SESSION_KEY) || "";
        if (stored.startsWith("hf_")) {
          state.hfToken = stored;
          return stored;
        }
      } catch {}
      return "";
    }

    async function checkWebGPU() {
      const badge = el("webgpu-badge");
      if (!("gpu" in navigator)) {
        badge.textContent = "WASM SIMD Fallback (WebGPU Unavailable)";
        badge.className = "badge badge-warn";
        return false;
      }
      try {
        const adapter = await navigator.gpu.requestAdapter();
        if (!adapter) {
          badge.textContent = "WASM SIMD Fallback (No WebGPU Adapter)";
          badge.className = "badge badge-warn";
          return false;
        }
        badge.textContent = "WebGPU Ready";
        badge.className = "badge badge-pass";
        return true;
      } catch (err) {
        badge.textContent = "WASM SIMD Fallback";
        badge.className = "badge badge-warn";
        return false;
      }
    }

    function hfUrl(repoId, path) {
      return `https://huggingface.co/${repoId}/resolve/main/${path}`;
    }

    function repoIdForSize(size) {
      return rungInfo(size).repoId;
    }

    async function fetchJsonOptional(repoId, path) {
      try {
        const res = await fetch(hfUrl(repoId, path));
        if (!res.ok) return null;
        return await res.json();
      } catch {
        return null;
      }
    }

    async function fetchJsonlOptional(repoId, path) {
      try {
        const res = await fetch(hfUrl(repoId, path));
        if (!res.ok) return [];
        const text = await res.text();
        return text
          .split("\n")
          .map((l) => l.trim())
          .filter(Boolean)
          .map((l) => {
            try { return JSON.parse(l); } catch { return null; }
          })
          .filter(Boolean);
      } catch {
        return [];
      }
    }

    function parsePromptTurn(promptJson) {
      if (!promptJson) return "";
      try {
        const parsed = JSON.parse(promptJson);
        if (Array.isArray(parsed)) {
          const userMsg = parsed.find((m) => m && m.role === "user");
          if (userMsg && typeof userMsg.content === "string") return userMsg.content;
        }
      } catch {}
      return String(promptJson);
    }

    function escapeHtml(str) {
      return String(str ?? "")
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#39;");
    }

    function extractAnswerRegion(text) {
      if (typeof text !== "string") return "";
      const closeIdx = text.lastIndexOf("</think>");
      if (closeIdx !== -1) return text.slice(closeIdx + "</think>".length).trimStart();
      if (text.trimStart().startsWith("<think>")) return "";
      return text;
    }

    function extractShownCode(text) {
      const body = extractAnswerRegion(text);
      const start = body.indexOf("```");
      if (start === -1) return body.trim();
      const after = body.slice(start + 3);
      const nl = after.indexOf("\n");
      const code = nl === -1 ? after : after.slice(nl + 1);
      const end = code.indexOf("```");
      return (end === -1 ? code : code.slice(0, end)).trim();
    }

    function matchCkptText(preview, texts) {
      if (!preview || typeof preview !== "string") return null;
      if (Array.isArray(texts) && texts.length > 0) {
        const pHead = Array.from(preview).slice(0, 240).join("");
        const hits = texts.filter(
          (t) =>
            extractAnswerRegion(t).slice(0, 240) === preview.slice(0, 240) ||
            Array.from(extractAnswerRegion(t)).slice(0, 240).join("") === pHead
        );
        if (hits.length === 1) return extractShownCode(hits[0]);
      }
      return extractShownCode(preview);
    }

    function parseCkptLines(rows) {
      if (!Array.isArray(rows) || rows.length === 0) return { texts: [], serving: null };
      const header = rows[0] || {};
      const serving = header?.inputs?.model?.adapter_serving || null;
      const texts = [];
      for (let i = 1; i < rows.length; i++) {
        const r = rows[i];
        if (!r || typeof r.response !== "string") continue;
        try {
          const parsed = JSON.parse(r.response);
          if (typeof parsed.generated_text === "string") texts.push(parsed.generated_text);
        } catch {}
      }
      return { texts, serving };
    }

    async function loadLadderIndex() {
      let indexData = null;
      try {
        const rawRes = await fetch(`https://huggingface.co/${NAMESPACE}/vox-mens-index/raw/main/ladder_index.json`);
        if (rawRes.ok) indexData = await rawRes.json();
      } catch {}
      if (!indexData) {
        indexData = await fetchJsonOptional(`${NAMESPACE}/vox-mens-index`, "ladder_index.json");
      }
      state.ladderIndex = indexData;
      if (indexData && Array.isArray(indexData.sizes) && indexData.sizes.length > 0) {
        const nextMap = {};
        const allSizes = [];
        const passedSizes = [];
        for (const r of indexData.sizes) {
          if (!r || !r.size) continue;
          nextMap[r.size] = r;
          if (!allSizes.includes(r.size)) allSizes.push(r.size);
          const gate = r.gate_status || r.remote_gate_status || r.local_gate_status || "";
          if (gate === "passed" && !passedSizes.includes(r.size)) passedSizes.push(r.size);
        }
        const visibleSizes = passedSizes.length > 0 ? passedSizes : allSizes;
        if (visibleSizes.length > 0) {
          SIZES = visibleSizes;
          state.ladderBySize = nextMap;
          if (!SIZES.includes(state.activeSize)) {
            state.activeSize = SIZES[0];
          }
          const sel = el("size-select");
          if (sel) {
            sel.innerHTML = "";
            for (const sz of SIZES) {
              const info = rungInfo(sz);
              const opt = document.createElement("option");
              opt.value = sz;
              opt.textContent = info.label;
              sel.appendChild(opt);
            }
            sel.value = state.activeSize;
          }
          state.rungCache = {};
        }
      }
      renderLadderStrip();
      const activeInfo = rungInfo(state.activeSize);
      if (el("rung-summary-title")) {
        el("rung-summary-title").textContent = `${activeInfo.label} Live Hub Evidence`;
      }
      if (el("rung-repo-link")) {
        el("rung-repo-link").innerHTML = `<a href="https://huggingface.co/${escapeHtml(activeInfo.repoId)}" target="_blank" rel="noopener">${escapeHtml(activeInfo.repoId)} ↗</a>`;
      }
    }

    function renderLadderStrip() {
      const strip = el("ladder-strip");
      strip.innerHTML = "";
      for (const size of SIZES) {
        const info = rungInfo(size);
        const r = info.row || {};
        const card = document.createElement("div");
        card.className = `rung-card${state.activeSize === size ? " active" : ""}`;
        const status = r.gate_status || r.remote_gate_status || r.local_gate_status || "untrained";
        const statusShort = status.startsWith("ungated") ? "ungated" : status;
        let badgeClass = "badge-warn";
        if (status === "passed") badgeClass = "badge-pass";
        else if (status.startsWith("failed") || status.startsWith("ungated")) badgeClass = "badge-fail";
        const rev = r.latest_version || (r.remote_revision ? `v${r.remote_revision}` : (r.sync_status || "n/a"));
        card.innerHTML = `
          <div class="rung-top">
            <span class="rung-size">${escapeHtml(info.label)}</span>
            <span class="badge ${escapeHtml(badgeClass)}" title="${escapeHtml(status)}">${escapeHtml(statusShort)}</span>
          </div>
          <div class="rung-meta">Hub: ${escapeHtml(rev)} · ${escapeHtml(r.sync_status || "unknown")}</div>
        `;
        card.addEventListener("click", () => selectSize(size));
        strip.appendChild(card);
      }
    }

    async function loadRungEvidence(size) {
      if (state.rungCache[size]) return state.rungCache[size];
      const repoId = repoIdForSize(size);
      const [
        syncManifest,
        adapterManifest,
        trainingManifest,
        adapterMetaV2,
        peftConfig,
        gateReceipt,
        collateral,
        baseReport,
        adapterReport,
        baseCkpt,
        adapterCkpt,
      ] = await Promise.all([
        fetchJsonOptional(repoId, "hf_sync_manifest.json"),
        fetchJsonOptional(repoId, "adapter_manifest.json"),
        fetchJsonOptional(repoId, "training_manifest.json"),
        fetchJsonOptional(repoId, "adapter_meta_v2.json"),
        fetchJsonOptional(repoId, "peft/adapter_config.json").then((c) => c || fetchJsonOptional(repoId, "adapter_config.json")),
        fetchJsonOptional(repoId, "gate_receipt.json"),
        fetchJsonOptional(repoId, "collateral_damage_report.json"),
        fetchJsonOptional(repoId, "evidence/heldout_base_nothink.json"),
        fetchJsonOptional(repoId, "evidence/heldout_adapter_nothink.json"),
        fetchJsonlOptional(repoId, "evidence/heldout_base_nothink.ckpt.jsonl"),
        fetchJsonlOptional(repoId, "evidence/heldout_adapter_nothink.ckpt.jsonl"),
      ]);

      const baseCkptParsed = parseCkptLines(baseCkpt);
      const adapterCkptParsed = parseCkptLines(adapterCkpt);
      const adapterServing =
        adapterCkptParsed.serving ||
        (adapterReport && adapterReport.adapter_serving) ||
        "none";

      const baseResults =
        baseReport && Array.isArray(baseReport.results)
          ? baseReport.results
          : baseReport && Array.isArray(baseReport.samples)
            ? baseReport.samples
            : [];
      const adapterResults =
        adapterReport && Array.isArray(adapterReport.results)
          ? adapterReport.results
          : adapterReport && Array.isArray(adapterReport.samples)
            ? adapterReport.samples
            : [];
      const adapterById = {};
      for (const r of adapterResults) {
        const id = r.id || r.sample_id;
        if (id) adapterById[id] = r;
      }

      const joined = [];
      for (const b of baseResults) {
        const itemId = b.id || b.sample_id;
        if (!itemId) continue;
        const a = adapterById[itemId] || null;
        const bSample = Array.isArray(b.samples) && b.samples[0] ? b.samples[0] : b;
        const aSample = a ? (Array.isArray(a.samples) && a.samples[0] ? a.samples[0] : a) : null;

        const bPass = Boolean(bSample?.pass ?? bSample?.constructed);
        const aPass = aSample ? Boolean(aSample?.pass ?? aSample?.constructed) : false;
        let verdict = "STILL_FAILS";
        if (!bPass && aPass) verdict = "FIXED";
        else if (bPass && aPass) verdict = "BOTH_PASS";
        else if (bPass && !aPass) verdict = "REGRESSION";

        const bPreview = typeof bSample?.completion_preview === "string" ? bSample.completion_preview : null;
        const aPreview = typeof aSample?.completion_preview === "string" ? aSample.completion_preview : null;
        const baseOutput = matchCkptText(bPreview, baseCkptParsed.texts);
        const adapterOutput = matchCkptText(aPreview, adapterCkptParsed.texts);
        const promptText = "Write a Vox program that: " + (b.description || itemId);

        joined.push({
          sample_id: itemId,
          category: b.category || "vox",
          verdict,
          base: bSample,
          adapter: aSample,
          baseOutput,
          adapterOutput,
          promptText,
        });
      }

      const bundle = {
        size,
        repoId,
        syncManifest,
        adapterManifest,
        trainingManifest,
        adapterMetaV2,
        peftConfig,
        gateReceipt,
        collateral,
        baseReport,
        adapterReport,
        adapterServing,
        joined,
      };
      state.rungCache[size] = bundle;
      return bundle;
    }

    function formatDiag(sample) {
      if (!sample) return "not evaluated";
      const passed = Boolean(sample.pass ?? sample.constructed);
      if (passed) return "PASS (parse + HIR + typecheck + AST checks)";
      const c = sample.checks || sample;
      if (c.non_empty === false) return "FAIL: empty output";
      if (c.parse_ok === false) return `FAIL: parse (${c.parse_error || sample.error_Preview || "syntax error"})`;
      if (c.hir_ok === false) return "FAIL: HIR lowering";
      if (c.typecheck_ok === false) {
        const errDetail =
          typeof c.diag_errors === "number"
            ? `${c.diag_errors} type error(s)`
            : sample.first_typecheck_error || "type error";
        return `FAIL: typecheck (${errDetail})`;
      }
      if (c.anti_stub_pass === false) return "FAIL: anti-stub check";
      if (c.pass_compile === false) return "FAIL: compile check";
      if (c.pass_ast === false) return "FAIL: AST check";
      if (Array.isArray(sample.ast_check_failures) && sample.ast_check_failures.length > 0) {
        return `FAIL: AST (${sample.ast_check_failures.join(", ")})`;
      }
      return "FAIL: empty/unconstructed";
    }

    async function selectSize(size) {
      const info = rungInfo(size);
      state.activeSize = size;
      el("size-select").value = size;
      renderLadderStrip();
      el("rung-summary-title").textContent = `${info.label} Live Hub Evidence`;
      const repoId = info.repoId;
      el("rung-repo-link").innerHTML = `<a href="https://huggingface.co/${escapeHtml(repoId)}" target="_blank" rel="noopener">${escapeHtml(repoId)} ↗</a>`;
      el("rung-summary-body").textContent = `Loading live artifacts from ${repoId}…`;

      const bundle = await loadRungEvidence(size);
      const sm = bundle.syncManifest;
      const gr = bundle.gateReceipt;
      const br = bundle.baseReport;
      const ar = bundle.adapterReport;

      const brPassed = br ? (br.passed_at_1 ?? br.constructed ?? 0) : 0;
      const brRate = br ? (br.pass_rate_at_1 ?? br.pass_rate ?? 0) : 0;
      const baseScore = br ? `${brPassed}/${br.total} (${(brRate * 100).toFixed(1)}%)` : "n/a";
      const adapterServing = bundle.adapterServing || (ar && ar.adapter_serving) || "none";
      const adapterCurrent = adapterServing === "nf4_base_plus_lora_arm v2";
      const arPassed = ar ? (ar.passed_at_1 ?? ar.constructed ?? 0) : 0;
      const arRate = ar ? (ar.pass_rate_at_1 ?? ar.pass_rate ?? 0) : 0;
      const adapterScore = (ar && adapterCurrent)
        ? `${arPassed}/${ar.total} (${(arRate * 100).toFixed(1)}%)`
        : (ar ? `stale serving (${adapterServing})` : "n/a");

      const gatePassed = gr ? Boolean(gr.overall_passed ?? gr.passed) : false;
      const gateBlocking = gr
        ? Array.isArray(gr.gates)
          ? gr.gates.filter((g) => g && !g.passed && g.block).map((g) => `${g.name}: ${g.message}`)
          : Array.isArray(gr.blocking_reasons)
            ? gr.blocking_reasons
            : []
        : [];
      const gateText = gr
        ? gatePassed
          ? "PASSED"
          : `FAILED (${gateBlocking.join("; ") || "blocked"})`
        : "not gated";

      const indexRow =
        state.ladderIndex && Array.isArray(state.ladderIndex.sizes)
          ? state.ladderIndex.sizes.find((x) => x && x.size === size)
          : null;
      const latestVersion =
        (indexRow && indexRow.latest_version) ||
        (sm && sm.hub_revision ? `v${sm.hub_revision}` : "published");
      const basePinCommit = sm ? String(sm.base_pin || sm.base_model || "").slice(-12) : "";
      const corpusShort = sm && sm.corpus_hash ? `, corpus ${String(sm.corpus_hash).slice(0, 12)}` : "";
      const revText = sm
        ? `${latestVersion} (base ${basePinCommit || "n/a"}${corpusShort})`
        : "no hf_sync_manifest.json";

      el("rung-summary-body").innerHTML = `
        <div><strong>Hub Manifest:</strong> ${escapeHtml(revText)} · <strong>Gate Receipt:</strong> ${escapeHtml(gateText)}</div>
        <div style="margin-top:4px;">
          <strong>Held-Out Base pass@1:</strong> ${escapeHtml(baseScore)} ·
          <strong>Held-Out Adapter pass@1:</strong> ${escapeHtml(adapterScore)} ·
          <strong>Serving Path:</strong> <code>${escapeHtml(adapterServing)}</code>
        </div>
      `;

      renderSampleList(bundle);
      renderCollateralTable(bundle);
    }

    function renderSampleList(bundle) {
      const filter = el("filter-verdict").value;
      state.filteredSamples = bundle.joined.filter((item) => filter === "ALL" || item.verdict === filter);
      const sel = el("sample-select");
      sel.innerHTML = "";
      if (state.filteredSamples.length === 0) {
        const opt = document.createElement("option");
        opt.textContent = "No held-out samples match filter on Hub";
        sel.appendChild(opt);
        el("sample-prompt-box").textContent = "No recorded held-out sample available for this filter.";
        el("base-sample-code").textContent = "";
        el("adapter-sample-code").textContent = "";
        return;
      }
      state.filteredSamples.forEach((item, idx) => {
        const opt = document.createElement("option");
        opt.value = String(idx);
        opt.textContent = `[${item.verdict}] ${item.sample_id} (${item.category})`;
        sel.appendChild(opt);
      });
      sel.value = "0";
      renderSelectedSample();
    }

    function renderSelectedSample() {
      const idx = Number(el("sample-select").value || 0);
      const item = state.filteredSamples[idx];
      if (!item) return;
      const info = rungInfo(state.activeSize);
      el("sample-prompt-box").textContent = `Prompt (${item.sample_id}): ${item.promptText}`;
      el("base-sample-label").textContent = `Pinned Base ${state.activeSize} — ${formatDiag(item.base)}`;
      el("adapter-sample-label").textContent = `Vox MENS LoRA Adapter — ${formatDiag(item.adapter)}`;
      el("base-sample-code").textContent = item.baseOutput ?? "(no recorded checkpoint output)";
      el("adapter-sample-code").textContent = item.adapterOutput ?? "(no recorded checkpoint output)";
    }

    function renderCollateralTable(bundle) {
      const wrap = el("collateral-table-wrap");
      const col = bundle.collateral;
      const benches = (col && col.reasoning_slices && col.reasoning_slices.benches) || (col && col.slices) || null;
      if (!benches || Object.keys(benches).length === 0) {
        wrap.innerHTML = `<div style="color:var(--muted); font-family:var(--mono); font-size:0.82rem;">No collateral_damage_report.json published for ${escapeHtml(rungInfo(bundle.size).label)}.</div>`;
        return;
      }
      const rowsHtml = Object.entries(benches).map(([name, entry]) => {
        const acc = entry && entry.accuracy ? entry.accuracy : (entry || {});
        const nItems = entry?.n ?? acc.n ?? acc.n_items ?? 0;
        const preRate = Number(acc.pre ?? acc.pre_rate ?? 0);
        const postRate = Number(acc.post ?? acc.post_rate ?? 0);
        const dropPp =
          typeof acc.absolute_drop_pp === "number"
            ? acc.absolute_drop_pp
            : (preRate - postRate) * 100;
        const pre = (preRate * 100).toFixed(1) + "%";
        const post = (postRate * 100).toFixed(1) + "%";
        const drop = (dropPp >= 0 ? "+" : "") + dropPp.toFixed(2) + " pp";
        const losses = acc.losses ?? acc.b_pre_only_correct ?? 0;
        const gains = acc.gains ?? acc.c_post_only_correct ?? 0;
        const pRaw = acc.p_value ?? acc.mcnemar_p_value;
        const pVal = typeof pRaw === "number" ? pRaw.toFixed(4) : "n/a";
        const regressed =
          typeof acc.regressed === "boolean"
            ? acc.regressed
            : typeof pRaw === "number"
              ? pRaw < 0.05 && dropPp > 0
              : false;
        const pass = !regressed;
        return `
          <tr>
            <td>${escapeHtml(name)}</td>
            <td>${escapeHtml(nItems)}</td>
            <td>${escapeHtml(pre)}</td>
            <td>${escapeHtml(post)}</td>
            <td>${escapeHtml(drop)}</td>
            <td>b=${escapeHtml(losses)}, c=${escapeHtml(gains)}</td>
            <td><span class="badge ${pass ? "badge-pass" : "badge-fail"}">p = ${escapeHtml(pVal)}</span></td>
          </tr>
        `;
      }).join("");
      wrap.innerHTML = `
        <table>
          <thead>
            <tr>
              <th>Slice</th>
              <th>Items</th>
              <th>Base Accuracy</th>
              <th>Adapter Accuracy</th>
              <th>Drop (pp)</th>
              <th>Discordant Pairs (b, c)</th>
              <th>McNemar p-value (α=0.05)</th>
            </tr>
          </thead>
          <tbody>${rowsHtml}</tbody>
        </table>
      `;
    }

    // =========================================================================
    // SafeTensors header parser (adapter metadata for the rank/alpha badge)
    // =========================================================================

    function fp16ToFp32(u16) {
      const s = (u16 & 0x8000) >> 15;
      const e = (u16 & 0x7c00) >> 10;
      const f = u16 & 0x03ff;
      if (e === 0) {
        return (s ? -1 : 1) * Math.pow(2, -14) * (f / 1024);
      }
      if (e === 0x1f) {
        return f ? NaN : (s ? -Infinity : Infinity);
      }
      return (s ? -1 : 1) * Math.pow(2, e - 15) * (1 + f / 1024);
    }

    const _f32Buf = new Float32Array(1);
    const _u32Buf = new Uint32Array(_f32Buf.buffer);
    function bf16ToFp32(u16) {
      _u32Buf[0] = (u16 & 0xffff) << 16;
      return _f32Buf[0];
    }

    function parseSafetensors(arrayBuffer) {
      const view = new DataView(arrayBuffer);
      const headerLen = Number(view.getBigUint64(0, true));
      const headerBytes = new Uint8Array(arrayBuffer, 8, headerLen);
      const headerJson = JSON.parse(new TextDecoder().decode(headerBytes));
      const dataStart = 8 + headerLen;
      const tensors = {};
      for (const [name, meta] of Object.entries(headerJson)) {
        if (name === "__metadata__") continue;
        const [begin, end] = meta.data_offsets;
        const sliceBuf = arrayBuffer.slice(dataStart + begin, dataStart + end);
        let f32;
        if (meta.dtype === "F32") {
          f32 = new Float32Array(sliceBuf);
        } else if (meta.dtype === "F16" || meta.dtype === "BF16") {
          const u16 = new Uint16Array(sliceBuf);
          f32 = new Float32Array(u16.length);
          const isF16 = meta.dtype === "F16";
          for (let i = 0; i < u16.length; i++) {
            f32[i] = isF16 ? fp16ToFp32(u16[i]) : bf16ToFp32(u16[i]);
          }
        } else {
          throw new Error(
            `Unsupported SafeTensors dtype "${meta.dtype}" for tensor "${name}" (expected F32, F16, or BF16)`
          );
        }
        tensors[name] = {
          dtype: meta.dtype,
          shape: meta.shape,
          f32,
        };
      }
      return tensors;
    }

    async function fetchAdapterArtifacts(repoId, existingBundle) {
      const bundle = existingBundle || {};
      const [adapterManifest, trainingManifest, adapterMetaV2, peftConfig] = await Promise.all([
        bundle.adapterManifest !== undefined ? bundle.adapterManifest : fetchJsonOptional(repoId, "adapter_manifest.json"),
        bundle.trainingManifest !== undefined ? bundle.trainingManifest : fetchJsonOptional(repoId, "training_manifest.json"),
        bundle.adapterMetaV2 !== undefined ? bundle.adapterMetaV2 : fetchJsonOptional(repoId, "adapter_meta_v2.json"),
        bundle.peftConfig !== undefined
          ? bundle.peftConfig
          : fetchJsonOptional(repoId, "peft/adapter_config.json").then((c) => c || fetchJsonOptional(repoId, "adapter_config.json")),
      ]);

      let sourceFile = null;
      let buf = null;
      for (const candidate of [
        "candle_qlora_adapter.safetensors",
        "peft/adapter_model.safetensors",
        "adapter_model.safetensors",
      ]) {
        try {
          const res = await fetch(hfUrl(repoId, candidate));
          if (res.ok) {
            buf = await res.arrayBuffer();
            sourceFile = candidate;
            break;
          }
        } catch {}
      }
      if (!buf || !sourceFile) return null;

      const loraTensors = parseSafetensors(buf);
      const rank = Math.max(Number(peftConfig?.r ?? adapterManifest?.rank ?? 8), 1);
      const alpha = Number(peftConfig?.lora_alpha ?? adapterManifest?.alpha ?? 16);
      const useRslora = resolveUseRslora(adapterManifest, trainingManifest, adapterMetaV2, peftConfig);
      const scaleFactor = useRslora ? (alpha / Math.sqrt(rank)) : (alpha / rank);
      return {
        sourceFile,
        byteLength: buf.byteLength,
        loraTensors,
        rank,
        alpha,
        useRslora,
        scaleFactor,
        adapterManifest,
        trainingManifest,
        adapterMetaV2,
        peftConfig,
      };
    }

    async function inspectSafetensorsHeader() {
      const info = rungInfo(state.activeSize);
      const repoId = info.repoId;
      const statusEl = el("webgpu-status");
      statusEl.textContent = `Fetching adapter metadata and SafeTensors weights from ${repoId}…`;
      try {
        const bundle = await loadRungEvidence(state.activeSize).catch(() => null);
        const artifacts = await fetchAdapterArtifacts(repoId, bundle);
        if (!artifacts) {
          statusEl.textContent = `No Candle or PEFT adapter SafeTensors found on Hub for ${repoId}.`;
          return;
        }
        const keys = Object.keys(artifacts.loraTensors);
        const scaleMode = artifacts.useRslora ? "rsLoRA α/√r" : "α/r";
        el("lora-manifest-badge").textContent = `${state.activeSize}: ${keys.length} tensors (r=${artifacts.rank}, α=${artifacts.alpha}, ${scaleMode})`;
        el("lora-manifest-badge").className = "badge badge-pass";
        statusEl.textContent = `Verified ${repoId}/${artifacts.sourceFile} (${(artifacts.byteLength / 1048576).toFixed(2)} MiB): ${keys.length} LoRA tensors (${scaleMode}, scale=${artifacts.scaleFactor.toFixed(4)}).`;
      } catch (err) {
        statusEl.textContent = `Failed to inspect SafeTensors: ${err.message || err}`;
      }
    }

    async function probeRouterCompletion(endpointUrl, headers, candidateModels, payloadBase) {
      let lastStatus = 0;
      let lastErr = "";
      for (const modelId of candidateModels) {
        const res = await fetch(endpointUrl, {
          method: "POST",
          headers,
          body: JSON.stringify({ ...payloadBase, model: modelId }),
        });
        if (res.ok) {
          const data = await res.json();
          const content = data?.choices?.[0]?.message?.content || "";
          return { ok: true, modelId, content };
        }
        lastStatus = res.status;
        lastErr = await res.text().catch(() => "");
      }
      return { ok: false, status: lastStatus, errorText: lastErr };
    }

    function vramGuidanceNote(info) {
      if (info.size === "9B" || info.size === "27B") {
        return `Note: ${info.label} weights exceed browser WebGPU buffer limits; using HF Router / local vox mens serve / recorded eval evidence.`;
      }
      return "";
    }

    async function runProviderRouterSideBySide(size, mode) {
      const info = rungInfo(size);
      const repoId = info.repoId;
      const baseModelId = info.baseModel;
      const statusEl = el("webgpu-status");
      const rawInput = (el("provider-endpoint-input").value || "").trim();
      const token = getSessionHfToken();
      const sysPrompt = el("system-prompt-input").value.trim();
      const rawUserPrompt = el("user-prompt-input").value.trim();
      const formattedUserPrompt = formatUserPromptForModel(rawUserPrompt, info);
      const maxNewTokens = Math.max(16, Math.min(512, Number(el("max-tokens-input").value || 192)));

      statusEl.textContent = `[1/3] Inspecting ${repoId} SafeTensors and held-out checkpoint evidence…`;
      const bundle = await loadRungEvidence(size);
      const artifacts = await fetchAdapterArtifacts(repoId, bundle).catch(() => null);
      if (artifacts) {
        const scaleMode = artifacts.useRslora ? "rsLoRA α/√r" : "α/r";
        el("lora-manifest-badge").textContent = `${size}: ${Object.keys(artifacts.loraTensors).length} tensors (r=${artifacts.rank}, α=${artifacts.alpha}, ${scaleMode})`;
        el("lora-manifest-badge").className = "badge badge-pass";
      } else if (bundle.adapterManifest || bundle.peftConfig) {
        const r = Number(bundle.peftConfig?.r ?? bundle.adapterManifest?.rank ?? 0);
        const a = Number(bundle.peftConfig?.lora_alpha ?? bundle.adapterManifest?.alpha ?? 0);
        el("lora-manifest-badge").textContent = `${size}: Metadata Loaded (r=${r}, α=${a})`;
        el("lora-manifest-badge").className = "badge badge-pass";
      } else {
        el("lora-manifest-badge").textContent = `${size}: Untrained / Reserved`;
        el("lora-manifest-badge").className = "badge badge-warn";
      }

      const cleanedTarget = rawUserPrompt.replace(/\s*\/no_think\b/g, "").trim();
      const matchedSample = (bundle.joined || []).find(
        (item) => item.promptText && item.promptText.replace(/\s*\/no_think\b/g, "").trim() === cleanedTarget
      );
      // Recorded eval output is only ever shown with this marker, never as a live result.
      const recordedBase = matchedSample?.baseOutput
        ? `[RECORDED, not live: base output from the published held-out eval]\n${matchedSample.baseOutput}`
        : null;

      const endpointUrl =
        mode === "local-serve"
          ? rawInput.startsWith("http")
            ? rawInput
            : "http://127.0.0.1:11435/v1/chat/completions"
          : "https://router.huggingface.co/v1/chat/completions";

      const headers = { "Content-Type": "application/json" };
      if (token) {
        headers["Authorization"] = `Bearer ${token}`;
      }

      el("webgpu-base-label").textContent =
        mode === "local-serve"
          ? `Base ${size} (${endpointUrl})`
          : `Base ${baseModelId} via HF Inference Provider Router`;
      el("webgpu-adapter-label").textContent =
        mode === "local-serve"
          ? `${info.label} adapter via Local vox mens serve`
          : `${info.label} adapter (${repoId})`;

      const routerPayload = {
        messages: [
          { role: "system", content: sysPrompt },
          { role: "user", content: formattedUserPrompt },
        ],
        max_tokens: maxNewTokens,
        temperature: 0,
      };
      if (mode !== "local-serve" && !info.noThinkSwitch) {
        routerPayload.chat_template_kwargs = { enable_thinking: false };
      }

      statusEl.textContent = `[2/3] Querying ${endpointUrl} for ${info.label} (${repoId} + ${baseModelId})…`;
      let baseDone = false;
      try {
        const baseCandidates = mode === "local-serve" ? [repoId] : [`${baseModelId}:auto`];
        const baseProbe = await probeRouterCompletion(endpointUrl, headers, baseCandidates, routerPayload);
        if (baseProbe.ok) {
          if (mode === "local-serve") {
            el("webgpu-base-output").textContent =
              recordedBase || "(Pinned base checkpoint reference available in Tab 1)";
            el("webgpu-adapter-output").textContent = extractShownCode(baseProbe.content) || baseProbe.content;
            statusEl.textContent = `Completed live local-serve decode on ${repoId} via ${endpointUrl}.`;
            return;
          }
          el("webgpu-base-output").textContent = extractShownCode(baseProbe.content) || baseProbe.content;
          baseDone = true;
        } else {
          el("webgpu-base-output").textContent =
            recordedBase ||
            `[HF Router HTTP ${baseProbe.status}] Enter an hf_... token above for live cloud routing on ${baseModelId}, or use local vox mens serve.\n${baseProbe.errorText.slice(0, 240)}`;
        }
      } catch (err) {
        el("webgpu-base-output").textContent =
          recordedBase ||
          `[Endpoint unreachable: ${err.message || err}]\nTo serve ${repoId} locally with native Metal/CUDA NF4+LoRA:\n  vox mens serve --model ${info.localDir} --port 11435`;
      }

      if (mode === "hf-router") {
        try {
          const adapterProbe = await probeRouterCompletion(
            endpointUrl,
            headers,
            [`${repoId}:auto`, `${repoId}:featherless-ai`],
            routerPayload
          );
          if (adapterProbe.ok) {
            el("webgpu-adapter-output").textContent = extractShownCode(adapterProbe.content) || adapterProbe.content;
            statusEl.textContent = `Completed live HF Router decode via ${adapterProbe.modelId}${baseDone ? ` vs ${baseModelId}:auto` : ""}.`;
            return;
          }
        } catch {}
      }

      const vramNote = vramGuidanceNote(info);
      if (matchedSample && matchedSample.adapterOutput) {
        el("webgpu-adapter-label").textContent = `RECORDED, not live: ${info.label} output from the published held-out eval (${repoId})`;
        el("webgpu-adapter-output").textContent = matchedSample.adapterOutput;
        statusEl.textContent = `No live provider serves ${repoId}; showing its recorded held-out output. ${vramNote}`.trim();
      } else if (artifacts || bundle.adapterManifest || bundle.peftConfig) {
        const rank = artifacts?.rank ?? bundle.peftConfig?.r ?? bundle.adapterManifest?.rank ?? "?";
        const alpha = artifacts?.alpha ?? bundle.peftConfig?.lora_alpha ?? bundle.adapterManifest?.alpha ?? "?";
        el("webgpu-adapter-output").textContent =
          `Verified ${repoId}/${artifacts?.sourceFile || "adapter_manifest.json"} (r=${rank}, alpha=${alpha}).\n` +
          `No serverless HF Router provider hosted ${repoId}:auto / ${repoId}:featherless-ai.\n` +
          (vramNote ? `${vramNote}\n` : "") +
          `For custom prompts on ${info.label}, run local native Metal/CUDA serving:\n` +
          `  vox mens serve --model ${info.localDir} --port 11435\n` +
          `and select "Local vox mens serve" above, or inspect recorded held-out items in Tab 1.`;
        statusEl.textContent = `Verified ${repoId} on Hub. ${vramNote || "Select a held-out prompt in Tab 1 or connect Local vox mens serve."}`;
      } else {
        el("webgpu-adapter-output").textContent = `${repoId} is reserved on the ladder and has no trained adapter checkpoint yet.`;
        statusEl.textContent = `${repoId} is reserved (untrained). Base ${baseModelId} can be queried via HF Inference Provider Router with an hf_... token.`;
      }
    }

    async function runWebGpuSideBySide() {
      if (state.webgpuBusy) return;
      const size = state.activeSize;
      const info = rungInfo(size);
      const providerMode = el("inference-provider-select").value || "auto";
      const onnxRepo = info.onnxRepo;
      const statusEl = el("webgpu-status");

      state.webgpuBusy = true;
      el("run-webgpu-btn").disabled = true;
      el("webgpu-base-output").textContent = "";
      el("webgpu-adapter-output").textContent = "";

      try {
        if (
          providerMode === "hf-router" ||
          providerMode === "local-serve" ||
          (providerMode === "auto" && (!onnxRepo || !info.webgpuCapable || size === "9B" || size === "27B" || size === "8B" || size === "14B" || size === "32B"))
        ) {
          const effectiveMode = providerMode === "auto" ? "hf-router" : providerMode;
          await runProviderRouterSideBySide(size, effectiveMode);
          return;
        }
        if (!onnxRepo) {
          await runProviderRouterSideBySide(size, "hf-router");
          return;
        }
        const hasGpu = await checkWebGPU();
        const runtimeDevice = hasGpu ? "webgpu" : "wasm";
        el("webgpu-base-label").textContent = `Base ${size} (${runtimeDevice.toUpperCase()}, loading…)`;
        el("webgpu-adapter-label").textContent = `${info.label}`;

        // Live in-browser inference runs the BASE model only. Why: transformers.js cannot apply a
        // LoRA at runtime, and the onnx-community Qwen3.5 exports keep weights in external
        // `.onnx_data` files, so the old in-page q4f16 merge could not work (it fetched a file that
        // does not exist). The adapter column shows the published held-out output, labelled as
        // recorded, until a merged-ONNX export of the adapter is published (milestone v9.5).
        // Verified 2026-11-20: transformers.js 4.3.2 + Qwen3_5ForConditionalGeneration, q4,
        // Apple Metal WebGPU, load ~18 s, nonce prompt answered correctly.
        const repoId = info.repoId;
        statusEl.textContent = `[1/3] Loading transformers.js 4.3.2 and the base ${size} tokenizer (${onnxRepo})…`;
        const tj = await import("https://cdn.jsdelivr.net/npm/@huggingface/transformers@4.3.2");

        const sysPrompt = el("system-prompt-input").value.trim();
        const rawUserPrompt = el("user-prompt-input").value.trim();
        const userPrompt = formatUserPromptForModel(rawUserPrompt, info);
        const maxNewTokens = Math.max(16, Math.min(512, Number(el("max-tokens-input").value || 192)));

        const tokenizer = await tj.AutoTokenizer.from_pretrained(onnxRepo);
        const messages = [
          { role: "system", content: sysPrompt },
          { role: "user", content: userPrompt },
        ];
        const inputs = tokenizer.apply_chat_template(messages, {
          tokenize: true,
          add_generation_prompt: true,
          return_dict: true,
          enable_thinking: false,
        });

        let cached = state.cachedSessions[size];
        if (!cached) {
          statusEl.textContent = `[2/3] Downloading base ${size} weights (${onnxRepo}, q4; several hundred MB, cached by the browser after the first run)…`;
          const model =
            String(info.family).startsWith("qwen3.5")
              ? await tj.Qwen3_5ForConditionalGeneration.from_pretrained(onnxRepo, {
                  dtype: { embed_tokens: "q4", vision_encoder: "q4", decoder_model_merged: "q4" },
                  device: runtimeDevice,
                })
              : await tj.AutoModelForCausalLM.from_pretrained(onnxRepo, { dtype: "q4", device: runtimeDevice });
          cached = { model, runtimeDevice };
          state.cachedSessions[size] = cached;
        }

        el("webgpu-base-label").textContent = `LIVE in your browser (${cached.runtimeDevice.toUpperCase()}): base ${info.baseModel}`;
        statusEl.textContent = `[3/3] Generating with base ${size} in your browser…`;
        const baseStreamer = new tj.TextStreamer(tokenizer, {
          skip_prompt: true,
          skip_special_tokens: true,
          callback_function: (txt) => {
            el("webgpu-base-output").textContent += txt;
          },
        });
        const t0 = performance.now();
        await cached.model.generate({
          ...inputs,
          max_new_tokens: maxNewTokens,
          do_sample: false,
          streamer: baseStreamer,
        });
        const baseSec = ((performance.now() - t0) / 1000).toFixed(2);

        const cleanedTarget = rawUserPrompt.replace(/\s*\/no_think\b/g, "").trim();
        const bundle = await loadRungEvidence(size).catch(() => null);
        const matchedSample = (bundle?.joined || []).find(
          (item) => item.promptText && item.promptText.replace(/\s*\/no_think\b/g, "").trim() === cleanedTarget
        );
        if (matchedSample?.adapterOutput) {
          el("webgpu-adapter-label").textContent = `RECORDED, not live: ${info.label} output from the published held-out eval (${repoId})`;
          el("webgpu-adapter-output").textContent = matchedSample.adapterOutput;
        } else {
          el("webgpu-adapter-label").textContent = `${info.label} (${repoId}): not available live in the browser yet`;
          el("webgpu-adapter-output").textContent =
            `The fine-tuned adapter cannot run in the browser yet: a merged ONNX export is not published.\n` +
            `To run ${info.label} on your own prompt, serve it locally and pick "Local vox mens serve" above:\n` +
            `  vox mens serve --model ${info.localDir} --port 11435\n` +
            `Or pick a held-out prompt in Tab 1 to compare against its recorded adapter output.`;
        }
        statusEl.textContent = `Base ${size} generated live in your browser on ${cached.runtimeDevice.toUpperCase()} in ${baseSec}s.`;
      } catch (err) {
        statusEl.textContent = `WebGPU Inference Error on ${info.label}: ${err.message || err}. For large weights or browser VRAM limits, switch to HF Inference Provider Router, run \`vox mens serve --model ${info.localDir}\`, or view Tab 1 recorded eval evidence.`;
      } finally {
        state.webgpuBusy = false;
        el("run-webgpu-btn").disabled = false;
      }
    }

    function resolveSizeParam(rawParam) {
      const cleaned = String(rawParam || "0.8B")
        .trim()
        .replace(/^vox-mens-/i, "")
        .replace(/^qwen3(?:\.8|\.5)?-/i, "");
      return SIZES.find((s) => s.toLowerCase() === cleaned.toLowerCase()) || "0.8B";
    }

    function syncUrlQueryParams(size, tab) {
      try {
        const url = new URL(window.location.href);
        if (size) url.searchParams.set("size", size);
        if (tab) url.searchParams.set("tab", tab);
        window.history.replaceState({}, "", url.toString());
      } catch {}
    }

    // Wire UI Events
    el("provider-endpoint-input").addEventListener("change", (e) => {
      const val = String(e.target.value || "").trim();
      if (val.startsWith("hf_")) {
        state.hfToken = val;
        try { sessionStorage.setItem(HF_TOKEN_SESSION_KEY, val); } catch {}
      }
    });
    el("size-select").addEventListener("change", (e) => {
      syncUrlQueryParams(e.target.value, null);
      selectSize(e.target.value);
    });
    el("filter-verdict").addEventListener("change", () => {
      const b = state.rungCache[state.activeSize];
      if (b) renderSampleList(b);
    });
    el("sample-select").addEventListener("change", renderSelectedSample);
    el("tab-btn-evidence").addEventListener("click", () => {
      el("tab-btn-evidence").classList.add("active");
      el("tab-btn-webgpu").classList.remove("active");
      el("tab-evidence").classList.remove("hidden");
      el("tab-webgpu").classList.add("hidden");
      syncUrlQueryParams(state.activeSize, "evidence");
    });
    el("tab-btn-webgpu").addEventListener("click", () => {
      el("tab-btn-webgpu").classList.add("active");
      el("tab-btn-evidence").classList.remove("active");
      el("tab-webgpu").classList.remove("hidden");
      el("tab-evidence").classList.add("hidden");
      syncUrlQueryParams(state.activeSize, "webgpu");
    });
    el("copy-to-webgpu-btn").addEventListener("click", () => {
      const idx = Number(el("sample-select").value || 0);
      const item = state.filteredSamples[idx];
      if (item && item.promptText) {
        el("user-prompt-input").value = item.promptText;
      }
      el("tab-btn-webgpu").click();
    });
    el("inspect-safetensors-btn").addEventListener("click", inspectSafetensorsHeader);
    el("run-webgpu-btn").addEventListener("click", runWebGpuSideBySide);

    // Boot with URL deep-link parameter support (?size=4B&tab=webgpu&provider=hf-router)
    const savedTok = getSessionHfToken();
    if (savedTok && !el("provider-endpoint-input").value) {
      el("provider-endpoint-input").value = savedTok;
    }
    const bootParams = new URLSearchParams(window.location.search);
    const initialSize = resolveSizeParam(bootParams.get("size") || bootParams.get("model") || "0.8B");
    const reqProvider = bootParams.get("provider");
    if (reqProvider && ["auto", "webgpu", "hf-router", "local-serve"].includes(reqProvider)) {
      el("inference-provider-select").value = reqProvider;
    }
    if (bootParams.get("tab") === "webgpu") {
      el("tab-btn-webgpu").click();
    }
    checkWebGPU();
    loadLadderIndex();
    selectSize(initialSize);
  </script>
</body>
</html>
