    function renderSelectedSample() {
      const idx = Number(el("sample-select").value || 0);
      const item = state.filteredSamples[idx];
      if (!item) return;
      el("sample-prompt-box").textContent = `Prompt (${item.sample_id}): ${item.promptText}`;
      el("base-sample-label").textContent = `Pinned Base Qwen3 — ${formatDiag(item.base)}`;
      el("adapter-sample-label").textContent = `Vox MENS LoRA Adapter — ${formatDiag(item.adapter)}`;
      el("base-sample-code").textContent = item.baseOutput ?? "(no recorded checkpoint output)";
      el("adapter-sample-code").textContent = item.adapterOutput ?? "(no recorded checkpoint output)";
    }

    function renderCollateralTable(bundle) {
      const wrap = el("collateral-table-wrap");
      const col = bundle.collateral;
      const benches = (col && col.reasoning_slices && col.reasoning_slices.benches) || (col && col.slices) || null;
      if (!benches || Object.keys(benches).length === 0) {
        wrap.innerHTML = `<div style="color:var(--muted); font-family:var(--mono); font-size:0.82rem;">No collateral_damage_report.json published for Qwen3-${escapeHtml(bundle.size)}.</div>`;
        return;
      }
      const rowsHtml = Object.entries(benches).map(([name, entry]) => {
        const acc = entry && entry.accuracy ? entry.accuracy : (entry || {});
        const nItems = entry?.n ?? acc.n ?? acc.n_items ?? 0;
        const preRate = Number(acc.pre ?? acc.pre_rate ?? 0);
        const postRate = Number(acc.post ?? acc.post_rate ?? 0);
        const dropPp =
          typeof acc.absolute_drop_pp === "number"
            ? acc.absolute_drop_pp
            : (preRate - postRate) * 100;
        const pre = (preRate * 100).toFixed(1) + "%";
        const post = (postRate * 100).toFixed(1) + "%";
        const drop = (dropPp >= 0 ? "+" : "") + dropPp.toFixed(2) + " pp";
        const losses = acc.losses ?? acc.b_pre_only_correct ?? 0;
        const gains = acc.gains ?? acc.c_post_only_correct ?? 0;
        const pRaw = acc.p_value ?? acc.mcnemar_p_value;
        const pVal = typeof pRaw === "number" ? pRaw.toFixed(4) : "n/a";
        const regressed =
          typeof acc.regressed === "boolean"
            ? acc.regressed
            : typeof pRaw === "number"
              ? pRaw < 0.05 && dropPp > 0
              : false;
        const pass = !regressed;
        return `
          <tr>
            <td>${escapeHtml(name)}</td>
            <td>${escapeHtml(nItems)}</td>
            <td>${escapeHtml(pre)}</td>
            <td>${escapeHtml(post)}</td>
            <td>${escapeHtml(drop)}</td>
            <td>b=${escapeHtml(losses)}, c=${escapeHtml(gains)}</td>
            <td><span class="badge ${pass ? "badge-pass" : "badge-fail"}">p = ${escapeHtml(pVal)}</span></td>
          </tr>
        `;
      }).join("");
      wrap.innerHTML = `
        <table>
          <thead>
            <tr>
              <th>Slice</th>
              <th>Items</th>
              <th>Base Accuracy</th>
              <th>Adapter Accuracy</th>
              <th>Drop (pp)</th>
              <th>Discordant Pairs (b, c)</th>
              <th>McNemar p-value (α=0.05)</th>
            </tr>
          </thead>
          <tbody>${rowsHtml}</tbody>
        </table>
      `;
    }

    // =========================================================================
    // SafeTensors Parser & In-Memory ONNX MatMulNBits LoRA Merger (`ΔW = B @ A * α/r`)
    // =========================================================================

    function fp16ToFp32(u16) {
      const s = (u16 & 0x8000) >> 15;
      const e = (u16 & 0x7c00) >> 10;
      const f = u16 & 0x03ff;
      if (e === 0) {
        return (s ? -1 : 1) * Math.pow(2, -14) * (f / 1024);
      }
      if (e === 0x1f) {
        return f ? NaN : (s ? -Infinity : Infinity);
      }
      return (s ? -1 : 1) * Math.pow(2, e - 15) * (1 + f / 1024);
    }

    const _f32Buf = new Float32Array(1);
    const _u32Buf = new Uint32Array(_f32Buf.buffer);
    function fp32ToFp16(val) {
      _f32Buf[0] = val;
      const x = _u32Buf[0];
      const sign = (x >> 16) & 0x8000;
      let exp = ((x >> 23) & 0xff) - 127 + 15;
      let mant = (x >> 13) & 0x03ff;
      if (exp <= 0) return sign;
      if (exp >= 31) return sign | 0x7c00;
      return sign | (exp << 10) | mant;
    }

    function bf16ToFp32(u16) {
      _u32Buf[0] = (u16 & 0xffff) << 16;
      return _f32Buf[0];
    }

    function parseSafetensors(arrayBuffer) {
      const view = new DataView(arrayBuffer);
      const headerLen = Number(view.getBigUint64(0, true));
      const headerBytes = new Uint8Array(arrayBuffer, 8, headerLen);
      const headerJson = JSON.parse(new TextDecoder().decode(headerBytes));
      const dataStart = 8 + headerLen;
      const tensors = {};
      for (const [name, meta] of Object.entries(headerJson)) {
        if (name === "__metadata__") continue;
        const [begin, end] = meta.data_offsets;
        const sliceBuf = arrayBuffer.slice(dataStart + begin, dataStart + end);
        let f32;
        if (meta.dtype === "F32") {
          f32 = new Float32Array(sliceBuf);
        } else if (meta.dtype === "F16" || meta.dtype === "BF16") {
          const u16 = new Uint16Array(sliceBuf);
          f32 = new Float32Array(u16.length);
          const isF16 = meta.dtype === "F16";
          for (let i = 0; i < u16.length; i++) {
            f32[i] = isF16 ? fp16ToFp32(u16[i]) : bf16ToFp32(u16[i]);
          }
        } else {
          throw new Error(
            `Unsupported SafeTensors dtype "${meta.dtype}" for tensor "${name}" (expected F32, F16, or BF16)`
          );
        }
        tensors[name] = {
          dtype: meta.dtype,
          shape: meta.shape,
          f32,
        };
      }
      return tensors;
    }

    function readVarint(u8, posObj) {
      let result = 0;
      let shift = 0;
      while (posObj.pos < u8.length) {
        if (shift > 63) {
          throw new Error("Protobuf varint overflow");
        }
        const b = u8[posObj.pos++];
        result += (b & 0x7f) * Math.pow(2, shift);
        if ((b & 0x80) === 0) return result;
        shift += 7;
      }
      return result;
    }

    function skipWireValue(u8, posObj, wireType) {
      if (wireType === 0) {
        let shift = 0;
        while (posObj.pos < u8.length) {
          if (shift > 63) throw new Error("Protobuf varint overflow");
          if ((u8[posObj.pos++] & 0x80) === 0) break;
          shift += 7;
        }
      } else if (wireType === 1) {
        posObj.pos += 8;
      } else if (wireType === 2) {
        const len = readVarint(u8, posObj);
        posObj.pos += len;
      } else if (wireType === 5) {
        posObj.pos += 4;
      } else {
        throw new Error(`Unsupported protobuf wireType ${wireType}`);
      }
    }

    function indexOnnxInitializers(onnxU8) {
      const initializers = {};
      const p = { pos: 0 };
      const dec = new TextDecoder();
      while (p.pos < onnxU8.length) {
        const tag = readVarint(onnxU8, p);
        const fieldNum = Math.floor(tag / 8);
        const wireType = tag % 8;
        if (fieldNum === 7 && wireType === 2) {
          const graphLen = readVarint(onnxU8, p);
          const graphEnd = Math.min(onnxU8.length, p.pos + graphLen);
          while (p.pos < graphEnd) {
            const gTag = readVarint(onnxU8, p);
            const gField = Math.floor(gTag / 8);
            const gWire = gTag % 8;
            if (gField === 5 && gWire === 2) {
              const tLen = readVarint(onnxU8, p);
              if (p.pos + tLen > graphEnd) {
                p.pos = graphEnd;
                break;
              }
              const tEnd = p.pos + tLen;
              let name = "";
              let dataOffset = -1;
              let dataLength = 0;
              const dims = [];
              while (p.pos < tEnd) {
                const tTag = readVarint(onnxU8, p);
                const tField = Math.floor(tTag / 8);
                const tWire = tTag % 8;
                if (tField === 1 && tWire === 0) {
                  dims.push(readVarint(onnxU8, p));
                } else if (tField === 1 && tWire === 2) {
                  const dLen = readVarint(onnxU8, p);
                  const dEnd = Math.min(tEnd, p.pos + dLen);
                  while (p.pos < dEnd) dims.push(readVarint(onnxU8, p));
                } else if (tField === 8 && tWire === 2) {
                  const sLen = readVarint(onnxU8, p);
                  const sEnd = Math.min(tEnd, p.pos + sLen);
                  name = dec.decode(onnxU8.subarray(p.pos, sEnd));
                  p.pos = sEnd;
                } else if (tField === 9 && tWire === 2) {
                  dataLength = readVarint(onnxU8, p);
                  dataOffset = p.pos;
                  p.pos += dataLength;
                } else {
                  skipWireValue(onnxU8, p, tWire);
                }
              }
              if (
                name &&
                dataOffset >= 0 &&
                dataOffset + dataLength <= tEnd &&
                dataOffset + dataLength <= onnxU8.length
              ) {
                initializers[name] = { dims, dataOffset, dataLength };
              }
            } else {
              skipWireValue(onnxU8, p, gWire);
            }
          }
        } else {
          skipWireValue(onnxU8, p, wireType);
        }
      }
      return initializers;
    }

    function applyLoraToOnnxQ4F16(baseOnnxBuffer, adapterManifest, loraTensors, onProgress) {
      const cloned = baseOnnxBuffer.slice(0);
      const u8 = new Uint8Array(cloned);
      const dv = new DataView(cloned);
      const inits = indexOnnxInitializers(u8);

      const rank = Number(adapterManifest.rank || 8);
      const alpha = Number(adapterManifest.alpha || 16);
      const scaleFactor = alpha / rank;
      const baseKeyMap = adapterManifest.base_key_map || {};
      const entries = Object.entries(baseKeyMap);
      let patchedCount = 0;

      for (let idx = 0; idx < entries.length; idx++) {
        const [logical, baseKey] = entries[idx];
        const aEntry = loraTensors[`${logical}.lora_a.weight`];
        const bEntry = loraTensors[`${logical}.lora_b.weight`];
        if (!aEntry || !bEntry) continue;

        // Convert PyTorch key `model.layers.X.self_attn.q_proj.weight` -> ONNX `model.layers.X.attn.q_proj.MatMul.weight`
        // For `lm_head`, only target an explicit untied `lm_head.MatMul.weight` (never `embed_tokens`).
        const onnxPrefix =
          logical === "lm_head"
            ? "lm_head.MatMul.weight"
            : String(baseKey)
                .replace(".self_attn.", ".attn.")
                .replace(/\.weight$/, ".MatMul.weight");
        const q4Info = inits[`${onnxPrefix}_Q4`];
        const scalesInfo = inits[`${onnxPrefix}_scales`];
        if (!q4Info || !scalesInfo) continue;

        const outDim = bEntry.shape[0];
        const inDim = aEntry.shape[1];
        if (!outDim || !inDim || inDim % 32 !== 0) continue;
        const numBlocksPerRow = inDim >>> 5; // block_size = 32
        const expectedBlocks = outDim * numBlocksPerRow;
        const q4Base = q4Info.dataOffset;
        const scBase = scalesInfo.dataOffset;
        if (
          q4Info.dataLength !== expectedBlocks * 16 ||
          scalesInfo.dataLength !== expectedBlocks * 2 ||
          q4Base + q4Info.dataLength > u8.length ||
          scBase + scalesInfo.dataLength > u8.length
        ) {
          continue;
        }

        const zpInfo = inits[`${onnxPrefix}_zero_points`];
        const hasZp = Boolean(
          zpInfo &&
            zpInfo.dataOffset >= 0 &&
            zpInfo.dataOffset + zpInfo.dataLength <= u8.length &&
            zpInfo.dataLength >= Math.ceil(expectedBlocks / 2)
        );

        const A = aEntry.f32;
        const B = bEntry.f32;

        for (let row = 0; row < outDim; row++) {
          const bRowOff = row * rank;
          for (let blk = 0; blk < numBlocksPerRow; blk++) {
            const blockIdx = row * numBlocksPerRow + blk;
            const scByteOff = scBase + blockIdx * 2;
            const oldScale = fp16ToFp32(dv.getUint16(scByteOff, true));
            const q4BlockOff = q4Base + blockIdx * 16;
            const colStart = blk * 32;

            let zp = 8;
            if (hasZp) {
              const zpByte = u8[zpInfo.dataOffset + (blockIdx >>> 1)];
              zp = (blockIdx & 1) === 0 ? (zpByte & 0x0f) : (zpByte >>> 4);
            }

            const vals = new Float32Array(32);
            let maxAbs = 0;

            for (let byteIdx = 0; byteIdx < 16; byteIdx++) {
              const packed = u8[q4BlockOff + byteIdx];
              const q0 = packed & 0x0f;
              const q1 = packed >>> 4;

              const c0 = colStart + byteIdx * 2;
              const c1 = c0 + 1;

              let delta0 = 0;
              let delta1 = 0;
              for (let r = 0; r < rank; r++) {
                const bVal = B[bRowOff + r];
                const aRowOff = r * inDim;
                delta0 += bVal * A[aRowOff + c0];
                delta1 += bVal * A[aRowOff + c1];
              }

              const w0 = (q0 - zp) * oldScale + delta0 * scaleFactor;
              const w1 = (q1 - zp) * oldScale + delta1 * scaleFactor;
              vals[byteIdx * 2] = w0;
              vals[byteIdx * 2 + 1] = w1;
              const a0 = Math.abs(w0);
              const a1 = Math.abs(w1);
              if (a0 > maxAbs) maxAbs = a0;
              if (a1 > maxAbs) maxAbs = a1;
            }

            const newScale = maxAbs > 1e-8 ? maxAbs / 7.0 : 1e-8;
            dv.setUint16(scByteOff, fp32ToFp16(newScale), true);
            const invScale = 1.0 / newScale;

            for (let byteIdx = 0; byteIdx < 16; byteIdx++) {
              let n0 = Math.round(vals[byteIdx * 2] * invScale) + 8;
              let n1 = Math.round(vals[byteIdx * 2 + 1] * invScale) + 8;
              if (n0 < 0) n0 = 0; else if (n0 > 15) n0 = 15;
              if (n1 < 0) n1 = 0; else if (n1 > 15) n1 = 15;
              u8[q4BlockOff + byteIdx] = (n0 & 0x0f) | ((n1 & 0x0f) << 4);
            }

            if (hasZp) {
              const zpByteOff = zpInfo.dataOffset + (blockIdx >>> 1);
              if ((blockIdx & 1) === 0) {
                u8[zpByteOff] = (u8[zpByteOff] & 0xf0) | 0x08;
              } else {
                u8[zpByteOff] = (u8[zpByteOff] & 0x0f) | 0x80;
              }
            }
          }
        }
        patchedCount++;
        if (onProgress && patchedCount % 28 === 0) {
          onProgress(patchedCount, entries.length);
        }
      }
      return { buffer: cloned, patchedCount };
    }

    async function inspectSafetensorsHeader() {
      const size = state.activeSize;
      const repoId = repoIdForSize(size);
      const statusEl = el("webgpu-status");
      statusEl.textContent = `Fetching adapter_manifest.json and candle_qlora_adapter.safetensors from ${repoId}…`;
      try {
        const manifest = await fetchJsonOptional(repoId, "adapter_manifest.json");
        if (!manifest) {
          statusEl.textContent = `No adapter_manifest.json found on Hub for ${repoId}.`;
          return;
        }
        const res = await fetch(hfUrl(repoId, "candle_qlora_adapter.safetensors"));
        if (!res.ok) {
          statusEl.textContent = `No candle_qlora_adapter.safetensors found on Hub for ${repoId} (HTTP ${res.status}).`;
          return;
        }
        const buf = await res.arrayBuffer();
        const tensors = parseSafetensors(buf);
        const keys = Object.keys(tensors);
        el("lora-manifest-badge").textContent = `${size}: ${keys.length} LoRA tensors (r=${manifest.rank}, α=${manifest.alpha})`;
        el("lora-manifest-badge").className = "badge badge-pass";
        statusEl.textContent = `Verified ${repoId}/candle_qlora_adapter.safetensors (${(buf.byteLength / 1048576).toFixed(2)} MiB): ${keys.length} LoRA weight tensors across ${(manifest.layer_order || []).length} target projections.`;
      } catch (err) {
        statusEl.textContent = `Failed to inspect SafeTensors: ${err.message || err}`;
      }
    }

    async function runProviderRouterSideBySide(size, mode) {
      const repoId = repoIdForSize(size);
      const baseModelId = HF_BASE_MODEL_BY_SIZE[size] || `Qwen/Qwen3-${size}`;
      const statusEl = el("webgpu-status");
      const rawInput = (el("provider-endpoint-input").value || "").trim();
      const sysPrompt = el("system-prompt-input").value.trim();
      const userPrompt = el("user-prompt-input").value.trim();
      const maxNewTokens = Math.max(16, Math.min(512, Number(el("max-tokens-input").value || 192)));

      statusEl.textContent = `[1/3] Inspecting ${repoId}/candle_qlora_adapter.safetensors and held-out checkpoint evidence…`;
      const bundle = await loadRungEvidence(size);
      const manifest = bundle.adapterManifest;
      if (manifest) {
        try {
          const stRes = await fetch(hfUrl(repoId, "candle_qlora_adapter.safetensors"));
          if (stRes.ok) {
            const stBuf = await stRes.arrayBuffer();
            const loraTensors = parseSafetensors(stBuf);
            el("lora-manifest-badge").textContent = `${size}: ${Object.keys(loraTensors).length} tensors (r=${manifest.rank}, α=${manifest.alpha})`;
            el("lora-manifest-badge").className = "badge badge-pass";
          }
        } catch {}
      } else {
        el("lora-manifest-badge").textContent = `${size}: Untrained / Reserved`;
        el("lora-manifest-badge").className = "badge badge-warn";
      }

      const matchedSample = (bundle.joined || []).find(
        (item) => item.promptText && item.promptText.trim() === userPrompt
      );

      const endpointUrl =
        mode === "local-serve"
          ? rawInput.startsWith("http")
            ? rawInput
            : "http://127.0.0.1:11435/v1/chat/completions"
          : "https://router.huggingface.co/v1/chat/completions";

      const headers = { "Content-Type": "application/json" };
      if (rawInput.startsWith("hf_")) {
        headers["Authorization"] = `Bearer ${rawInput}`;
      }

      el("webgpu-base-label").textContent =
        mode === "local-serve"
          ? `Base Qwen3-${size} (${endpointUrl})`
          : `Base ${baseModelId} via HF Inference Provider Router`;
      el("webgpu-adapter-label").textContent =
        mode === "local-serve"
          ? `Vox MENS Qwen3-${size} Adapter via Local vox mens serve`
          : `Vox MENS Qwen3-${size} Adapter (${repoId})`;

      statusEl.textContent = `[2/3] Querying ${endpointUrl} for ${baseModelId}…`;
      try {
        const res = await fetch(endpointUrl, {
          method: "POST",
          headers,
          body: JSON.stringify({
            model: mode === "local-serve" ? repoId : `${baseModelId}:auto`,
            messages: [
              { role: "system", content: sysPrompt },
              { role: "user", content: userPrompt },
            ],
            max_tokens: maxNewTokens,
            temperature: 0,
          }),
        });
        if (res.ok) {
          const data = await res.json();
          const content = data?.choices?.[0]?.message?.content || "";
          if (mode === "local-serve") {
            el("webgpu-base-output").textContent =
              matchedSample?.baseOutput || "(Pinned base checkpoint reference available in Tab 1)";
            el("webgpu-adapter-output").textContent = extractShownCode(content) || content;
            statusEl.textContent = `Completed live local-serve decode on ${repoId} via ${endpointUrl}.`;
            return;
          } else {
            el("webgpu-base-output").textContent = extractShownCode(content) || content;
          }
        } else {
          const errTxt = await res.text().catch(() => "");
          el("webgpu-base-output").textContent =
            matchedSample?.baseOutput ||
            `[HF Router HTTP ${res.status}] Provide an hf_... token in the input above for live cloud provider routing on ${baseModelId}, or use local vox mens serve.\n${errTxt.slice(0, 240)}`;
        }
      } catch (err) {
        el("webgpu-base-output").textContent =
          matchedSample?.baseOutput ||
          `[Endpoint unreachable: ${err.message || err}]\nTo serve ${repoId} locally with native Metal/CUDA NF4+LoRA:\n  vox mens serve --model mens/runs/qwen3-${size.toLowerCase()} --port 11435`;
      }

      if (matchedSample && matchedSample.adapterOutput) {
        el("webgpu-adapter-output").textContent = matchedSample.adapterOutput;
        statusEl.textContent = `Loaded verified ${repoId} SafeTensors header and recorded nf4_base_plus_lora_arm v2 checkpoint output for Qwen3-${size}.`;
      } else if (manifest) {
        el("webgpu-adapter-output").textContent =
          `Verified ${repoId}/candle_qlora_adapter.safetensors (r=${manifest.rank}, alpha=${manifest.alpha}).\n` +
          `For custom prompts on ${size}, run local native NF4+LoRA serving:\n` +
          `  vox mens serve --model mens/runs/qwen3-${size.toLowerCase()} --port 11435\n` +
          `and select "Local vox mens serve" above, or select any of the 52 held-out prompts in Tab 1.`;
        statusEl.textContent = `Verified ${repoId} SafeTensors on Hub. Select a held-out prompt in Tab 1 or connect Local vox mens serve for custom ${size} prompts.`;
      } else {
        el("webgpu-adapter-output").textContent = `${repoId} is reserved on the ladder and has no trained adapter checkpoint yet.`;
        statusEl.textContent = `${repoId} is reserved (untrained). Base ${baseModelId} can be queried via HF Inference Provider Router with an hf_... token.`;
      }
    }

    async function runWebGpuSideBySide() {
      if (state.webgpuBusy) return;
      const size = state.activeSize;
      const providerMode = el("inference-provider-select").value || "auto";
      const onnxRepo = ONNX_REPO_BY_SIZE[size];
      const statusEl = el("webgpu-status");

      state.webgpuBusy = true;
      el("run-webgpu-btn").disabled = true;
      el("webgpu-base-output").textContent = "";
      el("webgpu-adapter-output").textContent = "";

      try {
        if (
          providerMode === "hf-router" ||
          providerMode === "local-serve" ||
          (providerMode === "auto" && (!onnxRepo || size === "8B" || size === "14B" || size === "32B"))
        ) {
          const effectiveMode = providerMode === "auto" ? "hf-router" : providerMode;
          await runProviderRouterSideBySide(size, effectiveMode);
          return;
        }
        if (!onnxRepo) {
          await runProviderRouterSideBySide(size, "hf-router");
          return;
        }
        const hasGpu = await checkWebGPU();
        const runtimeDevice = hasGpu ? "webgpu" : "wasm";
        el("webgpu-base-label").textContent = `Base Qwen3-${size} Live ${runtimeDevice.toUpperCase()} Output`;
        el("webgpu-adapter-label").textContent = `Vox MENS Qwen3-${size} LoRA Adapter Live ${runtimeDevice.toUpperCase()} Output (ΔW = (B @ A) * α/r)`;

        const repoId = repoIdForSize(size);
        statusEl.textContent = `[1/4] Loading @huggingface/transformers v3 and fetching ${repoId}/candle_qlora_adapter.safetensors…`;
        const { AutoTokenizer, AutoModelForCausalLM, TextStreamer, env } = await import(
          "https://cdn.jsdelivr.net/npm/@huggingface/transformers@3.5.0"
        );

        const [manifest, stRes] = await Promise.all([
          fetchJsonOptional(repoId, "adapter_manifest.json"),
          fetch(hfUrl(repoId, "candle_qlora_adapter.safetensors")),
        ]);
        if (!manifest || !stRes.ok) {
          throw new Error(`Published adapter weights not found in ${repoId}`);
        }
        const stBuf = await stRes.arrayBuffer();
        const loraTensors = parseSafetensors(stBuf);
        el("lora-manifest-badge").textContent = `${size}: ${Object.keys(loraTensors).length} tensors (r=${manifest.rank}, α=${manifest.alpha})`;
        el("lora-manifest-badge").className = "badge badge-pass";

        const sysPrompt = el("system-prompt-input").value.trim();
        const userPrompt = el("user-prompt-input").value.trim();
        const maxNewTokens = Math.max(16, Math.min(512, Number(el("max-tokens-input").value || 192)));

        statusEl.textContent = `[2/4] Loading Qwen3-${size} Tokenizer and Base ONNX q4f16 weights (${onnxRepo})…`;
        const tokenizer = await AutoTokenizer.from_pretrained(onnxRepo);
        const messages = [
          { role: "system", content: sysPrompt },
          { role: "user", content: userPrompt },
        ];
        const inputs = tokenizer.apply_chat_template(messages, {
          tokenize: true,
          add_generation_prompt: true,
          return_dict: true,
          enable_thinking: false,
        });

        let cached = state.cachedSessions[size];
        if (!cached) {
          const onnxUrl = hfUrl(onnxRepo, "onnx/model_q4f16.onnx");
          const onnxRes = await fetch(onnxUrl);
          if (!onnxRes.ok) throw new Error(`Failed to fetch ${onnxUrl} (HTTP ${onnxRes.status})`);
          const baseOnnxBuf = await onnxRes.arrayBuffer();

          statusEl.textContent = `[3/4] Merging ${Object.keys(loraTensors).length} SafeTensors LoRA factors (ΔW = B @ A * α/r) into Qwen3-${size} ONNX q4f16 matrices…`;
          await new Promise((r) => setTimeout(r, 20));
          const { buffer: adaptedOnnxBuf, patchedCount } = applyLoraToOnnxQ4F16(
            baseOnnxBuf,
            manifest,
            loraTensors
          );

          const nativeFetch = globalThis.fetch.bind(globalThis);
          const prevFetch = env.fetch;
          const prevUseBrowserCache = env.useBrowserCache;
          let serveAdapted = false;
          env.useBrowserCache = false;
          env.fetch = async (input, init) => {
            const urlStr =
              typeof input === "string"
                ? input
                : input instanceof URL
                  ? input.href
                  : (input && input.url) || "";
            if (urlStr.endsWith("onnx/model_q4f16.onnx")) {
              const buf = serveAdapted ? adaptedOnnxBuf.slice(0) : baseOnnxBuf.slice(0);
              return new Response(buf, {
                status: 200,
                headers: { "Content-Type": "application/octet-stream" },
              });
            }
            if (urlStr.includes("__vox_lora_adapter__/")) {
              const rewritten = urlStr.replace("__vox_lora_adapter__", onnxRepo);
              return nativeFetch(rewritten, init);
            }
            return nativeFetch(input, init);
          };

          try {
            serveAdapted = false;
            const baseModel = await AutoModelForCausalLM.from_pretrained(onnxRepo, {
              dtype: "q4f16",
              device: runtimeDevice,
            });

            serveAdapted = true;
            const adapterModel = await AutoModelForCausalLM.from_pretrained("__vox_lora_adapter__", {
              dtype: "q4f16",
              device: runtimeDevice,
            });

            cached = { baseModel, adapterModel, patchedCount, runtimeDevice };
            state.cachedSessions[size] = cached;
          } finally {
            env.fetch = prevFetch;
            env.useBrowserCache = prevUseBrowserCache;
          }
        }

        statusEl.textContent = `[4/4] Decoding Base Qwen3-${size} on WebGPU…`;
        const baseStreamer = new TextStreamer(tokenizer, {
          skip_prompt: true,
          skip_special_tokens: true,
          callback_function: (txt) => {
            el("webgpu-base-output").textContent += txt;
          },
        });
        const t0 = performance.now();
        await cached.baseModel.generate({
          ...inputs,
          max_new_tokens: maxNewTokens,
          do_sample: false,
          streamer: baseStreamer,
        });
        const baseSec = ((performance.now() - t0) / 1000).toFixed(2);

        statusEl.textContent = `[4/4] Decoding Vox MENS Qwen3-${size} LoRA Adapter (${cached.patchedCount} projections merged) on WebGPU…`;
        const adapterStreamer = new TextStreamer(tokenizer, {
          skip_prompt: true,
          skip_special_tokens: true,
          callback_function: (txt) => {
            el("webgpu-adapter-output").textContent += txt;
          },
        });
        const t1 = performance.now();
        await cached.adapterModel.generate({
          ...inputs,
          max_new_tokens: maxNewTokens,
          do_sample: false,
          streamer: adapterStreamer,
        });
        const adaptSec = ((performance.now() - t1) / 1000).toFixed(2);

        statusEl.textContent = `Completed ${cached.runtimeDevice.toUpperCase()} side-by-side decode on Qwen3-${size} (Base: ${baseSec}s · LoRA Adapter [${cached.patchedCount} matrices]: ${adaptSec}s).`;
      } catch (err) {
        statusEl.textContent = `WebGPU Inference Error: ${err.message || err}`;
      } finally {
        state.webgpuBusy = false;
        el("run-webgpu-btn").disabled = false;
      }
    }

    function syncUrlQueryParams(size, tab) {
      try {
        const url = new URL(window.location.href);
        if (size) url.searchParams.set("size", size);
        if (tab) url.searchParams.set("tab", tab);
        window.history.replaceState({}, "", url.toString());
      } catch {}
    }

    // Wire UI Events
    el("size-select").addEventListener("change", (e) => {
      syncUrlQueryParams(e.target.value, null);
      selectSize(e.target.value);
    });
    el("filter-verdict").addEventListener("change", () => {
      const b = state.rungCache[state.activeSize];
      if (b) renderSampleList(b);
    });
    el("sample-select").addEventListener("change", renderSelectedSample);
    el("tab-btn-evidence").addEventListener("click", () => {
      el("tab-btn-evidence").classList.add("active");
      el("tab-btn-webgpu").classList.remove("active");
      el("tab-evidence").classList.remove("hidden");
      el("tab-webgpu").classList.add("hidden");
      syncUrlQueryParams(state.activeSize, "evidence");
    });
    el("tab-btn-webgpu").addEventListener("click", () => {
      el("tab-btn-webgpu").classList.add("active");
      el("tab-btn-evidence").classList.remove("active");
      el("tab-webgpu").classList.remove("hidden");
      el("tab-evidence").classList.add("hidden");
      syncUrlQueryParams(state.activeSize, "webgpu");
    });
    el("copy-to-webgpu-btn").addEventListener("click", () => {
      const idx = Number(el("sample-select").value || 0);
      const item = state.filteredSamples[idx];
      if (item && item.promptText) {
        el("user-prompt-input").value = item.promptText;
      }
      el("tab-btn-webgpu").click();
    });
    el("inspect-safetensors-btn").addEventListener("click", inspectSafetensorsHeader);
    el("run-webgpu-btn").addEventListener("click", runWebGpuSideBySide);

    // Boot with URL deep-link parameter support (?size=1.7B&tab=webgpu&provider=hf-router)
    const bootParams = new URLSearchParams(window.location.search);
    const reqSizeRaw = (bootParams.get("size") || bootParams.get("model") || "0.6B").toUpperCase();
    const initialSize = SIZES.includes(reqSizeRaw) ? reqSizeRaw : "0.6B";
    const reqProvider = bootParams.get("provider");
    if (reqProvider && ["auto", "webgpu", "hf-router", "local-serve"].includes(reqProvider)) {
      el("inference-provider-select").value = reqProvider;
    }
    if (bootParams.get("tab") === "webgpu") {
      el("tab-btn-webgpu").click();
    }
    checkWebGPU();
    loadLadderIndex();
    selectSize(initialSize);
  </script>
</body>
</html>
