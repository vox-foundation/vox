{
  "description": "Workspace health and dependency governance policy (2026-04-20)",
  "tiers": {
    "foundational": {
      "limit_direct_deps": 20,
      "allow_ml": false,
      "description": "Primitives, config, and core language logic. Must remain extremely lightweight.",
      "patterns": ["core", "primitive", "config", "secrets", "bounded-fs"]
    },
    "runtime": {
      "limit_direct_deps": 40,
      "allow_ml": false,
      "description": "Middle-layer frameworks and execution engines.",
      "patterns": ["runtime", "orchestrator", "populi"]
    },
    "leaf": {
      "limit_direct_deps": 100,
      "allow_ml": true,
      "description": "End-user binaries and CLI entry points.",
      "patterns": ["vox-cli", "vox-mens", "vox-oratio"]
    }
  },
  "crate_ceilings": {
    "vox-actor-runtime": 45,
    "vox-cli": 137,
    "vox-cli-core": 24,
    "vox-compiler": 52,
    "vox-db": 34,
    "vox-gamify": 31,
    "vox-ml-cli": 61,
    "vox-orchestrator": 85,
    "vox-orchestrator-mcp": 101,
    "vox-populi": 82,
    "vox-secrets": 25
  },
  "regressions": {
    "threshold_ratio": 1.25,
    "min_elapsed_ms": 100,
    "description": "Threshold for flagging build-time regressions relative to the historical mean."
  }
}
