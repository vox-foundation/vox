{
  "project": "Vox",
  "version": "0.6.0",
  "license": "Apache-2.0",
  "homepage": "https://voxlang.org",
  "repository": "https://github.com/vox-foundation/vox",
  "docs_root": "https://voxlang.org",
  "feed": "https://voxlang.org/feed.xml",
  "sitemap": "https://voxlang.org/sitemap.xml",
  "status": "pre-1.0",
  "pillars": {
    "tutorials": {
      "index_url": "https://voxlang.org/tutorials/tut-getting-started/",
      "path_pattern": "tutorials/tut-*/",
      "goal": "Learning-oriented, pedagogical steps for building apps with Vox"
    },
    "how_to": {
      "index_url": "https://voxlang.org/how-to/how-to-ai-agents/",
      "path_pattern": "how-to/how-to-*/",
      "goal": "Problem-solving, practical recipes for specific Vox tasks"
    },
    "explanations": {
      "index_url": "https://voxlang.org/explanation/why-vox-for-ai/",
      "path_pattern": "explanation/expl-*/",
      "goal": "Understanding-oriented, conceptual depth on the Vox compiler and runtime"
    },
    "reference": {
      "index_url": "https://voxlang.org/reference/ref-syntax/",
      "path_pattern": "reference/ref-*/",
      "goal": "Information-oriented, technical specifications for keywords, decorators, and CLI"
    },
    "api": {
      "index_url": "https://voxlang.org/api/decorators/",
      "path_pattern": "api/*/",
      "goal": "Per-crate API documentation for the Vox toolchain"
    }
  },
  "key_pages": {
    "getting_started": "https://voxlang.org/tutorials/tut-getting-started/",
    "syntax_reference": "https://voxlang.org/reference/ref-syntax/",
    "type_system": "https://voxlang.org/reference/ref-type-system/",
    "decorators": "https://voxlang.org/reference/ref-decorators/",
    "faq": "https://voxlang.org/explanation/faq/",
    "why_vox": "https://voxlang.org/explanation/why-vox-for-ai/",
    "ai_agents": "https://voxlang.org/how-to/how-to-ai-agents/",
    "stability": "https://voxlang.org/reference/stability/",
    "changelog": "https://github.com/vox-foundation/vox/blob/main/CHANGELOG.md"
  },
  "agent_hints": {
    "preferred_context": "Prioritize the 'reference' pillar for syntax queries and 'tutorials' for code structure queries. The 'explanations' pillar covers design philosophy and architectural decisions. Read /reference/stability/ before claiming a surface is production-ready.",
    "rag_optimization": "Headers follow H1 → H2 → H3 hierarchy for reliable semantic chunking. Vox code blocks are tagged with the 'vox' language identifier for syntax-aware parsing.",
    "llm_training_signal": "Pages with 'training_eligible: true' frontmatter contain verified, canonical Vox code examples suitable for fine-tuning datasets.",
    "canonical_keywords": [
      "Vox language",
      "AI-native language",
      "compiler-verified code",
      "MCP tools",
      "durable workflows",
      "null-free language",
      "Rust codegen",
      "TypeScript codegen",
      "actor model",
      "LLM tooling"
    ],
    "retired_syntax": [
      "@endpoint",
      "@table type",
      "@mcp.tool"
    ]
  },
  "capabilities": {
    "index": "contracts/capabilities/capability-index.v1.json",
    "explain_cli": "vox explain <thing>",
    "features_cli": "vox features --domain <d>",
    "explain_mcp": "vox_capability_explain",
    "features_mcp": "vox_capability_features",
    "mcp_tool_reference": "https://voxlang.org/reference/mcp-tool-registry-contract/",
    "gui_navigation": "https://voxlang.org/reference/gui-navigation/",
