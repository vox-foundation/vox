---
import type { CarouselSlide } from '../data/carousels';

interface Props {
  slides: CarouselSlide[];
  /** Unique per instance; used for the section id and ARIA ids. */
  carouselId: string;
  brand: string;
  ariaLabel: string;
  /** Optional line shown under the stage, e.g. a note about sample data. */
  footnote?: string;
  /** Overrides the default data-testid, which is the carousel id plus "-carousel". */
  testId?: string;
}

const { slides, carouselId, brand, ariaLabel, footnote, testId } = Astro.props;
const first = slides[0];
const imgBase = '/assets/axis/hd';
const srcsetFor = (base: string, theme: 'light' | 'dark') =>
  `${imgBase}/${base}-${theme}-1280.webp 1280w, ${imgBase}/${base}-${theme}-2560.webp 2560w`;

// Everything the client script needs, with image paths resolved on the server.
const clientSlides = slides.map((s) => ({
  ...s,
  srcsetLight: s.image ? srcsetFor(s.image.base, 'light') : null,
  srcsetDark: s.image ? srcsetFor(s.image.base, 'dark') : null,
  srcLight: s.image ? `${imgBase}/${s.image.base}-light-1280.webp` : null,
  srcDark: s.image ? `${imgBase}/${s.image.base}-dark-1280.webp` : null,
}));
const panelId = `${carouselId}-panel`;

// Build-time guard (TOUR-HD): every captured slide must ship light and dark variants at both widths.
const hdFiles = Object.keys(import.meta.glob('../../../docs/src/assets/axis/hd/*.webp')).map((p) => p.split('/').pop());
for (const s of slides) {
  if (!s.image) continue;
  for (const theme of ['light', 'dark']) {
    for (const w of [1280, 2560]) {
      const name = `${s.image.base}-${theme}-${w}.webp`;
      if (!hdFiles.includes(name)) {
        throw new Error(`VoxCarousel(${carouselId}): slide "${s.id}" is missing docs/src/assets/axis/hd/${name}`);
      }
    }
  }
}
---

<vox-carousel data-slides={JSON.stringify(clientSlides)}>
  <section
    id={carouselId}
    class="vox-gui-carousel not-content"
    data-testid={testId ?? `${carouselId}-carousel`}
    aria-label={ariaLabel}
    tabindex="0"
  >
    <div class="carousel-header">
      <div class="carousel-topbar">
        <div class="carousel-brand">
          <span class="carousel-brand-label">{brand}</span>
          <span class="carousel-counter" data-carousel-counter>1 / {slides.length}</span>
        </div>

        <div class="carousel-controls">
          <button type="button" class="carousel-theme-btn" data-carousel-theme-toggle aria-pressed="false">
            Captures: Light
          </button>
          <button type="button" class="carousel-nav-btn" data-carousel-prev aria-label="Previous slide">← Prev</button>
          <button type="button" class="carousel-nav-btn" data-carousel-next aria-label="Next slide">Next →</button>
        </div>
      </div>

      <div class="carousel-tabs" role="tablist" aria-label={ariaLabel}>
        {slides.map((s, idx) => (
          <button
            type="button"
            role="tab"
            id={`${carouselId}-tab-${idx}`}
            aria-controls={panelId}
            class={`carousel-tab ${idx === 0 ? 'active' : ''}`}
            aria-selected={idx === 0 ? 'true' : 'false'}
            tabindex={idx === 0 ? 0 : -1}
            data-slide-idx={idx}
          >
            {s.tab}
          </button>
        ))}
      </div>
    </div>

    <div id={panelId} role="tabpanel" aria-labelledby={`${carouselId}-tab-0`}>
      <div class="carousel-stage">
        <img
          data-carousel-img
          src={first.image ? `${imgBase}/${first.image.base}-light-1280.webp` : ''}
          srcset={first.image ? srcsetFor(first.image.base, 'light') : undefined}
          sizes="(min-width: 1100px) 900px, 100vw"
          alt={first.image?.alt ?? ''}
          width="1280"
          height="800"
          loading="lazy"
          decoding="async"
          hidden={!first.image}
        />
        <div class="carousel-code" data-carousel-codewrap hidden={!first.code}>
          <pre class="carousel-code-pre" data-carousel-code tabindex="0">{first.code?.text}</pre>
          <p class="carousel-code-note" data-carousel-codenote>{first.code?.note}</p>
        </div>
      </div>

      <div class="carousel-footer">
        <div class="carousel-meta">
          <span class="carousel-badge" data-carousel-badge>{first.badge}</span>
          <h3 class="carousel-title" data-carousel-title>{first.title}</h3>
          <p class="carousel-desc" data-carousel-what>{first.what}</p>
          <dl class="carousel-facts">
            <div><dt>Why it is built this way</dt><dd data-carousel-why>{first.why}</dd></div>
            <div><dt>For AI-written code</dt><dd data-carousel-ai>{first.ai}</dd></div>
            <div><dt>For the person using it</dt><dd data-carousel-users>{first.users}</dd></div>
          </dl>
        </div>
        <div class="carousel-actions">
          <code class="carousel-cli" data-carousel-cli>{first.cli}</code>
          <a class="carousel-link" data-carousel-link href={first.linkHref}>{first.linkLabel} →</a>
        </div>
      </div>
      {footnote && <p class="carousel-footnote">{footnote}</p>}
    </div>
  </section>
</vox-carousel>

<style>
  .vox-gui-carousel {
    border: 1px solid rgba(71, 85, 105, 0.48);
    border-radius: 0.75rem;
    overflow: hidden;
    margin: 1.15rem 0;
    scroll-margin-top: 4.5rem;
    background: #0b0f19;
    box-shadow: 0 16px 38px rgba(0, 0, 0, 0.42);
    outline: none;
  }

  .vox-gui-carousel:focus-visible {
    box-shadow: 0 0 0 2px #38bdf8, 0 16px 38px rgba(0, 0, 0, 0.42);
  }

  :root[data-theme='light'] .vox-gui-carousel {
    background: #ffffff;
    border-color: #cbd5e1;
    box-shadow: 0 8px 24px rgba(15, 23, 42, 0.08);
  }

  .vox-gui-carousel button {
    margin: 0;
    font-family: inherit;
    line-height: 1;
    box-sizing: border-box;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    white-space: nowrap;
    cursor: pointer;
  }

  .carousel-header {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    padding: 0.65rem 0.85rem;
    background: linear-gradient(180deg, #111726 0%, #0c111d 100%);
    border-bottom: 1px solid rgba(71, 85, 105, 0.38);
  }

  :root[data-theme='light'] .carousel-header {
    background: #f8fafc;
    border-bottom-color: #cbd5e1;
  }

  .carousel-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.65rem;
    flex-wrap: wrap;
  }

