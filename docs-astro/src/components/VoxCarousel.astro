  }

  .carousel-theme-btn {
    height: 28px;
    padding: 0 0.6rem;
    font-size: 0.71rem;
    font-weight: 600;
    border-radius: 0.36rem;
    border: 1px solid rgba(245, 158, 11, 0.48);
