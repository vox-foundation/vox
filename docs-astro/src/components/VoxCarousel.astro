  }

  .carousel-desc {
    margin: 0;
    font-size: 0.86rem;
    line-height: 1.48;
    color: #cbd5e1;
  }

  :root[data-theme='light'] .carousel-desc {
    color: #334155;
  }

  .carousel-actions {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    flex-wrap: wrap;
  }

  .carousel-cli {
    display: inline-flex;
    align-items: center;
    height: 32px;
    padding: 0 0.65rem;
    border-radius: 0.42rem;
    background: #0f172a;
    border: 1px solid rgba(71, 85, 105, 0.48);
    color: #e2e8f0;
    font-family: var(--font-mono, monospace);
    font-size: 0.75rem;
    white-space: nowrap;
    box-sizing: border-box;
  }

  :root[data-theme='light'] .carousel-cli {
    background: #f1f5f9;
    border-color: #cbd5e1;
    color: #0f172a;
  }

  .carousel-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 32px;
    padding: 0 0.85rem;
    border-radius: 0.42rem;
    background: var(--sl-color-accent, #38bdf8);
    color: #041019 !important;
    font-size: 0.78rem;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
    box-sizing: border-box;
  }

  :root[data-theme='light'] .carousel-link {
    background: #0369a1;
    color: #ffffff !important;
  }

  .carousel-stage img[hidden],
  .carousel-code[hidden] {
    display: none;
  }

  .carousel-code {
    padding: 1rem 1.1rem 0.8rem;
    aspect-ratio: 16 / 10;
    max-height: 520px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.6rem;
    background: #080b13;
  }

  :root[data-theme='light'] .carousel-code {
    background: #f1f5f9;
  }

  .carousel-code-pre {
    margin: 0;
    padding: 1rem 1.1rem;
    overflow: auto;
    max-height: 100%;
    font-family: var(--font-mono, var(--sl-font-mono, monospace));
    font-size: 0.86rem;
    line-height: 1.6;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    color: #e2e8f0;
    background: #0d121d;
    border: 1px solid rgba(71, 85, 105, 0.45);
    border-radius: 0.5rem;
  }

  :root[data-theme='light'] .carousel-code-pre {
    color: #0f172a;
    background: #ffffff;
    border-color: #cbd5e1;
  }

  .carousel-code-note,
  .carousel-footnote {
    margin: 0;
    font-size: 0.76rem;
    line-height: 1.5;
    color: #94a3b8;
  }

  :root[data-theme='light'] .carousel-code-note,
  :root[data-theme='light'] .carousel-footnote {
    color: #475569;
  }

  .carousel-footnote {
    padding: 0.5rem 1.05rem 0.8rem;
    background: #0d131f;
  }

  :root[data-theme='light'] .carousel-footnote {
    background: #ffffff;
  }

  .carousel-facts {
    margin: 0.7rem 0 0;
    display: grid;
    gap: 0.5rem;
  }

  .carousel-facts div {
    display: grid;
    gap: 0.1rem;
  }

  .carousel-facts dt {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: #7dd3fc;
  }

  :root[data-theme='light'] .carousel-facts dt {
    color: #0369a1;
  }

  .carousel-facts dd {
    margin: 0;
    font-size: 0.86rem;
    line-height: 1.55;
    color: #cbd5e1;
  }

  :root[data-theme='light'] .carousel-facts dd {
    color: #334155;
  }

  .carousel-tab:focus-visible,
  .carousel-code-pre:focus-visible {
    outline: 2px solid #38bdf8;
    outline-offset: 2px;
  }
</style>

<script>
  class VoxCarouselElement extends HTMLElement {
    constructor() {
      super();
      const raw = this.dataset.slides;
      if (!raw) return;
      let slides = [];
      try {
        slides = JSON.parse(raw);
      } catch (e) {
        return;
      }
      if (!Array.isArray(slides) || slides.length === 0) return;

      const root = document.documentElement;
      let activeIdx = 0;
      // The resolved site theme is 'light' or 'dark'. Fall back to the OS preference
      // if Starlight has not set the attribute yet.
      const siteIsDark = () => {
        const t = root.getAttribute('data-theme');
        if (t === 'light') return false;
        if (t === 'dark') return true;
        return window.matchMedia('(prefers-color-scheme: dark)').matches;
      };
      let preferDark = siteIsDark();

      const section = this.querySelector('section');
      const tabs = Array.from(this.querySelectorAll('[data-slide-idx]'));
      const panel = this.querySelector('[role="tabpanel"]');
      const q = (sel) => this.querySelector(sel);
      const prevBtn = q('[data-carousel-prev]');
      const nextBtn = q('[data-carousel-next]');
      const themeBtn = q('[data-carousel-theme-toggle]');
      const counter = q('[data-carousel-counter]');
      const img = q('[data-carousel-img]');
      const codeWrap = q('[data-carousel-codewrap]');
      const codePre = q('[data-carousel-code]');
      const codeNote = q('[data-carousel-codenote]');
      const set = (sel, text) => {
        const el = q(sel);
        if (el) el.textContent = text;
      };
      const tabIdPrefix = tabs[0] ? tabs[0].id.replace(/-tab-0$/, '') : '';

      const render = (nextIdx, focusTab) => {
        activeIdx = ((nextIdx % slides.length) + slides.length) % slides.length;
        const s = slides[activeIdx];

        if (img) {
          if (s.srcLight) {
            const dark = preferDark;
            img.src = dark ? s.srcDark : s.srcLight;
            img.srcset = dark ? s.srcsetDark : s.srcsetLight;
            img.alt = s.image.alt;
            img.hidden = false;
          } else {
            img.hidden = true;
          }
        }
        if (codeWrap) {
          codeWrap.hidden = !s.code;
          if (s.code) {
            if (codePre) codePre.textContent = s.code.text;
            if (codeNote) codeNote.textContent = s.code.note;
          }
        }
        set('[data-carousel-badge]', s.badge);
        set('[data-carousel-title]', s.title);
        set('[data-carousel-what]', s.what);
        set('[data-carousel-why]', s.why);
        set('[data-carousel-ai]', s.ai);
        set('[data-carousel-users]', s.users);
        set('[data-carousel-cli]', s.cli);
        const link = q('[data-carousel-link]');
        if (link) {
          link.href = s.linkHref;
          link.textContent = `${s.linkLabel} →`;
        }
        if (panel) panel.setAttribute('aria-labelledby', `${tabIdPrefix}-tab-${activeIdx}`);
        if (counter) counter.textContent = `${activeIdx + 1} / ${slides.length}`;
        if (themeBtn) {
          themeBtn.setAttribute('aria-pressed', preferDark ? 'true' : 'false');
          themeBtn.textContent = preferDark ? 'Captures: Dark' : 'Captures: Light';
        }
        tabs.forEach((t, i) => {
          const active = i === activeIdx;
          t.classList.toggle('active', active);
          t.setAttribute('aria-selected', active ? 'true' : 'false');
          t.tabIndex = active ? 0 : -1;
          if (active && focusTab) t.focus();
        });
      };

      tabs.forEach((tab) => {
        tab.addEventListener('click', () => render(Number(tab.dataset.slideIdx || 0), false));
      });
      prevBtn?.addEventListener('click', () => render(activeIdx - 1, false));
      nextBtn?.addEventListener('click', () => render(activeIdx + 1, false));
      themeBtn?.addEventListener('click', () => {
        preferDark = !preferDark;
        render(activeIdx, false);
      });

      // Follow the site theme when it changes.
      new MutationObserver(() => {
        preferDark = siteIsDark();
        render(activeIdx, false);
      }).observe(root, { attributes: true, attributeFilter: ['data-theme'] });
      // Re-sync once the page has finished loading, in case the theme attribute was set late.
      window.addEventListener('load', () => {
        const next = siteIsDark();
        if (next !== preferDark) {
          preferDark = next;
          render(activeIdx, false);
        }
      });

      section?.addEventListener('keydown', (e) => {
        const target = e.target;
        if (target instanceof HTMLElement && target.closest('pre')) return;
        if (e.key === 'ArrowLeft') {
          e.preventDefault();
          render(activeIdx - 1, target instanceof HTMLElement && target.getAttribute('role') === 'tab');
        } else if (e.key === 'ArrowRight') {
          e.preventDefault();
          render(activeIdx + 1, target instanceof HTMLElement && target.getAttribute('role') === 'tab');
        } else if (e.key === 'Home') {
          e.preventDefault();
          render(0, target instanceof HTMLElement && target.getAttribute('role') === 'tab');
        } else if (e.key === 'End') {
          e.preventDefault();
          render(slides.length - 1, target instanceof HTMLElement && target.getAttribute('role') === 'tab');
        }
      });

      render(0, false);
    }
  }

  if (!customElements.get('vox-carousel')) {
    customElements.define('vox-carousel', VoxCarouselElement);
  }
</script>
