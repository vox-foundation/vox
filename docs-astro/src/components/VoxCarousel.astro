  }

  .carousel-footer {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.9rem 1.05rem;
    background: #0d131f;
    flex-wrap: wrap;
  }

  :root[data-theme='light'] .carousel-footer {
    background: #ffffff;
  }

  .carousel-meta {
    flex: 1 1 360px;
    min-width: 0;
  }

  .carousel-badge {
    display: inline-block;
    font-family: var(--font-mono, monospace);
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.16rem 0.5rem;
    border-radius: 999px;
    background: rgba(56, 189, 248, 0.14);
    color: #bae6fd;
    border: 1px solid rgba(56, 189, 248, 0.35);
    margin-bottom: 0.35rem;
  }

  :root[data-theme='light'] .carousel-badge {
    background: #e0f2fe;
