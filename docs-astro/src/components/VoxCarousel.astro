    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .carousel-brand-label {
    font-size: 0.84rem;
    font-weight: 700;
    color: #f8fafc;
    letter-spacing: -0.01em;
  }

  :root[data-theme='light'] .carousel-brand-label {
    color: #0f172a;
  }

  .carousel-tabs {
    display: flex;
    align-items: center;
    gap: 0.28rem;
    flex-wrap: wrap;
  }

  .carousel-tab {
