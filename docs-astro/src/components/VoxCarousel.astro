  }

  .carousel-counter {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 26px;
    padding: 0 0.5rem;
    font-family: var(--font-mono, monospace);
    font-size: 0.71rem;
    font-weight: 700;
    color: #cbd5e1;
    background: rgba(15, 23, 42, 0.55);
