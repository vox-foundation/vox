    desc: 'Query Repo-Local docs/wiki/, ~/.vox/library/, and Vox Baseline canon with provenance pills and 1-click Open into the Doc Dock.',
    cli: 'vox kb status',
    linkHref: '/tutorials/tut-knowledgebase-and-openwiki/',
    linkLabel: 'KB & OpenWiki →',
    lightSrc: '/assets/axis/memory-arcane.webp',
    darkSrc: '/assets/axis/memory-slate.webp',
    alt: 'Vox Axis Memory surface showing 3-layer Federated KB controls, Top-K Depth rotary dial, provenance tags, and single-row Open actions',
  },
