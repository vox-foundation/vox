---
const slides = [
  {
    id: 'urbs',
    tab: '1. Topology',
    badge: 'gamify · Spatial Graph',
    title: 'Codebase Topology & Churn Map',
    desc: 'Maps Cargo, TypeScript, Python, and Go dependency layers (L0–L5), Tarjan SCCs, and git churn onto interactive crate districts.',
    cli: 'cargo run -p vox-cli --features gui -- gui',
    linkHref: '/how-to/how-to-axis-workbench/#2-exploring-vrbs-roma--the-aqvaeductus-verification-cascade',
    linkLabel: 'Workbench Guide →',
    lightSrc: '/assets/axis/urbs-civilization.webp',
    darkSrc: null,
    alt: 'VRBS ROMA 3D/2.5D Isometric Codebase Civilization Simulator and Forma Urbis 7-Tier Astrolabe Radar',
  },
  {
    id: 'imperium',
    tab: '2. Blast Radius',
    badge: 'ImperiumInspector.tsx',
    title: 'Upstream & Downstream Impact DAG',
    desc: 'Select any crate monument to inspect callers, dependents, per-file +/-LoC diffs, and 1-click [CHECK] or [TEST IMPACTED] actions.',
    cli: 'vox graph crate-map',
    linkHref: '/how-to/how-to-axis-workbench/#2-exploring-vrbs-roma--the-aqvaeductus-verification-cascade',
    linkLabel: 'Blast-Radius Guide →',
    lightSrc: '/assets/axis/urbs-imperium-inspector.webp',
    darkSrc: null,
    alt: 'Imperium Prefecture Dock and Dependency Blast-Radius DAG Inspector',
  },
  {
    id: 'chat',
    tab: '3. Multi-Dock',
    badge: 'chat · Alt+1..4',
    title: 'Tiled Chat, Consensus & Turn Receipts',
    desc: 'Run Focus, Split Code, Multi-Agent, or Tactical Map layouts with cognitive clutch knobs, BPE token budgets, and HMAC tool receipts.',
    cli: 'vox chat',
    linkHref: '/how-to/how-to-axis-workbench/#3-real-time-loquela-posture-controls--keybinds',
    linkLabel: 'Loquela Controls →',
    lightSrc: '/assets/axis/chat-multidock.webp',
    darkSrc: null,
    alt: 'Multi-Dock Responsive Chat Workbench with VRBS ROMA Simulator and AQVAEDUCTUS Cascade',
  },
  {
    id: 'harness',
    tab: '4. Sluice Gate',
    badge: 'harness · AQVAEDUCTUS',
    title: '3-Tier Routing & 4-Stage Sluice Checks',
    desc: 'Routes tasks across Fast Local MENS, Balanced Hybrid, and Deep Frontier tiers gated by AST parse, typecheck, toestub, and tests.',
    cli: 'vox mcp',
    linkHref: '/how-to/how-to-ai-agents/',
    linkLabel: 'Agent Harness →',
    lightSrc: '/assets/axis/harness.webp',
    darkSrc: null,
    alt: 'AQVAEDUCTUS 3-Tier Hydraulic Verification Cascade and Parallel Agent Execution Braid',
  },
  {
    id: 'research',
    tab: '5. Research',
    badge: 'research · Dual Theme',
    title: 'KB Preflight, Subquery Audit & Wave Steer',
    desc: 'Run Prior-Art Preflight against local shards before web search, inspect subqueries, steer +1 Wave Refinement, and scope KB indexing.',
    cli: 'vox research run "..." --lane deep',
    linkHref: '/tutorials/tut-deep-research-and-scientia/',
    linkLabel: 'Research Tutorial →',
    lightSrc: '/assets/axis/research-arcane.webp',
    darkSrc: '/assets/axis/research-slate.webp',
    alt: 'Vox Axis Research Studio with Statistical Archetypes, above-the-fold Synthesis Report, Domain Mode selector, and Edit in Doc Dock action',
  },
  {
    id: 'memory',
    tab: '6. Memory KB',
    badge: 'memory · Dual Theme',
