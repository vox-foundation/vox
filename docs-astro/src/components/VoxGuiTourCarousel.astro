const first = slides[0];
---

<vox-gui-tour-carousel data-slides={JSON.stringify(slides)}>
  <section
    id="vox-axis-workbench"
    class="vox-gui-carousel not-content"
    data-testid="axis-tour-carousel"
    aria-label="Vox Axis Interactive Workbench Tour"
    tabindex="0"
  >
    <div class="carousel-header">
      <div class="carousel-topbar">
        <div class="carousel-brand">
          <span class="carousel-brand-label">Vox Axis Surface Tour</span>
          <span class="carousel-counter" data-carousel-counter>1 / {slides.length}</span>
        </div>

        <div class="carousel-controls">
          <button
            type="button"
            class="carousel-theme-btn"
            data-carousel-theme-toggle
            aria-pressed="false"
          >
            Theme: Light
          </button>
          <button
            type="button"
            class="carousel-nav-btn"
            data-carousel-prev
            aria-label="Previous surface"
          >
            ← Prev
          </button>
          <button
            type="button"
            class="carousel-nav-btn"
            data-carousel-next
            aria-label="Next surface"
          >
            Next →
          </button>
        </div>
      </div>

      <div class="carousel-tabs" role="tablist" aria-label="Vox Axis Workbench surfaces">
        {slides.map((s, idx) => (
          <button
            type="button"
            role="tab"
            id={`carousel-tab-${idx}`}
            aria-controls="vox-gui-carousel-panel"
            class={`carousel-tab ${idx === 0 ? 'active' : ''}`}
            aria-selected={idx === 0 ? 'true' : 'false'}
            data-slide-idx={idx}
          >
            {s.tab}{s.darkSrc ? ' ◐' : ''}
          </button>
        ))}
      </div>
    </div>

    <div id="vox-gui-carousel-panel" role="tabpanel" aria-labelledby="carousel-tab-0">
      <div class="carousel-stage">
        <img
          data-carousel-img
          src={first.lightSrc}
          alt={first.alt}
          width="1280"
          height="800"
          loading="lazy"
          decoding="async"
        />
      </div>

      <div class="carousel-footer">
        <div class="carousel-meta">
          <span class="carousel-badge" data-carousel-badge>{first.badge}</span>
          <h3 class="carousel-title" data-carousel-title>{first.title}</h3>
          <p class="carousel-desc" data-carousel-desc>{first.desc}</p>
        </div>
        <div class="carousel-actions">
          <code class="carousel-cli" data-carousel-cli>{first.cli}</code>
          <a class="carousel-link" data-carousel-link href={first.linkHref}>{first.linkLabel}</a>
        </div>
      </div>
    </div>
  </section>
</vox-gui-tour-carousel>

<style>
  .vox-gui-carousel {
    border: 1px solid rgba(71, 85, 105, 0.48);
    border-radius: 0.75rem;
    overflow: hidden;
    margin: 1.15rem 0;
    scroll-margin-top: 4.5rem;
    background: #0b0f19;
    box-shadow: 0 16px 38px rgba(0, 0, 0, 0.42);
    outline: none;
  }

  .vox-gui-carousel:focus-visible {
    box-shadow: 0 0 0 2px #38bdf8, 0 16px 38px rgba(0, 0, 0, 0.42);
  }

  :root[data-theme='light'] .vox-gui-carousel {
    background: #ffffff;
    border-color: #cbd5e1;
    box-shadow: 0 8px 24px rgba(15, 23, 42, 0.08);
  }

  .vox-gui-carousel button {
    margin: 0;
    font-family: inherit;
    line-height: 1;
    box-sizing: border-box;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    white-space: nowrap;
    cursor: pointer;
  }

  .carousel-header {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    padding: 0.65rem 0.85rem;
    background: linear-gradient(180deg, #111726 0%, #0c111d 100%);
    border-bottom: 1px solid rgba(71, 85, 105, 0.38);
  }

  :root[data-theme='light'] .carousel-header {
    background: #f8fafc;
    border-bottom-color: #cbd5e1;
  }

  .carousel-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.65rem;
    flex-wrap: wrap;
  }

  .carousel-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .carousel-brand-label {
    font-size: 0.84rem;
    font-weight: 700;
    color: #f8fafc;
    letter-spacing: -0.01em;
  }

  :root[data-theme='light'] .carousel-brand-label {
    color: #0f172a;
  }

  .carousel-tabs {
    display: flex;
    align-items: center;
    gap: 0.28rem;
    flex-wrap: wrap;
  }

  .carousel-tab {
    height: 27px;
    padding: 0 0.52rem;
    font-size: 0.71rem;
    font-weight: 600;
    border-radius: 0.36rem;
    border: 1px solid rgba(71, 85, 105, 0.45);
    background: rgba(15, 23, 42, 0.72);
    color: #cbd5e1;
    transition: border-color 0.12s ease;
  }

  .carousel-tab:hover {
    color: #f8fafc;
    border-color: rgba(56, 189, 248, 0.55);
  }

  .carousel-tab.active {
    background: rgba(34, 211, 238, 0.16);
    border-color: #22d3ee;
    color: #bae6fd;
  }

  :root[data-theme='light'] .carousel-tab {
    background: #ffffff;
    border-color: #cbd5e1;
    color: #1e293b;
  }

  :root[data-theme='light'] .carousel-tab:hover {
    border-color: #0369a1;
    color: #0f172a;
  }

  :root[data-theme='light'] .carousel-tab.active {
    background: #0369a1;
    border-color: #0369a1;
    color: #ffffff;
  }

  .carousel-controls {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .carousel-theme-btn {
    height: 28px;
    padding: 0 0.6rem;
    font-size: 0.71rem;
    font-weight: 600;
    border-radius: 0.36rem;
    border: 1px solid rgba(245, 158, 11, 0.48);
    background: rgba(245, 158, 11, 0.14);
    color: #fde68a;
  }

  .carousel-theme-btn[aria-pressed='true'] {
    background: rgba(56, 189, 248, 0.18);
    border-color: #38bdf8;
    color: #bae6fd;
  }

  :root[data-theme='light'] .carousel-theme-btn {
    background: #fef3c7;
    border-color: #b45309;
    color: #78350f;
  }

  :root[data-theme='light'] .carousel-theme-btn[aria-pressed='true'] {
    background: #0f172a;
    border-color: #0f172a;
    color: #f8fafc;
  }

  .carousel-nav-btn {
    height: 28px;
    padding: 0 0.58rem;
    font-size: 0.71rem;
    font-weight: 600;
    border-radius: 0.36rem;
    border: 1px solid rgba(71, 85, 105, 0.48);
    background: rgba(15, 23, 42, 0.72);
    color: #e2e8f0;
  }

  .carousel-nav-btn:hover {
    border-color: #38bdf8;
    color: #ffffff;
  }

  :root[data-theme='light'] .carousel-nav-btn {
    background: #ffffff;
    border-color: #cbd5e1;
    color: #0f172a;
  }

  :root[data-theme='light'] .carousel-nav-btn:hover {
    border-color: #0369a1;
  }

  .carousel-counter {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 26px;
    padding: 0 0.5rem;
    font-family: var(--font-mono, monospace);
    font-size: 0.71rem;
    font-weight: 700;
    color: #cbd5e1;
    background: rgba(15, 23, 42, 0.55);
    border: 1px solid rgba(71, 85, 105, 0.35);
    border-radius: 0.36rem;
    box-sizing: border-box;
    white-space: nowrap;
  }

  :root[data-theme='light'] .carousel-counter {
    background: #f1f5f9;
    border-color: #cbd5e1;
    color: #0f172a;
  }

  .carousel-stage {
    background: #080b13;
    border-bottom: 1px solid rgba(71, 85, 105, 0.35);
  }

  :root[data-theme='light'] .carousel-stage {
    background: #f1f5f9;
    border-bottom-color: #cbd5e1;
  }

  .carousel-stage img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: contain;
  }

  .carousel-footer {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.9rem 1.05rem;
    background: #0d131f;
    flex-wrap: wrap;
  }

  :root[data-theme='light'] .carousel-footer {
    background: #ffffff;
  }

  .carousel-meta {
    flex: 1 1 360px;
    min-width: 0;
  }

  .carousel-badge {
    display: inline-block;
    font-family: var(--font-mono, monospace);
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.16rem 0.5rem;
    border-radius: 999px;
    background: rgba(56, 189, 248, 0.14);
    color: #bae6fd;
    border: 1px solid rgba(56, 189, 248, 0.35);
    margin-bottom: 0.35rem;
  }

  :root[data-theme='light'] .carousel-badge {
    background: #e0f2fe;
    color: #0c4a6e;
    border-color: #7dd3fc;
  }

  .carousel-title {
    margin: 0 0 0.25rem;
    font-size: 1.05rem;
    font-weight: 700;
    color: #f8fafc;
  }

  :root[data-theme='light'] .carousel-title {
    color: #0f172a;
  }

  .carousel-desc {
    margin: 0;
    font-size: 0.86rem;
    line-height: 1.48;
    color: #cbd5e1;
  }

  :root[data-theme='light'] .carousel-desc {
    color: #334155;
  }

  .carousel-actions {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    flex-wrap: wrap;
  }

  .carousel-cli {
    display: inline-flex;
    align-items: center;
    height: 32px;
    padding: 0 0.65rem;
    border-radius: 0.42rem;
    background: #0f172a;
    border: 1px solid rgba(71, 85, 105, 0.48);
    color: #e2e8f0;
    font-family: var(--font-mono, monospace);
    font-size: 0.75rem;
    white-space: nowrap;
    box-sizing: border-box;
  }

  :root[data-theme='light'] .carousel-cli {
    background: #f1f5f9;
    border-color: #cbd5e1;
    color: #0f172a;
  }

  .carousel-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 32px;
    padding: 0 0.85rem;
    border-radius: 0.42rem;
    background: var(--sl-color-accent, #38bdf8);
    color: #041019 !important;
    font-size: 0.78rem;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
    box-sizing: border-box;
  }

  :root[data-theme='light'] .carousel-link {
    background: #0369a1;
    color: #ffffff !important;
  }
</style>

<script>
  class VoxGuiTourCarouselElement extends HTMLElement {
    connectedCallback() {
      const rawSlides = this.dataset.slides;
      if (!rawSlides) return;
      const slides = JSON.parse(rawSlides);
      if (!Array.isArray(slides) || slides.length === 0) return;

      let activeIdx = 0;
      let preferDark = false;

      const rootSection = this.querySelector<HTMLElement>('.vox-gui-carousel');
      const tabs = Array.from(this.querySelectorAll<HTMLButtonElement>('[data-slide-idx]'));
      const prevBtn = this.querySelector<HTMLButtonElement>('[data-carousel-prev]');
      const nextBtn = this.querySelector<HTMLButtonElement>('[data-carousel-next]');
      const themeBtn = this.querySelector<HTMLButtonElement>('[data-carousel-theme-toggle]');
      const counterEl = this.querySelector<HTMLElement>('[data-carousel-counter]');
      const imgEl = this.querySelector<HTMLImageElement>('[data-carousel-img]');
      const badgeEl = this.querySelector<HTMLElement>('[data-carousel-badge]');
      const titleEl = this.querySelector<HTMLElement>('[data-carousel-title]');
      const descEl = this.querySelector<HTMLElement>('[data-carousel-desc]');
      const cliEl = this.querySelector<HTMLElement>('[data-carousel-cli]');
      const linkEl = this.querySelector<HTMLAnchorElement>('[data-carousel-link]');
      const panelEl = this.querySelector<HTMLElement>('#vox-gui-carousel-panel');

      const render = (nextIdx: number) => {
        activeIdx = ((nextIdx % slides.length) + slides.length) % slides.length;
        const slide = slides[activeIdx];
        const useDark = preferDark && Boolean(slide.darkSrc);
        const src = useDark && slide.darkSrc ? slide.darkSrc : slide.lightSrc;

        if (imgEl) {
          imgEl.src = src;
          imgEl.alt = slide.alt;
        }
        if (badgeEl) badgeEl.textContent = slide.badge;
        if (titleEl) titleEl.textContent = slide.title;
        if (descEl) descEl.textContent = slide.desc;
        if (cliEl) cliEl.textContent = slide.cli;
        if (linkEl) {
          linkEl.href = slide.linkHref;
          linkEl.textContent = slide.linkLabel;
        }
        if (panelEl) panelEl.setAttribute('aria-labelledby', `carousel-tab-${activeIdx}`);
        if (counterEl) counterEl.textContent = `${activeIdx + 1} / ${slides.length}`;
        if (themeBtn) {
          themeBtn.setAttribute('aria-pressed', preferDark ? 'true' : 'false');
          themeBtn.textContent = preferDark
            ? useDark
              ? 'Theme: Dark (Slate)'
              : 'Theme: Dark (Light View)'
            : 'Theme: Light';
        }
        tabs.forEach((t, i) => {
          const active = i === activeIdx;
          t.classList.toggle('active', active);
          t.setAttribute('aria-selected', active ? 'true' : 'false');
        });
      };

      tabs.forEach((tab) => {
        tab.addEventListener('click', () => {
          const idx = Number(tab.dataset.slideIdx ?? 0);
          render(idx);
        });
      });

      prevBtn?.addEventListener('click', () => render(activeIdx - 1));
      nextBtn?.addEventListener('click', () => render(activeIdx + 1));

      themeBtn?.addEventListener('click', () => {
        preferDark = !preferDark;
        if (preferDark && !slides[activeIdx]?.darkSrc) {
          const firstDual = slides.findIndex((s) => Boolean(s.darkSrc));
          if (firstDual >= 0) {
            render(firstDual);
            return;
          }
        }
        render(activeIdx);
      });

      rootSection?.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft') {
          e.preventDefault();
          render(activeIdx - 1);
        } else if (e.key === 'ArrowRight') {
          e.preventDefault();
          render(activeIdx + 1);
        } else if (e.key === 'Home') {
          e.preventDefault();
          render(0);
        } else if (e.key === 'End') {
          e.preventDefault();
          render(slides.length - 1);
        }
      });
    }
  }

  if (!customElements.get('vox-gui-tour-carousel')) {
    customElements.define('vox-gui-tour-carousel', VoxGuiTourCarouselElement);
  }
</script>
