    cli: 'vox audit code',
    linkHref: '/how-to/how-to-axis-workbench/#4-switching-between-the-4-enforced-wcag-theme-profiles',
    linkLabel: 'Theme Profiles →',
    lightSrc: '/assets/axis/theme-arcane.webp',
    darkSrc: '/assets/axis/theme-slate.webp',
    alt: 'Vox Axis Theme Contract switching between Imperial Carrara Light (arcane) and Minimalist Grey-Blue Slate Dark (slate)',
  },
