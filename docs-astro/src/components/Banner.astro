---
import Default from '@astrojs/starlight/components/Banner.astro';
import { getFreshnessForPath } from '../utils/docs-freshness.mjs';

const route = Astro.locals.starlightRoute;
const entry = route?.entry;
const sourcePath = entry?.data?._sourcePath;
const isSplash = entry?.data?.template === 'splash' || !route?.id || route?.id === '' || route?.id === 'index';
const freshness = !isSplash ? getFreshnessForPath(sourcePath, entry?.filePath) : null;
---

<!-- Render standard Starlight status banner if present (research, roadmap, deprecated, legacy) -->
<Default {...Astro.props} />

<!-- Floating Restore Button when Left Navigation Sidebar is completely hidden -->
<button
  id="vox-sidebar-restore-btn"
  type="button"
  aria-label="Show navigation sidebar"
  aria-expanded="false"
  title="Show navigation sidebar"
  data-pagefind-ignore
>
  <svg viewBox="0 0 24 24" aria-hidden="true">
    <rect x="3" y="3" width="18" height="18" rx="2" ry="2" />
    <line x1="9" y1="3" x2="9" y2="21" />
    <path d="M13 9l3 3-3 3" />
  </svg>
  <span class="vox-sidebar-restore-label">Navigation</span>
</button>

<!-- Render Trust Signal Banner for public reader-facing pages -->
{freshness && (
  <div class={`vox-trust-banner vox-trust-${freshness.state}`} data-pagefind-ignore>
    <div class="vox-trust-inner">
      <span class="vox-trust-indicator" aria-hidden="true"></span>
      <span class="vox-trust-text">
        {freshness.state === 'verified' && (
          <>
            <strong>Verified:</strong> Accurate against commit{' '}
            <code>{freshness.shortCommit}</code>
          </>
        )}
        {freshness.state === 'drifting' && (
          <>
            <strong>May be out of date:</strong> Code changed since verification (at <code>{freshness.shortCommit}</code>).
          </>
        )}
        {(freshness.state === 'broken' || freshness.state === 'unanchored') && (
          <>
            <strong>Unverified:</strong> This page has not yet been anchored to automated code tests.
          </>
        )}
        {freshness.state === 'historical' && (
          <>
            <strong>Historical:</strong> Archived or legacy material preserved for historical context.
          </>
        )}
      </span>
      {freshness.state === 'verified' && freshness.commitUrl && (
        <a href={freshness.commitUrl} class="vox-trust-link" target="_blank" rel="noopener noreferrer">
          View Commit
        </a>
      )}
    </div>
  </div>
)}

<script is:inline>
  (function() {
    function initSidebarRestore() {
      var btn = document.getElementById('vox-sidebar-restore-btn');
      if (!btn) return;
      var hideBtn = document.getElementById('vox-sidebar-hide-btn');
      var pinBtn = document.getElementById('vox-sidebar-pin-toggle');
      var isHidden = document.documentElement.dataset.sidebarState === 'hidden';
      btn.setAttribute('aria-expanded', isHidden ? 'false' : 'true');

      if (btn.dataset.voxBound === 'true') return;
      btn.dataset.voxBound = 'true';

      btn.addEventListener('click', function() {
        document.documentElement.dataset.sidebarState = 'pinned';
        btn.setAttribute('aria-expanded', 'true');
        if (hideBtn) hideBtn.setAttribute('aria-expanded', 'true');
        if (pinBtn) {
          pinBtn.setAttribute('aria-expanded', 'true');
          pinBtn.setAttribute('aria-label', 'Collapse sidebar');
          pinBtn.setAttribute('title', 'Collapse sidebar navigation');
        }
        try {
          localStorage.setItem('vox-sidebar-state', 'pinned');
        } catch (e) {}
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initSidebarRestore);
    } else {
      initSidebarRestore();
    }
    document.addEventListener('astro:page-load', initSidebarRestore);
  })();
</script>
