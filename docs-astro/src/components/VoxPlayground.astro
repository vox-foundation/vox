    display: flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0 0.75rem;
    height: 34px;
    background: #0d121d;
    border-bottom: 1px solid rgba(71, 85, 105, 0.35);
  }

  .secondary-tab {
    background: transparent;
    color: #94a3b8;
    border: none;
    border-bottom: 2px solid transparent;
    height: 100%;
    padding: 0 0.65rem;
    font-size: 0.76rem;
    font-weight: 600;
    cursor: pointer;
  }

  .secondary-tab.active {
    color: #f8fafc;
    border-bottom-color: #10b981;
  }

  .secondary-chevron {
    margin-left: auto;
    color: #64748b;
    font-size: 0.85rem;
  }

  .secondary-code-shell {
    display: grid;
    grid-template-columns: 34px 1fr;
    min-height: 210px;
    max-height: 230px;
    overflow: hidden;
    background: #080b13;
  }

  .secondary-output-display {
    margin: 0;
    padding: 0.7rem 0.85rem;
    overflow: auto;
    background: transparent;
    color: #cbd5e1;
    font-family: var(--font-mono, var(--sl-font-mono, monospace));
    font-size: 0.76rem;
    line-height: 1.52;
    white-space: pre;
  }

  /* Syntax Highlighting Token Palette (Concept Art B IDE Theme) */
  :global(.tok-kw) {
    color: #38bdf8;
    font-weight: 600;
  }
  :global(.tok-type) {
    color: #a78bfa;
  }
  :global(.tok-str) {
    color: #fb923c;
  }
  :global(.tok-prop) {
    color: #34d399;
  }
  :global(.tok-fn) {
    color: #60a5fa;
  }
  :global(.tok-num) {
    color: #fbbf24;
  }
  :global(.tok-comment) {
    color: #64748b;
    font-style: italic;
  }
  :global(.tok-rule) {
    display: block;
    border-bottom: 1px solid rgba(71, 85, 105, 0.35);
    margin: 0.35rem 0;
  }
</style>

<script>
  function escapeHtml(raw) {
    return String(raw)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;');
  }

  function highlightLine(line) {
    const trimmed = line.trim();
    if (trimmed.startsWith('────')) {
      return `<span class="tok-rule"></span>`;
    }
    if (trimmed.startsWith('//') || trimmed.startsWith('--') || trimmed.startsWith('#[')) {
      return `<span class="tok-comment">${escapeHtml(line)}</span>`;
    }
    const tokenRe = /("(?:[^"\\]|\\.)*"|'(?:[^'\\]|\\.)*')|\b(import|export|table|query|mutation|tool|component|activity|workflow|fn|let|return|to|if|pub|struct|use|async|CREATE|TABLE|IF|NOT|EXISTS|PRIMARY|KEY|AUTOINCREMENT|INDEX|ON|DELETE|FROM|WHERE|SELECT|COUNT|INTEGER|TEXT|REAL|NULL)\b|\b(Result|Ok|Error|Id|Task|TaskRow|ServiceEndpoint|OrderLedger|Router|AppState|Json|Serialize|Deserialize|JSX|Element|str|int|bool|i64|f64|String|Turso)\b|\b([a-z_][A-Za-z0-9_]*)(?=\s*:)|\b([a-z_][A-Za-z0-9_]*)(?=\s*\()|\b(\d+)\b/g;
    let out = '';
    let lastIdx = 0;
    let m;
    while ((m = tokenRe.exec(line)) !== null) {
      if (m.index > lastIdx) {
        out += escapeHtml(line.slice(lastIdx, m.index));
      }
      if (m[1]) {
        out += `<span class="tok-str">${escapeHtml(m[1])}</span>`;
      } else if (m[2]) {
        out += `<span class="tok-kw">${escapeHtml(m[2])}</span>`;
      } else if (m[3]) {
        out += `<span class="tok-type">${escapeHtml(m[3])}</span>`;
      } else if (m[4]) {
        out += `<span class="tok-prop">${escapeHtml(m[4])}</span>`;
      } else if (m[5]) {
        out += `<span class="tok-fn">${escapeHtml(m[5])}</span>`;
      } else if (m[6]) {
        out += `<span class="tok-num">${escapeHtml(m[6])}</span>`;
      }
      lastIdx = tokenRe.lastIndex;
    }
    if (lastIdx < line.length) {
      out += escapeHtml(line.slice(lastIdx));
    }
    return out;
  }

  function highlightCodeBlock(code) {
    return String(code)
      .split(/\r?\n/)
      .map((line) => highlightLine(line))
      .join('\n');
  }

  function buildLineGutter(code, minLines) {
    const count = Math.max(minLines || 8, String(code).split(/\r?\n/).length);
    const nums = [];
    for (let i = 1; i <= count; i++) nums.push(i);
    return nums.join('\n');
  }

  function parseVoxAstSummary(code) {
    const tables = [];
    const tableRe = /(?:@table\s+type|table)\s+([A-Za-z_]\w*)\s*\{([\s\S]*?)\}/g;
    let m;
    while ((m = tableRe.exec(code)) !== null) {
      const name = m[1];
      const body = m[2];
      const fields = [];
      for (const rawLine of body.split(/\r?\n/)) {
        const line = rawLine.split('//')[0].trim();
        const fm = line.match(/^([A-Za-z_]\w*)\s*:\s*([A-Za-z0-9_[\]]+)/);
        if (fm) {
          fields.push({ name: fm[1], voxType: fm[2] });
        }
      }
      tables.push({ name, fields });
    }

    const fns = [];
    const fnRe = /(?:@(query|mutation|component|server|mcp\.tool(?:\("([^"]*)"\))?)\s+)?(query|mutation|component|server|activity|workflow|fn|tool\s+"([^"]*)")\s+([A-Za-z_]\w*)\s*\(([^)]*)\)(?:\s*(?:->|to)\s*([A-Za-z0-9_[\]]+))?/g;
    while ((m = fnRe.exec(code)) !== null) {
      const rawKeyword = m[3].startsWith('tool') ? 'mcp.tool' : m[3];
      const rawDec = m[1] || rawKeyword;
      const decorator = rawDec.startsWith('mcp.tool') ? 'mcp.tool' : rawDec;
      fns.push({
        decorator,
        doc: m[2] || m[4] || `Generated ${m[5]} operation`,
        name: m[5],
        params: (m[6] || '').trim(),
        retType: (m[7] || 'Unit').trim(),
      });
    }

    return { tables, fns };
  }

  function voxTypeToSql(t) {
    const clean = t.toLowerCase();
    if (clean === 'int' || clean === 'bool') return 'INTEGER NOT NULL';
    if (clean === 'float') return 'REAL NOT NULL';
    return 'TEXT NOT NULL';
  }

  function voxTypeToRust(t) {
    if (t === 'int') return 'i64';
    if (t === 'float') return 'f64';
    if (t === 'bool') return 'bool';
    if (t === 'str') return 'String';
    if (t.startsWith('Id[')) return 'i64';
    if (t.startsWith('Result[')) {
      const inner = t.slice(7, -1);
      return `Result<${voxTypeToRust(inner)}, VoxServerError>`;
    }
    return t;
  }

  function compileVoxTargets(code, runtimeOut) {
    const ast = parseVoxAstSummary(code);

    // 1. SQL Target (Turso / SQLite)
    const sqlLines = [
      '-- Compiled by vox-compiler::codex_sql (Turso / SQLite DDL)',
    ];
    if (ast.tables.length === 0) {
      sqlLines.push('CREATE TABLE IF NOT EXISTS vox_workflow_journal (');
      sqlLines.push('    run_id TEXT PRIMARY KEY,');
      sqlLines.push('    step_ordinal INTEGER NOT NULL,');
      sqlLines.push('    payload_json TEXT NOT NULL');
      sqlLines.push(');');
    } else {
      for (const tbl of ast.tables) {
        const tableLower = tbl.name.toLowerCase();
        sqlLines.push(`CREATE TABLE IF NOT EXISTS ${tableLower} (`);
        sqlLines.push('    _id INTEGER PRIMARY KEY AUTOINCREMENT,');
        tbl.fields.forEach((f, i) => {
          const comma = i < tbl.fields.length - 1 ? ',' : '';
          sqlLines.push(`    ${f.name} ${voxTypeToSql(f.voxType)}${comma}`);
        });
        sqlLines.push(');');
        sqlLines.push(`CREATE INDEX IF NOT EXISTS idx_${tableLower}_id ON ${tableLower}(_id);`);
      }
    }
    const queryFns = ast.fns.filter((f) => f.decorator === 'query' || f.decorator === 'mutation' || f.decorator === 'mcp.tool');
    for (const qf of queryFns) {
      const tblName = ast.tables[0]?.name.toLowerCase() || 'vox_records';
      if (qf.name.includes('delete') || qf.name.includes('complete')) {
        sqlLines.push(`DELETE FROM ${tblName} WHERE _id = ?1;`);
      } else {
        sqlLines.push(`SELECT COUNT(_id) FROM ${tblName};`);
      }
    }

    // 2. Rust Target (Axum + Turso)
    const rustLines = [
      '// Compiled by vox-compiler::codegen_rust (Axum + Turso)',
      'use axum::{routing::{get, post}, Json, Router};',
      'use serde::{Deserialize, Serialize};',
    ];
    for (const tbl of ast.tables) {
      rustLines.push(`pub struct ${tbl.name}Row {`);
      rustLines.push('    pub id: i64,');
      for (const f of tbl.fields) {
        rustLines.push(`    pub ${f.name}: ${voxTypeToRust(f.voxType)},`);
      }
      rustLines.push('}');
    }
    rustLines.push('pub fn vox_generated_router() -> Router<AppState> {');
    rustLines.push('    Router::new()');
    for (const fnItem of ast.fns) {
      if (fnItem.name === 'main' || fnItem.decorator === 'component') continue;
      const method = fnItem.decorator === 'query' ? 'get' : 'post';
      rustLines.push(`        .route("/api/${fnItem.name}", ${method}(handle_${fnItem.name}))`);
    }
    rustLines.push('}');

    // 3. TSX + MCP Schema Target
    const tsxLines = [
      '// Compiled by vox-compiler::codegen_ts (React UI + MCP JSON Schema)',
    ];
    const compFns = ast.fns.filter((f) => f.decorator === 'component');
    if (compFns.length > 0) {
      for (const cf of compFns) {
        tsxLines.push(`export function ${cf.name}(): JSX.Element {`);
        tsxLines.push(`  const data = useVoxQuery("${ast.fns[0]?.name || 'get_tasks'}");`);
        tsxLines.push(`  return <div className="vox-component">${cf.name} Ready ({String(data)})</div>;`);
        tsxLines.push('}');
      }
    }
    const mcpTools = ast.fns.filter((f) => f.decorator === 'mcp.tool' || f.decorator === 'workflow');
    const mcpSchema = mcpTools.map((t) => ({
      name: t.name,
      description: t.doc,
      inputSchema: {
        type: 'object',
        properties: t.params
          ? Object.fromEntries(
              t.params.split(',').map((p) => {
                const [k, v] = p.split(':').map((s) => s.trim());
                return [k || 'arg', { type: v === 'int' ? 'integer' : 'string' }];
              })
            )
          : {},
      },
    }));
    tsxLines.push(JSON.stringify(mcpSchema, null, 2));

    return {
      runtime: runtimeOut,
      sql: sqlLines.join('\n'),
      rust: rustLines.join('\n'),
      tsx: tsxLines.join('\n'),
    };
  }

  class VoxPlayground extends HTMLElement {
    constructor() {
      super();
      let examples = [];
      try {
        examples = JSON.parse(this.dataset.examples || '[]');
      } catch (e) {}

      const editor = this.querySelector('.code-editor');
      const highlightLayer = this.querySelector('.code-highlight-layer');
      const editorGutter = this.querySelector('.editor-line-gutter');
      const runBtn = this.querySelector('.run-btn');
      const copyBtn = this.querySelector('.copy-btn');
      const outputDisplay = this.querySelector('.output-display');
      const secondaryDisplay = this.querySelector('.secondary-output-display');
      const secondaryGutter = this.querySelector('.secondary-line-gutter');
      const presetTabs = Array.from(this.querySelectorAll('.playground-tab'));
      const targetTabs = Array.from(this.querySelectorAll('.target-tab'));
      const secondaryTabs = Array.from(this.querySelectorAll('.secondary-tab'));
      const schematicNodes = Array.from(this.querySelectorAll('.schematic-target-btn'));

      let activeExample = examples[0] || {
        id: 'default',
        label: 'Default',
        code: this.dataset.initialCode || '',
        expectedOutput: 'Tasks queued: 1\nTasks remaining: 0\n→ Ok("done")',
        summary: '',
      };
      let activeTarget = 'runtime';
      let activeSecondaryTarget = 'rust';
      let lastRuntimeOutput = activeExample.expectedOutput;

      const renderCurrentTargets = () => {
        if (!editor || !outputDisplay) return;
        if (highlightLayer) {
          highlightLayer.innerHTML = highlightCodeBlock(editor.value);
        }
        if (editorGutter) {
          editorGutter.textContent = buildLineGutter(editor.value, 9);
        }
        const compiled = compileVoxTargets(editor.value, lastRuntimeOutput);
        const topCode = compiled[activeTarget] || compiled.runtime;
        outputDisplay.innerHTML = highlightCodeBlock(topCode);

        if (secondaryDisplay) {
          const secCode = compiled[activeSecondaryTarget] || compiled.rust;
          secondaryDisplay.innerHTML = highlightCodeBlock(secCode);
          if (secondaryGutter) {
            secondaryGutter.textContent = buildLineGutter(secCode, 8);
          }
        }
      };

      const selectTargetTab = (targetId) => {
        activeTarget = targetId;
        targetTabs.forEach((btn) => {
          const isMatch = btn.dataset.targetId === targetId;
          btn.classList.toggle('active', isMatch);
          btn.setAttribute('aria-selected', isMatch ? 'true' : 'false');
        });
        schematicNodes.forEach((node) => {
          const isMatch = node.dataset.targetTab === targetId;
          node.classList.toggle('active', isMatch);
        });
        renderCurrentTargets();
      };

      targetTabs.forEach((btn) => {
        btn.addEventListener('click', () => {
          const t = btn.dataset.targetId || 'runtime';
          selectTargetTab(t);
        });
      });

      secondaryTabs.forEach((btn) => {
        btn.addEventListener('click', () => {
          activeSecondaryTarget = btn.dataset.secTarget || 'rust';
          secondaryTabs.forEach((b) => {
            const isMatch = b === btn;
            b.classList.toggle('active', isMatch);
            b.setAttribute('aria-selected', isMatch ? 'true' : 'false');
          });
          renderCurrentTargets();
        });
      });

      schematicNodes.forEach((node) => {
        node.addEventListener('click', () => {
          const t = node.dataset.targetTab || 'runtime';
          selectTargetTab(t);
        });
        node.addEventListener('keydown', (ev) => {
          if (ev.key === 'Enter' || ev.key === ' ') {
            ev.preventDefault();
            const t = node.dataset.targetTab || 'runtime';
            selectTargetTab(t);
          }
        });
      });

      presetTabs.forEach((tab) => {
        tab.addEventListener('click', () => {
          const id = tab.dataset.exampleId;
          const found = examples.find((ex) => ex.id === id);
          if (!found) return;
          activeExample = found;
          lastRuntimeOutput = found.expectedOutput;
          presetTabs.forEach((t) => {
            const isMatch = t === tab;
            t.classList.toggle('active', isMatch);
            t.setAttribute('aria-selected', isMatch ? 'true' : 'false');
          });
          if (editor) editor.value = found.code;
          renderCurrentTargets();
        });
      });

      if (editor) {
        editor.addEventListener('input', () => {
          renderCurrentTargets();
        });
        editor.addEventListener('scroll', () => {
          if (highlightLayer) {
            highlightLayer.scrollTop = editor.scrollTop;
            highlightLayer.scrollLeft = editor.scrollLeft;
          }
          if (editorGutter) {
            editorGutter.scrollTop = editor.scrollTop;
          }
        });
      }

      if (copyBtn && editor) {
        copyBtn.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(editor.value);
            copyBtn.textContent = '✓ Copied';
            setTimeout(() => {
              copyBtn.textContent = 'Copy';
            }, 1500);
          } catch (e) {}
        });
      }

      if (runBtn && editor) {
        runBtn.addEventListener('click', () => {
          const code = editor.value.trim();
          if (!code) return;
          const prints = [];
          const printRe = /print\s*\(\s*"([^"]*)"/g;
          let pm;
          while ((pm = printRe.exec(code)) !== null) {
            prints.push(pm[1]);
          }
          const matched = examples.find((ex) => ex.code.trim() === code);
          if (matched) {
            lastRuntimeOutput = matched.expectedOutput;
          } else if (prints.length > 0) {
            lastRuntimeOutput = `${prints.join('\n')}\n→ Ok("compiled_and_executed")`;
          } else {
            lastRuntimeOutput = '→ Ok("compiled_and_executed")';
          }
          renderCurrentTargets();
        });
      }

      renderCurrentTargets();
    }
  }

  if (!customElements.get('vox-playground')) {
    customElements.define('vox-playground', VoxPlayground);
  }
</script>
