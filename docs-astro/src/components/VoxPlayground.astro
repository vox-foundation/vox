---
interface Props {
  initialCode?: string;
}
const { initialCode = `// One .vox file -> Runtime, SQL, Rust & TSX
table Task {
    title: str
    done:  bool
}

query get_tasks() to int {
    return len(db.Task.all())
}

tool "Done" complete_task(id: Id[Task]) to Result[str] {
    db.Task.delete(id)?
    return Ok("done")
}

component TaskBoard() {
    view: column(raw_class="task-card") {
        heading(level=3) { "Active Tasks" }
        text() { "Synchronized across SQL, Rust, and React" }
    }
}

fn main() to Result[str] {
    let id = db.Task.insert({ title: "Write Vox in browser", done: false })?
    print("Tasks queued: " + str(get_tasks()))
    let status = complete_task(id)?
    print("Tasks remaining: " + str(get_tasks()))
    return Ok(status)
}
` } = Astro.props;

const examples = [
  {
    id: 'tasks',
    label: '1. Full-Stack + MCP',
    summary: 'One .vox file declares a Turso table, server query, React UI component, and MCP agent tool.',
    code: initialCode.trim(),
    expectedOutput: `import voxlang.vox;\n// Sandbox: Tasks queued: 1 | Tasks remaining: 0 -> Ok("done")\n────────────────────────────────────────────────────────\nexport SQL (Turso) {\n  CREATE TABLE task (id PRIMARY KEY, title TEXT, done INT);\n}`,
  },
  {
    id: 'result',
    label: '2. Safe Errors (Result[T])',
    summary: 'Result[T] and ? replace null pointers and uncaught exceptions across server & client.',
    code: `// Functions that can fail return Result[T] — never null or hidden exceptions
table ServiceEndpoint {
    host: str
    port: int
}

query parse_port(raw: int) to Result[int] {
    if raw < 1024 {
        return Error("Port must be >= 1024 (got " + str(raw) + ")")
    }
    return Ok(raw)
}

component PortStatus() {
    view: text() { "Listening on :8080 (Verified)" }
}

fn main() to Result[str] {
    let port = parse_port(8080)?
    print("Listening on port: " + str(port))
    return Ok("healthy")
}`,
    expectedOutput: `Listening on port: 8080\n→ Ok("healthy")`,
  },
  {
    id: 'workflow',
    label: '3. Durable Workflow',
    summary: 'Activities and workflows journal each step to SQLite/Turso so crashes resume cleanly.',
    code: `// Activities are journaled steps; workflows orchestrate them durably
table OrderLedger {
    order_id: str
    amount_cents: int
    tx_hash: str
}

activity charge_card(amount_cents: int) to Result[str] {
    print("Charged " + str(amount_cents) + " cents")
    return Ok("tx_9f8a7b")
}

workflow checkout_order(amount_cents: int) to Result[str] {
    let receipt = charge_card(amount_cents)?
    print("Journaled receipt: " + receipt)
    return Ok(receipt)
}

tool "Execute a durable checkout order" run_checkout(amount_cents: int) to Result[str] {
    return checkout_order(amount_cents)
}

fn main() to Result[str] {
    return checkout_order(4900)
}`,
    expectedOutput: `Charged 4900 cents\nJournaled receipt: tx_9f8a7b\n→ Ok("tx_9f8a7b")`,
  },
];
---

<vox-playground data-initial-code={initialCode} data-examples={JSON.stringify(examples)}>
  <div class="vox-playground" id="try-it" data-testid="vox-compiler-playground">
    <div class="playground-header">
      <div class="playground-title-group">
        <span class="vox-dot">.vox</span>
        <span class="playground-title-text">Compiler Playground</span>
      </div>
      <div class="playground-header-controls">
        <div class="playground-tabs" role="tablist" aria-label="Vox code examples">
          {examples.map((ex, idx) => (
            <button
              type="button"
              role="tab"
              class={`playground-tab ${idx === 0 ? 'active' : ''}`}
              aria-selected={idx === 0 ? 'true' : 'false'}
              data-example-id={ex.id}
            >
              {ex.label}
            </button>
          ))}
        </div>
        <button type="button" class="copy-btn" aria-label="Copy Vox code">Copy</button>
        <button type="button" class="run-btn" aria-label="Run and Compile Vox code">▶ Run</button>
      </div>
    </div>

    <div class="playground-split-grid">
      <!-- Left Column: 1 .vox File -> 4 Targets Schematic + Line-Numbered Syntax Editor -->
      <div class="playground-left-pane">
        <div class="schematic-card" aria-label="1 .vox File to 4 Compiler Targets Interactive Map">
          <svg class="schematic-svg" viewBox="0 0 520 172" role="img" aria-label="One .vox file compiles to Runtime, SQL, Rust Axum, and TSX + MCP">
            <defs>
              <radialGradient id="glowCyan" cx="50%" cy="50%" r="60%">
                <stop offset="0%" stop-color="#22d3ee" stop-opacity="0.28" />
                <stop offset="100%" stop-color="#0b1322" stop-opacity="0.92" />
              </radialGradient>
              <radialGradient id="glowAmber" cx="50%" cy="50%" r="60%">
                <stop offset="0%" stop-color="#f59e0b" stop-opacity="0.26" />
                <stop offset="100%" stop-color="#171311" stop-opacity="0.92" />
              </radialGradient>
              <radialGradient id="glowRust" cx="50%" cy="50%" r="60%">
                <stop offset="0%" stop-color="#ea580c" stop-opacity="0.26" />
                <stop offset="100%" stop-color="#191210" stop-opacity="0.92" />
              </radialGradient>
              <radialGradient id="glowEmerald" cx="50%" cy="50%" r="60%">
                <stop offset="0%" stop-color="#10b981" stop-opacity="0.26" />
                <stop offset="100%" stop-color="#0d1917" stop-opacity="0.92" />
              </radialGradient>
            </defs>

            <text x="235" y="22" text-anchor="middle" fill="#cbd5e1" font-size="12.5" font-weight="600" font-family="Inter, sans-serif">
              1 <tspan fill="#38bdf8" font-family="monospace">.vox</tspan> File -&gt; 4 Targets
            </text>

            <!-- Folded-Corner Document Icon for 1 .vox -->
            <g class="schematic-node-source">
              <path
                d="M 56 54 H 96 L 112 70 V 126 Q 112 130 108 130 H 56 Q 52 130 52 126 V 58 Q 52 54 56 54 Z"
                fill="url(#glowCyan)"
                stroke="#22d3ee"
                stroke-width="1.6"
              />
              <path d="M 96 54 V 70 H 112" fill="none" stroke="#22d3ee" stroke-width="1.4" stroke-linejoin="round" />
              <text x="82" y="92" text-anchor="middle" fill="#f8fafc" font-size="13" font-weight="700" font-family="Inter, sans-serif">1</text>
              <text x="82" y="110" text-anchor="middle" fill="#bae6fd" font-size="12" font-weight="700" font-family="monospace">.vox</text>
            </g>

            <!-- Arrow Source -> Compiler -->
            <line x1="114" y1="94" x2="174" y2="94" stroke="#64748b" stroke-width="1.5" />
            <path d="M 169 90 L 176 94 L 169 98" fill="none" stroke="#94a3b8" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />

            <!-- Compiler Hub Box -->
            <g class="schematic-node-compiler">
              <rect x="180" y="58" width="84" height="72" rx="6" fill="#101827" stroke="#64748b" stroke-width="1.5" />
              <rect x="183" y="61" width="78" height="66" rx="4" fill="none" stroke="rgba(148, 163, 184, 0.22)" stroke-width="1" />
              <text x="222" y="90" text-anchor="middle" fill="#f8fafc" font-size="12.5" font-weight="700" font-family="monospace">.vox</text>
              <text x="222" y="107" text-anchor="middle" fill="#cbd5e1" font-size="11.5" font-family="Inter, sans-serif">Compiler</text>
            </g>

            <!-- Smooth Bezier Curves + Arrowheads to 4 Targets -->
            <path d="M 264 76 C 304 72, 320 35, 366 35" fill="none" stroke="#64748b" stroke-width="1.4" />
            <path d="M 361 31 L 368 35 L 361 39" fill="none" stroke="#94a3b8" stroke-width="1.4" stroke-linecap="round" />

            <path d="M 264 88 C 304 86, 320 74, 366 74" fill="none" stroke="#64748b" stroke-width="1.4" />
            <path d="M 361 70 L 368 74 L 361 78" fill="none" stroke="#94a3b8" stroke-width="1.4" stroke-linecap="round" />

            <path d="M 264 100 C 304 102, 320 113, 366 113" fill="none" stroke="#64748b" stroke-width="1.4" />
            <path d="M 361 109 L 368 113 L 361 117" fill="none" stroke="#94a3b8" stroke-width="1.4" stroke-linecap="round" />

            <path d="M 264 112 C 304 118, 320 151, 366 151" fill="none" stroke="#64748b" stroke-width="1.4" />
            <path d="M 361 147 L 368 151 L 361 155" fill="none" stroke="#94a3b8" stroke-width="1.4" stroke-linecap="round" />

            <!-- Target 1: Runtime -->
            <g class="schematic-target-btn active" data-target-tab="runtime" role="button" tabindex="0" aria-label="Show Runtime Output">
              <rect x="372" y="20" width="96" height="30" rx="6" fill="url(#glowCyan)" stroke="#22d3ee" stroke-width="1.5" />
              <text x="420" y="39" text-anchor="middle" fill="#f8fafc" font-size="12" font-weight="600" font-family="Inter, sans-serif">Runtime</text>
            </g>
            <!-- Target 2: SQL -->
            <g class="schematic-target-btn" data-target-tab="sql" role="button" tabindex="0" aria-label="Show Generated SQL (Turso)">
              <rect x="372" y="59" width="96" height="30" rx="6" fill="url(#glowAmber)" stroke="#f59e0b" stroke-width="1.5" />
              <text x="420" y="78" text-anchor="middle" fill="#fde68a" font-size="12" font-weight="600" font-family="Inter, sans-serif">SQL</text>
            </g>
            <!-- Target 3: Rust -->
            <g class="schematic-target-btn" data-target-tab="rust" role="button" tabindex="0" aria-label="Show Generated Rust (Axum)">
              <rect x="372" y="98" width="96" height="30" rx="6" fill="url(#glowRust)" stroke="#ea580c" stroke-width="1.5" />
              <text x="420" y="117" text-anchor="middle" fill="#fed7aa" font-size="12" font-weight="600" font-family="Inter, sans-serif">Rust</text>
            </g>
            <!-- Target 4: TSX & MCP Targets -->
            <g class="schematic-target-btn" data-target-tab="tsx" role="button" tabindex="0" aria-label="Show Generated TSX and MCP Schema">
              <rect x="372" y="136" width="96" height="30" rx="6" fill="url(#glowEmerald)" stroke="#10b981" stroke-width="1.5" />
              <text x="420" y="155" text-anchor="middle" fill="#a7f3d0" font-size="12" font-weight="600" font-family="Inter, sans-serif">Targets</text>
            </g>
          </svg>
        </div>

        <div class="editor-container">
          <div class="editor-file-bar">
            <span class="editor-file-tab">example.vox <span class="editor-close-dot">×</span></span>
            <div class="editor-window-actions" aria-hidden="true">
              <span class="editor-win-icon">◫</span>
              <span class="editor-win-icon">⋯</span>
            </div>
          </div>
          <div class="code-editor-shell">
            <div class="editor-line-gutter" aria-hidden="true">1&#10;2&#10;3&#10;4&#10;5&#10;6&#10;7&#10;8</div>
            <div class="editor-stage">
              <pre class="code-highlight-layer" aria-hidden="true"></pre>
              <textarea
                class="code-editor"
                spellcheck="false"
                aria-label="Vox Code Editor"
              >{examples[0].code}</textarea>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: Dual-Deck Compiler Output Panes matching Concept Art B -->
      <div class="playground-right-pane">
        <div class="target-tabs-bar" role="tablist" aria-label="Compiled target outputs">
          <button
            type="button"
            role="tab"
            class="target-tab active"
            aria-selected="true"
            data-target-id="runtime"
          >
            Runtime Output
          </button>
          <button
            type="button"
            role="tab"
            class="target-tab"
            aria-selected="false"
            data-target-id="sql"
          >
            Generated SQL (Turso)
          </button>
          <button
            type="button"
            role="tab"
            class="target-tab"
            aria-selected="false"
            data-target-id="rust"
          >
            Generated Rust (Axum)
          </button>
          <button
            type="button"
            role="tab"
            class="target-tab"
            aria-selected="false"
            data-target-id="tsx"
          >
            Generated TSX &amp; MCP Schema
          </button>
        </div>

        <div class="output-container">
          <pre class="output-display" data-testid="playground-target-output">{examples[0].expectedOutput}</pre>
        </div>

        <!-- Lower Deck: Line-Numbered Syntax-Highlighted Rust / TSX & MCP Pane -->
        <div class="secondary-target-preview">
          <div class="secondary-tabs-bar" role="tablist" aria-label="Secondary compiled target preview">
            <button type="button" role="tab" aria-selected="true" class="secondary-tab active" data-sec-target="rust">
              Generated Rust (Axum)
            </button>
            <button type="button" role="tab" aria-selected="false" class="secondary-tab" data-sec-target="tsx">
              Generated TSX &amp; MCP Schema
            </button>
            <span class="secondary-chevron" aria-hidden="true">⌄</span>
          </div>
          <div class="secondary-code-shell">
            <div class="secondary-line-gutter" aria-hidden="true">1&#10;2&#10;3&#10;4&#10;5&#10;6&#10;7&#10;8</div>
            <pre class="secondary-output-display" data-testid="playground-secondary-output"></pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</vox-playground>

<style>
  .vox-playground {
    border: 1px solid rgba(71, 85, 105, 0.48);
    border-radius: 0.75rem;
    overflow: hidden;
    margin: 1.15rem 0;
    background-color: #0b0f19;
    box-shadow: 0 18px 42px rgba(0, 0, 0, 0.55), inset 0 1px 0 rgba(255, 255, 255, 0.05);
  }

  .playground-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.65rem 1.1rem;
    background: linear-gradient(180deg, #111726 0%, #0c111d 100%);
    border-bottom: 1px solid rgba(71, 85, 105, 0.38);
  }

  .playground-title-group {
    display: inline-flex;
    align-items: baseline;
    gap: 0.42rem;
  }

  .vox-dot {
    font-family: var(--sl-font-mono, monospace);
    font-weight: 800;
    font-size: 1.2rem;
    color: #22d3ee;
    letter-spacing: -0.02em;
  }

  .playground-title-text {
    font-weight: 700;
    font-size: 1.18rem;
    color: #f8fafc;
    letter-spacing: -0.015em;
  }

  .playground-header-controls {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    flex-wrap: wrap;
  }

  .playground-tabs {
    display: flex;
    gap: 0.3rem;
  }

  .playground-tab {
    background: rgba(15, 23, 42, 0.65);
    color: #94a3b8;
    border: 1px solid rgba(71, 85, 105, 0.38);
    border-radius: 0.35rem;
    padding: 0.24rem 0.58rem;
    font-size: 0.71rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .playground-tab:hover {
    color: #f8fafc;
    border-color: rgba(34, 211, 238, 0.45);
  }

  .playground-tab.active {
    color: #bae6fd;
    background: rgba(34, 211, 238, 0.12);
    border-color: rgba(34, 211, 238, 0.55);
  }

  .copy-btn {
    background: rgba(15, 23, 42, 0.75);
    color: #94a3b8;
    border: 1px solid rgba(71, 85, 105, 0.4);
    border-radius: 0.35rem;
    padding: 0.24rem 0.58rem;
    font-size: 0.71rem;
    font-weight: 600;
    cursor: pointer;
  }

  .run-btn {
    background: linear-gradient(180deg, #22d3ee 0%, #06b6d4 100%);
    color: #041019;
    border: none;
    border-radius: 0.35rem;
    padding: 0.26rem 0.72rem;
    font-size: 0.73rem;
    font-weight: 700;
    cursor: pointer;
    box-shadow: 0 2px 10px rgba(34, 211, 238, 0.25);
  }

  .playground-split-grid {
    display: grid;
    grid-template-columns: 1fr;
  }

  @media (min-width: 960px) {
    .playground-split-grid {
      grid-template-columns: 1.02fr 1fr;
    }
  }

  .playground-left-pane {
    display: flex;
    flex-direction: column;
    border-right: 1px solid rgba(71, 85, 105, 0.35);
    background: #0a0e17;
  }

  .schematic-card {
    padding: 0.35rem 0.65rem 0.4rem;
    background: radial-gradient(circle at 50% 45%, rgba(30, 41, 59, 0.32) 0%, rgba(10, 14, 23, 0.98) 100%);
    border-bottom: 1px solid rgba(71, 85, 105, 0.35);
  }

  .schematic-svg {
    width: 100%;
    height: auto;
    max-height: 166px;
    display: block;
  }

  .schematic-target-btn {
    cursor: pointer;
    transition: opacity 0.15s ease;
  }

  .schematic-target-btn:hover {
    opacity: 0.92;
  }

  .schematic-target-btn.active rect {
    stroke-width: 2.2;
    filter: drop-shadow(0 0 8px rgba(34, 211, 238, 0.4));
  }

  .editor-container {
    display: flex;
    flex-direction: column;
    flex: 1;
    background: #080b13;
  }

  .editor-file-bar {
