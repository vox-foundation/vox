    color: #f8fafc;
  }

  .target-tab.active {
    color: #f8fafc;
    border-bottom-color: #e2e8f0;
  }

  .output-container {
    padding: 0.55rem 0.85rem;
    background: #080b13;
    border-bottom: 1px solid rgba(71, 85, 105, 0.35);
  }

  .output-display {
    margin: 0;
    padding: 0.35rem 0.25rem;
    min-height: 145px;
    max-height: 155px;
    overflow: auto;
    background: transparent;
    color: #cbd5e1;
    font-family: var(--font-mono, var(--sl-font-mono, monospace));
    font-size: 0.76rem;
    line-height: 1.52;
    white-space: pre-wrap;
    word-break: break-word;
