---
import presetsMeta from '../data/playground/presets.json';

// Real compiler output, captured with `vox build` / `vox run --interp` (see data/playground/README.md).
const raw = import.meta.glob('../data/playground/*/*', { query: '?raw', import: 'default', eager: true });

const fileFor = (id, name) => {
  const hit = Object.entries(raw).find(([path]) => path.endsWith(`/${id}/${name}`));
  return hit ? String(hit[1]) : '';
};

const TARGETS = [
  { id: 'runtime', label: 'Run output', file: 'runtime.txt' },
  { id: 'sql', label: 'SQL', file: 'sql.sql' },
  { id: 'rust', label: 'Rust server', file: 'rust.rs' },
  { id: 'client', label: 'TS client', file: 'client.ts' },
  { id: 'ui', label: 'React UI', file: 'ui.tsx' },
  { id: 'mcp', label: 'MCP tools', file: 'mcp.rs' },
];

const presets = presetsMeta.presets.map((p) => ({
  ...p,
  source: fileFor(p.id, 'source.vox').trim(),
  outputs: Object.fromEntries(TARGETS.map((t) => [t.id, fileFor(p.id, t.file).trimEnd()])),
}));

const payload = { presets, targets: TARGETS, capturedWith: presetsMeta.capturedWith, commands: presetsMeta.commands };
const first = presets[0];
---

<vox-playground data-playground={JSON.stringify(payload)}>
  <div class="vox-playground not-content" data-testid="vox-compiler-playground">
    <div class="playground-header">
      <div class="playground-title-group">
        <span class="vox-dot">.vox</span>
        <span class="playground-title-text">Compiler Playground</span>
      </div>
      <div class="playground-header-controls">
        <div class="playground-tabs" role="tablist" aria-label="Vox code examples">
          {presets.map((ex, idx) => (
            <button
              type="button"
              role="tab"
              class={`playground-tab ${idx === 0 ? 'active' : ''}`}
              aria-selected={idx === 0 ? 'true' : 'false'}
              data-example-id={ex.id}
            >
              {ex.label}
            </button>
          ))}
        </div>
        <button type="button" class="copy-btn" aria-label="Copy Vox code">Copy</button>
        <button type="button" class="reset-btn" aria-label="Reset the editor to the example" hidden>Reset</button>
      </div>
    </div>

    <div class="playground-split-grid">
      <div class="playground-left-pane">
        <div class="schematic-card" aria-label="AST to Compiler Targets Interactive Map">
          <svg class="schematic-svg" viewBox="0 0 520 172" role="img" aria-label="One .vox file produces run output, SQL, a Rust server, a TypeScript client, React UI and MCP tools">
            <defs>
              <radialGradient id="glowCyan" cx="50%" cy="50%" r="60%">
                <stop offset="0%" stop-color="#22d3ee" stop-opacity="0.28" />
                <stop offset="100%" stop-color="#0b1322" stop-opacity="0.92" />
              </radialGradient>
              <radialGradient id="glowAmber" cx="50%" cy="50%" r="60%">
                <stop offset="0%" stop-color="#f59e0b" stop-opacity="0.26" />
                <stop offset="100%" stop-color="#171311" stop-opacity="0.92" />
              </radialGradient>
              <radialGradient id="glowRust" cx="50%" cy="50%" r="60%">
                <stop offset="0%" stop-color="#ea580c" stop-opacity="0.26" />
                <stop offset="100%" stop-color="#191210" stop-opacity="0.92" />
              </radialGradient>
              <radialGradient id="glowEmerald" cx="50%" cy="50%" r="60%">
                <stop offset="0%" stop-color="#10b981" stop-opacity="0.26" />
                <stop offset="100%" stop-color="#0d1917" stop-opacity="0.92" />
              </radialGradient>
            </defs>

            <text x="235" y="22" text-anchor="middle" fill="#cbd5e1" font-size="12.5" font-weight="600" font-family="Inter, sans-serif">
              <tspan fill="#38bdf8" font-family="monospace">.vox</tspan> AST -&gt; Compiler Targets
            </text>

            <!-- Folded-Corner Document Icon for .vox -->
            <g class="schematic-node-source">
              <path
                d="M 56 54 H 96 L 112 70 V 126 Q 112 130 108 130 H 56 Q 52 130 52 126 V 58 Q 52 54 56 54 Z"
                fill="url(#glowCyan)"
                stroke="#22d3ee"
                stroke-width="1.6"
              />
              <path d="M 96 54 V 70 H 112" fill="none" stroke="#22d3ee" stroke-width="1.4" stroke-linejoin="round" />
              <text x="82" y="92" text-anchor="middle" fill="#f8fafc" font-size="12" font-weight="700" font-family="Inter, sans-serif">src</text>
              <text x="82" y="110" text-anchor="middle" fill="#bae6fd" font-size="12" font-weight="700" font-family="monospace">.vox</text>
            </g>

            <!-- Arrow Source -> Compiler -->
            <line x1="114" y1="94" x2="174" y2="94" stroke="#64748b" stroke-width="1.5" />
            <path d="M 169 90 L 176 94 L 169 98" fill="none" stroke="#94a3b8" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />

            <!-- Compiler Hub Box -->
            <g class="schematic-node-compiler">
              <rect x="180" y="58" width="84" height="72" rx="6" fill="#101827" stroke="#64748b" stroke-width="1.5" />
              <rect x="183" y="61" width="78" height="66" rx="4" fill="none" stroke="rgba(148, 163, 184, 0.22)" stroke-width="1" />
              <text x="222" y="90" text-anchor="middle" fill="#f8fafc" font-size="12.5" font-weight="700" font-family="monospace">.vox</text>
              <text x="222" y="107" text-anchor="middle" fill="#cbd5e1" font-size="11.5" font-family="Inter, sans-serif">Compiler</text>
            </g>

            <!-- Smooth Bezier Curves + Arrowheads to 4 Targets -->
            <path d="M 264 76 C 304 72, 320 35, 366 35" fill="none" stroke="#64748b" stroke-width="1.4" />
            <path d="M 361 31 L 368 35 L 361 39" fill="none" stroke="#94a3b8" stroke-width="1.4" stroke-linecap="round" />

            <path d="M 264 88 C 304 86, 320 74, 366 74" fill="none" stroke="#64748b" stroke-width="1.4" />
            <path d="M 361 70 L 368 74 L 361 78" fill="none" stroke="#94a3b8" stroke-width="1.4" stroke-linecap="round" />

            <path d="M 264 100 C 304 102, 320 113, 366 113" fill="none" stroke="#64748b" stroke-width="1.4" />
            <path d="M 361 109 L 368 113 L 361 117" fill="none" stroke="#94a3b8" stroke-width="1.4" stroke-linecap="round" />

            <path d="M 264 112 C 304 118, 320 151, 366 151" fill="none" stroke="#64748b" stroke-width="1.4" />
            <path d="M 361 147 L 368 151 L 361 155" fill="none" stroke="#94a3b8" stroke-width="1.4" stroke-linecap="round" />

            <!-- Target 1: Runtime -->
            <g class="schematic-target-btn active" data-target-tab="runtime" role="button" tabindex="0" aria-label="Show Runtime Output">
              <rect x="372" y="20" width="96" height="30" rx="6" fill="url(#glowCyan)" stroke="#22d3ee" stroke-width="1.5" />
              <text x="420" y="39" text-anchor="middle" fill="#f8fafc" font-size="12" font-weight="600" font-family="Inter, sans-serif">Runtime</text>
            </g>
            <!-- Target 2: SQL -->
            <g class="schematic-target-btn" data-target-tab="sql" role="button" tabindex="0" aria-label="Show Generated SQL (Turso)">
              <rect x="372" y="59" width="96" height="30" rx="6" fill="url(#glowAmber)" stroke="#f59e0b" stroke-width="1.5" />
              <text x="420" y="78" text-anchor="middle" fill="#fde68a" font-size="12" font-weight="600" font-family="Inter, sans-serif">SQL</text>
            </g>
            <!-- Target 3: Rust -->
            <g class="schematic-target-btn" data-target-tab="rust" role="button" tabindex="0" aria-label="Show Generated Rust (Axum)">
              <rect x="372" y="98" width="96" height="30" rx="6" fill="url(#glowRust)" stroke="#ea580c" stroke-width="1.5" />
              <text x="420" y="117" text-anchor="middle" fill="#fed7aa" font-size="12" font-weight="600" font-family="Inter, sans-serif">Rust</text>
            </g>
            <!-- Target 4: TSX & MCP Targets -->
            <g class="schematic-target-btn" data-target-tab="client" role="button" tabindex="0" aria-label="Show the generated TypeScript client, React UI and MCP tools">
              <rect x="372" y="136" width="96" height="30" rx="6" fill="url(#glowEmerald)" stroke="#10b981" stroke-width="1.5" />
              <text x="420" y="155" text-anchor="middle" fill="#a7f3d0" font-size="12" font-weight="600" font-family="Inter, sans-serif">Client, UI, MCP</text>
            </g>
          </svg>
        </div>

        <div class="editor-container">
          <div class="editor-file-bar">
            <span class="editor-file-tab">main.vox <span class="editor-close-dot">×</span></span>
            <div class="editor-window-actions" aria-hidden="true">
              <span class="editor-win-icon">◫</span>
              <span class="editor-win-icon">⋯</span>
            </div>
          </div>
          <div class="code-editor-shell">
            <div class="editor-line-gutter" aria-hidden="true">1&#10;2&#10;3&#10;4&#10;5&#10;6&#10;7&#10;8</div>
            <div class="editor-stage">
              <pre class="code-highlight-layer" aria-hidden="true"></pre>
              <textarea
                class="code-editor"
                spellcheck="false"
                aria-label="Vox Code Editor"
              >{first.source}</textarea>
            </div>
          </div>
        </div>
        <p class="preset-summary" data-testid="playground-summary">{first.summary}</p>
      </div>

      <div class="playground-right-pane">
        <div class="target-tabs-bar" role="tablist" aria-label="What the compiler produces from this file">
          {[
            { id: 'runtime', label: 'Run output' },
            { id: 'sql', label: 'SQL' },
            { id: 'rust', label: 'Rust server' },
            { id: 'client', label: 'TS client' },
            { id: 'ui', label: 'React UI' },
            { id: 'mcp', label: 'MCP tools' },
          ].map((t, i) => (
            <button
              type="button"
              role="tab"
              class={`target-tab ${i === 0 ? 'active' : ''}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? 0 : -1}
              data-target-id={t.id}
            >
              {t.label}
            </button>
          ))}
        </div>

        <p class="output-provenance" data-testid="playground-provenance" role="status"></p>
        <div class="output-container">
          <pre class="output-display" data-testid="playground-target-output" tabindex="0"></pre>
        </div>
        <p class="output-note" data-testid="playground-note"></p>

        <div class="flow-block">
          <p class="flow-title">How a request travels</p>
          <ol class="flow-strip" data-testid="playground-flow"></ol>
        </div>
      </div>
    </div>
  </div>
</vox-playground>

<style>
  .vox-playground {
    border: 1px solid rgba(71, 85, 105, 0.48);
    border-radius: 0.75rem;
    overflow: hidden;
    margin: 1.15rem 0;
    background-color: #0b0f19;
    box-shadow: 0 18px 42px rgba(0, 0, 0, 0.55), inset 0 1px 0 rgba(255, 255, 255, 0.05);
  }

  .vox-playground button {
    margin: 0;
    font-family: inherit;
    box-sizing: border-box;
  }

  .playground-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.65rem 1.1rem;
    background: linear-gradient(180deg, #111726 0%, #0c111d 100%);
    border-bottom: 1px solid rgba(71, 85, 105, 0.38);
    flex-wrap: wrap;
  }

  .playground-title-group {
    display: inline-flex;
    align-items: center;
    gap: 0.42rem;
  }

  .vox-dot {
    font-family: var(--sl-font-mono, monospace);
    font-weight: 800;
    font-size: 1.2rem;
    color: #22d3ee;
    letter-spacing: -0.02em;
  }

  .playground-title-text {
    font-weight: 700;
    font-size: 1.18rem;
    color: #f8fafc;
    letter-spacing: -0.015em;
  }

  .playground-header-controls {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    flex-wrap: wrap;
  }

  .playground-tabs {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    flex-wrap: wrap;
  }

  .playground-tab {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 28px;
    background: rgba(15, 23, 42, 0.65);
    color: #94a3b8;
    border: 1px solid rgba(71, 85, 105, 0.38);
    border-radius: 0.35rem;
    padding: 0 0.62rem;
    font-size: 0.71rem;
    font-weight: 600;
    line-height: 1;
    white-space: nowrap;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .playground-tab:hover {
    color: #f8fafc;
    border-color: rgba(34, 211, 238, 0.45);
  }

  .playground-tab.active {
    color: #bae6fd;
    background: rgba(34, 211, 238, 0.12);
    border-color: rgba(34, 211, 238, 0.55);
  }

  .copy-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 28px;
    background: rgba(15, 23, 42, 0.75);
    color: #cbd5e1;
    border: 1px solid rgba(71, 85, 105, 0.45);
    border-radius: 0.35rem;
    padding: 0 0.65rem;
    font-size: 0.71rem;
    font-weight: 600;
    line-height: 1;
    white-space: nowrap;
    cursor: pointer;
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .copy-btn:hover {
    color: #f8fafc;
    border-color: rgba(34, 211, 238, 0.45);
  }

  .run-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 28px;
    background: linear-gradient(180deg, #22d3ee 0%, #06b6d4 100%);
    color: #041019;
    border: 1px solid transparent;
    border-radius: 0.35rem;
    padding: 0 0.75rem;
    font-size: 0.72rem;
    font-weight: 700;
    line-height: 1;
    white-space: nowrap;
    cursor: pointer;
    box-shadow: 0 2px 10px rgba(34, 211, 238, 0.25);
  }

  .run-btn:hover {
    filter: brightness(1.06);
  }

  .playground-split-grid {
    display: grid;
    grid-template-columns: 1fr;
  }

  @media (min-width: 960px) {
    .playground-split-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.06fr);
    }
  }

  .playground-left-pane {
    display: flex;
    flex-direction: column;
    min-width: 0;
    margin: 0;
    border-right: 1px solid rgba(71, 85, 105, 0.35);
    background: #0a0e17;
  }

  .schematic-card {
    padding: 0.35rem 0.65rem 0.4rem;
    background: radial-gradient(circle at 50% 45%, rgba(30, 41, 59, 0.32) 0%, rgba(10, 14, 23, 0.98) 100%);
    border-bottom: 1px solid rgba(71, 85, 105, 0.35);
  }

  .schematic-svg {
    width: 100%;
    height: auto;
    max-height: 166px;
    display: block;
  }

  .schematic-target-btn {
    cursor: pointer;
    transition: opacity 0.15s ease;
  }

  .schematic-target-btn:hover {
    opacity: 0.92;
  }

  .schematic-target-btn.active rect {
    stroke-width: 2.2;
    filter: drop-shadow(0 0 8px rgba(34, 211, 238, 0.4));
  }

  .editor-container {
    display: flex;
    flex-direction: column;
    flex: 1;
    background: #080b13;
  }

  .editor-file-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 0.75rem 0 0;
    background: #0d121d;
    border-bottom: 1px solid rgba(71, 85, 105, 0.35);
    font-size: 0.76rem;
    height: 34px;
  }

  .editor-file-tab {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    height: 100%;
    padding: 0 0.9rem;
    color: #e2e8f0;
    font-weight: 500;
    background: #080b13;
    border-right: 1px solid rgba(71, 85, 105, 0.35);
    border-top: 2px solid #22d3ee;
  }

  .editor-close-dot {
    color: #64748b;
    font-size: 0.85rem;
  }

  .editor-window-actions {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: #64748b;
    font-size: 0.82rem;
  }

  .code-editor-shell {
    position: relative;
    display: grid;
    grid-template-columns: 34px 1fr;
    min-height: 210px;
    max-height: 230px;
    overflow: hidden;
    background: #080b13;
  }

  .editor-line-gutter {
    padding: 0.7rem 0.4rem 0.7rem 0;
    text-align: right;
    color: #475569;
    font-family: var(--font-mono, var(--sl-font-mono, monospace));
    font-size: 0.76rem;
    line-height: 1.52;
    user-select: none;
    background: #080b13;
    border-right: 1px solid rgba(51, 65, 85, 0.25);
    white-space: pre;
  }

  .editor-stage {
    position: relative;
    min-height: 210px;
    overflow: auto;
  }

  .code-highlight-layer,
  .code-editor {
    margin: 0;
    padding: 0.7rem 0.85rem;
    font-family: var(--font-mono, var(--sl-font-mono, monospace));
    font-size: 0.76rem;
    line-height: 1.52;
    tab-size: 4;
    white-space: pre;
    box-sizing: border-box;
    width: 100%;
    min-height: 210px;
  }

  .code-highlight-layer {
    pointer-events: none;
    color: #e2e8f0;
    overflow: hidden;
  }

  .code-editor {
    position: absolute;
    inset: 0;
    height: 100%;
    background: transparent;
    color: transparent;
    caret-color: #22d3ee;
    border: none;
    resize: none;
    outline: none;
    overflow: auto;
  }

  .playground-right-pane {
    display: flex;
    flex-direction: column;
    min-width: 0;
    margin: 0;
    background: #0a0e17;
  }

  .target-tabs-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    gap: 0.1rem 0.25rem;
    padding: 0 0.55rem;
    min-height: 36px;
    background: #0d121d;
    border-bottom: 1px solid rgba(71, 85, 105, 0.35);
  }

  .target-tab {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    color: #94a3b8;
    border: none;
    border-bottom: 2px solid transparent;
    min-height: 34px;
    padding: 0 0.52rem;
    font-size: 0.72rem;
    font-weight: 600;
    line-height: 1;
    white-space: nowrap;
    margin: 0;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .target-tab:hover {
    color: #f8fafc;
  }

  .target-tab.active {
    color: #f8fafc;
    border-bottom-color: #e2e8f0;
  }


  .target-tab:focus-visible,
  .playground-tab:focus-visible,
  .output-display:focus-visible {
    outline: 2px solid #38bdf8;
    outline-offset: -2px;
  }

  .output-container {
    padding: 0.4rem 0.85rem;
    background: #080b13;
    border-bottom: 1px solid rgba(71, 85, 105, 0.35);
  }

  .output-display {
    margin: 0;
    padding: 0.35rem 0.25rem;
    min-height: 200px;
    max-height: 300px;
    overflow: auto;
    background: transparent;
    color: #cbd5e1;
    font-family: var(--font-mono, var(--sl-font-mono, monospace));
    font-size: 0.76rem;
    line-height: 1.52;
    white-space: pre;
  }

  .output-provenance {
    margin: 0;
    padding: 0.4rem 0.85rem;
    font-size: 0.72rem;
    line-height: 1.4;
    color: #94a3b8;
    background: #0d121d;
    border-bottom: 1px solid rgba(71, 85, 105, 0.3);
  }

  .output-provenance.is-edited {
    color: #fde68a;
    background: rgba(120, 83, 9, 0.28);
  }

  .output-note {
    margin: 0;
    padding: 0.6rem 0.9rem;
    font-size: 0.8rem;
    line-height: 1.55;
    color: #cbd5e1;
    border-bottom: 1px solid rgba(71, 85, 105, 0.3);
  }

  .preset-summary {
    margin: 0;
    padding: 0.55rem 0.9rem 0.7rem;
    font-size: 0.8rem;
    line-height: 1.5;
    color: #94a3b8;
  }

  .flow-block {
    padding: 0.55rem 0.9rem 0.8rem;
  }

  .flow-title {
    margin: 0 0 0.35rem;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #64748b;
  }

  .flow-strip {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.3rem;
  }

  .flow-strip :global(li) {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: baseline;
    gap: 0.45rem;
    font-size: 0.74rem;
    line-height: 1.4;
    color: #cbd5e1;
  }

  .flow-strip :global(code) {
    font-family: var(--font-mono, var(--sl-font-mono, monospace));
    font-size: 0.72rem;
    color: #e2e8f0;
    overflow-wrap: anywhere;
  }

  .flow-strip :global(.flow-arrow) {
    color: #38bdf8;
  }

  .flow-strip :global(.flow-why) {
    grid-column: 1 / -1;
    padding-left: 0.2rem;
    font-size: 0.7rem;
    color: #64748b;
  }

  .reset-btn {
    background: transparent;
    color: #fde68a;
    border: 1px solid rgba(251, 191, 36, 0.45);
    border-radius: 0.35rem;
    padding: 0.25rem 0.6rem;
    font-size: 0.74rem;
    font-weight: 600;
    cursor: pointer;
  }

  .reset-btn[hidden] {
    display: none;
  }

  /* Syntax Highlighting Token Palette (Concept Art B IDE Theme) */
  :global(.tok-kw) {
    color: #38bdf8;
    font-weight: 600;
  }
  :global(.tok-type) {
    color: #a78bfa;
  }
  :global(.tok-str) {
    color: #fb923c;
  }
  :global(.tok-prop) {
    color: #34d399;
  }
  :global(.tok-fn) {
    color: #60a5fa;
  }
  :global(.tok-num) {
    color: #fbbf24;
  }
  :global(.tok-comment) {
    color: #64748b;
    font-style: italic;
  }
  :global(.tok-rule) {
    display: block;
    border-bottom: 1px solid rgba(71, 85, 105, 0.35);
    margin: 0.35rem 0;
  }
</style>

<script>
  function escapeHtml(raw) {
    return String(raw)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;');
  }

  function highlightLine(line) {
    const trimmed = line.trim();
    if (trimmed.startsWith('────')) {
      return `<span class="tok-rule"></span>`;
    }
    if (trimmed.startsWith('//') || trimmed.startsWith('--') || trimmed.startsWith('#[')) {
      return `<span class="tok-comment">${escapeHtml(line)}</span>`;
    }
    const tokenRe = /("(?:[^"\\]|\\.)*"|'(?:[^'\\]|\\.)*')|\b(import|export|table|query|mutation|tool|component|activity|workflow|fn|let|return|to|if|pub|struct|use|async|CREATE|TABLE|IF|NOT|EXISTS|PRIMARY|KEY|AUTOINCREMENT|INDEX|ON|DELETE|FROM|WHERE|SELECT|COUNT|INTEGER|TEXT|REAL|NULL)\b|\b(Result|Ok|Error|Id|Task|TaskRow|ServiceEndpoint|OrderLedger|Router|AppState|Json|Serialize|Deserialize|JSX|Element|str|int|bool|i64|f64|String|Turso)\b|\b([a-z_][A-Za-z0-9_]*)(?=\s*:)|\b([a-z_][A-Za-z0-9_]*)(?=\s*\()|\b(\d+)\b/g;
    let out = '';
    let lastIdx = 0;
    let m;
    while ((m = tokenRe.exec(line)) !== null) {
      if (m.index > lastIdx) {
        out += escapeHtml(line.slice(lastIdx, m.index));
      }
      if (m[1]) {
        out += `<span class="tok-str">${escapeHtml(m[1])}</span>`;
      } else if (m[2]) {
        out += `<span class="tok-kw">${escapeHtml(m[2])}</span>`;
      } else if (m[3]) {
        out += `<span class="tok-type">${escapeHtml(m[3])}</span>`;
      } else if (m[4]) {
        out += `<span class="tok-prop">${escapeHtml(m[4])}</span>`;
      } else if (m[5]) {
        out += `<span class="tok-fn">${escapeHtml(m[5])}</span>`;
      } else if (m[6]) {
        out += `<span class="tok-num">${escapeHtml(m[6])}</span>`;
      }
      lastIdx = tokenRe.lastIndex;
    }
    if (lastIdx < line.length) {
      out += escapeHtml(line.slice(lastIdx));
    }
    return out;
  }

  function highlightCodeBlock(code) {
    return String(code)
      .split(/\r?\n/)
      .map((line) => highlightLine(line))
      .join('\n');
  }

  function buildLineGutter(code, minLines) {
    const count = Math.max(minLines || 8, String(code).split(/\r?\n/).length);
    const nums = [];
    for (let i = 1; i <= count; i++) nums.push(i);
    return nums.join('\n');
  }

  class VoxPlayground extends HTMLElement {
    constructor() {
      super();
      let data = { presets: [], targets: [], capturedWith: '', commands: {} };
      try {
        data = JSON.parse(this.dataset.playground || '{}');
      } catch (e) {}

      const presets = data.presets || [];
      const editor = this.querySelector('.code-editor');
      const highlightLayer = this.querySelector('.code-highlight-layer');
      const editorGutter = this.querySelector('.editor-line-gutter');
      const copyBtn = this.querySelector('.copy-btn');
      const resetBtn = this.querySelector('.reset-btn');
      const outputDisplay = this.querySelector('.output-display');
      const provenance = this.querySelector('.output-provenance');
      const noteEl = this.querySelector('.output-note');
      const summaryEl = this.querySelector('.preset-summary');
      const flowEl = this.querySelector('.flow-strip');
      const presetTabs = Array.from(this.querySelectorAll('.playground-tab'));
      const targetTabs = Array.from(this.querySelectorAll('.target-tab'));
      const schematicNodes = Array.from(this.querySelectorAll('.schematic-target-btn'));

      let active = presets[0];
      let activeTarget = 'runtime';

      const targetLabel = (id) => (data.targets.find((t) => t.id === id) || {}).label || id;

      const isEdited = () => !!editor && !!active && editor.value.trim() !== active.source;

      const renderEditor = () => {
        if (!editor) return;
        if (highlightLayer) highlightLayer.innerHTML = highlightCodeBlock(editor.value);
        if (editorGutter) editorGutter.textContent = buildLineGutter(editor.value, 9);
      };

      const renderFlow = () => {
        if (!flowEl || !active) return;
        flowEl.textContent = '';
        for (const step of active.flow || []) {
          const li = document.createElement('li');
          const from = document.createElement('code');
          from.textContent = step.from;
          const arrow = document.createElement('span');
          arrow.className = 'flow-arrow';
          arrow.setAttribute('aria-hidden', 'true');
          arrow.textContent = '→';
          const to = document.createElement('code');
          to.textContent = step.to;
          const why = document.createElement('span');
          why.className = 'flow-why';
          why.textContent = step.note;
          li.append(from, arrow, to, why);
          flowEl.appendChild(li);
        }
      };

      const renderOutput = () => {
        if (!active || !outputDisplay) return;
        const text = (active.outputs || {})[activeTarget];
        const edited = isEdited();
        if (text) {
          outputDisplay.innerHTML = highlightCodeBlock(text);
        } else {
          outputDisplay.textContent = `Nothing is emitted for ${targetLabel(activeTarget)} from this file.`;
        }
        if (noteEl) noteEl.textContent = (active.notes || {})[activeTarget] || '';
        if (provenance) {
          provenance.classList.toggle('is-edited', edited);
          const cmd = activeTarget === 'runtime' ? data.commands.runtime : data.commands.build;
          provenance.textContent = edited
            ? `You have edited the code. The browser cannot run the compiler, so this is still the real output for the original example. Run \`${cmd}\` on your file to see yours.`
            : text
              ? `Real output of \`${cmd}\` for this example (${data.capturedWith}).`
              : `\`${cmd}\` produced nothing for this example (${data.capturedWith}).`;
        }
        if (resetBtn) resetBtn.hidden = !edited;
      };

      const selectTarget = (targetId, focus) => {
        activeTarget = targetId;
        targetTabs.forEach((btn) => {
          const isMatch = btn.dataset.targetId === targetId;
          btn.classList.toggle('active', isMatch);
          btn.setAttribute('aria-selected', isMatch ? 'true' : 'false');
          btn.tabIndex = isMatch ? 0 : -1;
          if (isMatch && focus) btn.focus();
        });
        const schematicId = targetId === 'runtime' || targetId === 'sql' || targetId === 'rust' ? targetId : 'client';
        schematicNodes.forEach((node) => {
          node.classList.toggle('active', node.dataset.targetTab === schematicId);
        });
        renderOutput();
      };

      const selectPreset = (id) => {
        const found = presets.find((p) => p.id === id);
        if (!found) return;
        active = found;
        presetTabs.forEach((t) => {
          const isMatch = t.dataset.exampleId === id;
          t.classList.toggle('active', isMatch);
          t.setAttribute('aria-selected', isMatch ? 'true' : 'false');
        });
        if (editor) editor.value = found.source;
        if (summaryEl) summaryEl.textContent = found.summary;
        renderEditor();
        renderFlow();
        renderOutput();
      };

      // Roving-tabindex arrow-key navigation for a tablist.
      const bindArrowKeys = (tabs, onSelect) => {
        tabs.forEach((btn, i) => {
          btn.addEventListener('keydown', (ev) => {
            let next = -1;
            if (ev.key === 'ArrowRight') next = (i + 1) % tabs.length;
            else if (ev.key === 'ArrowLeft') next = (i - 1 + tabs.length) % tabs.length;
            else if (ev.key === 'Home') next = 0;
            else if (ev.key === 'End') next = tabs.length - 1;
            if (next < 0) return;
            ev.preventDefault();
            onSelect(tabs[next]);
          });
        });
      };

      targetTabs.forEach((btn) => {
        btn.addEventListener('click', () => selectTarget(btn.dataset.targetId || 'runtime', false));
      });
      bindArrowKeys(targetTabs, (btn) => selectTarget(btn.dataset.targetId || 'runtime', true));

      presetTabs.forEach((tab) => {
        tab.addEventListener('click', () => selectPreset(tab.dataset.exampleId));
      });
      bindArrowKeys(presetTabs, (tab) => {
        selectPreset(tab.dataset.exampleId);
        tab.focus();
      });

      schematicNodes.forEach((node) => {
        const go = () => {
          const t = node.dataset.targetTab || 'runtime';
          selectTarget(t, false);
        };
        node.addEventListener('click', go);
        node.addEventListener('keydown', (ev) => {
          if (ev.key === 'Enter' || ev.key === ' ') {
            ev.preventDefault();
            go();
          }
        });
      });

      if (editor) {
        editor.addEventListener('input', () => {
          renderEditor();
          renderOutput();
        });
        editor.addEventListener('scroll', () => {
          if (highlightLayer) {
            highlightLayer.scrollTop = editor.scrollTop;
            highlightLayer.scrollLeft = editor.scrollLeft;
          }
          if (editorGutter) editorGutter.scrollTop = editor.scrollTop;
        });
      }

      if (resetBtn) {
        resetBtn.addEventListener('click', () => {
          if (active) selectPreset(active.id);
        });
      }

      if (copyBtn && editor) {
        copyBtn.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(editor.value);
            copyBtn.textContent = '✓ Copied';
            setTimeout(() => {
              copyBtn.textContent = 'Copy';
            }, 1500);
          } catch (e) {}
        });
      }

      renderEditor();
      renderFlow();
      renderOutput();
    }
  }

  if (!customElements.get('vox-playground')) {
    customElements.define('vox-playground', VoxPlayground);
  }
</script>
