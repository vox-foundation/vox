    justify-content: space-between;
    padding: 0 0.75rem 0 0;
    background: #0d121d;
    border-bottom: 1px solid rgba(71, 85, 105, 0.35);
    font-size: 0.76rem;
    height: 34px;
  }

  .editor-file-tab {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    height: 100%;
    padding: 0 0.9rem;
    color: #e2e8f0;
    font-weight: 500;
    background: #080b13;
    border-right: 1px solid rgba(71, 85, 105, 0.35);
    border-top: 2px solid #22d3ee;
  }

  .editor-close-dot {
    color: #64748b;
    font-size: 0.85rem;
  }

  .editor-window-actions {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: #64748b;
    font-size: 0.82rem;
  }

  .code-editor-shell {
    position: relative;
    display: grid;
    grid-template-columns: 34px 1fr;
    min-height: 210px;
    max-height: 230px;
    overflow: hidden;
    background: #080b13;
  }

  .editor-line-gutter,
  .secondary-line-gutter {
    padding: 0.7rem 0.4rem 0.7rem 0;
    text-align: right;
    color: #475569;
    font-family: var(--font-mono, var(--sl-font-mono, monospace));
    font-size: 0.76rem;
    line-height: 1.52;
    user-select: none;
    background: #080b13;
    border-right: 1px solid rgba(51, 65, 85, 0.25);
    white-space: pre;
  }

  .editor-stage {
    position: relative;
    min-height: 210px;
    overflow: auto;
  }

  .code-highlight-layer,
  .code-editor {
    margin: 0;
    padding: 0.7rem 0.85rem;
    font-family: var(--font-mono, var(--sl-font-mono, monospace));
    font-size: 0.76rem;
    line-height: 1.52;
    tab-size: 4;
    white-space: pre;
    box-sizing: border-box;
    width: 100%;
    min-height: 210px;
  }

  .code-highlight-layer {
    pointer-events: none;
    color: #e2e8f0;
    overflow: hidden;
  }

  .code-editor {
    position: absolute;
    inset: 0;
    height: 100%;
    background: transparent;
    color: transparent;
    caret-color: #22d3ee;
    border: none;
    resize: none;
    outline: none;
    overflow: auto;
  }

  .playground-right-pane {
    display: flex;
    flex-direction: column;
    background: #0a0e17;
  }

  .target-tabs-bar {
    display: flex;
    align-items: center;
    gap: 0.15rem;
    padding: 0 0.65rem;
    height: 36px;
    background: #0d121d;
    border-bottom: 1px solid rgba(71, 85, 105, 0.35);
    overflow-x: auto;
  }

