---
import type { Props } from '@astrojs/starlight/props';
import Default from '@astrojs/starlight/components/PageSidebar.astro';
---

<button
  id="vox-toc-restore-btn"
  type="button"
  aria-label="Show table of contents"
  aria-expanded="false"
  title="Show table of contents"
>
  <svg viewBox="0 0 24 24" aria-hidden="true">
    <line x1="21" y1="10" x2="3" y2="10" />
    <line x1="21" y1="6" x2="3" y2="6" />
    <line x1="21" y1="14" x2="3" y2="14" />
    <line x1="21" y1="18" x2="7" y2="18" />
  </svg>
  <span class="vox-toc-restore-label">On this page</span>
</button>

<Default {...Astro.props}><slot /></Default>

<script is:inline>
  (function() {
    function initTocRestore() {
      var btn = document.getElementById('vox-toc-restore-btn');
      if (!btn) return;
      var hideBtn = document.getElementById('vox-toc-hide-btn');
      var isHidden = document.documentElement.dataset.tocState === 'hidden';
      btn.setAttribute('aria-expanded', isHidden ? 'false' : 'true');

      if (btn.dataset.voxBound === 'true') return;
      btn.dataset.voxBound = 'true';

      btn.addEventListener('click', function() {
        document.documentElement.dataset.tocState = 'visible';
        btn.setAttribute('aria-expanded', 'true');
        if (hideBtn) hideBtn.setAttribute('aria-expanded', 'true');
        try {
          localStorage.setItem('vox-toc-state', 'visible');
        } catch (e) {}
      });
    }

    function initMermaidDiagrams() {
      var blocks = document.querySelectorAll('pre[data-language="mermaid"], pre > code.language-mermaid');
      if (!blocks || blocks.length === 0) return;

      import('https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs')
        .then(function(mod) {
          var mermaid = mod.default;
          var isLight = document.documentElement.dataset.theme === 'light';
          mermaid.initialize({
            startOnLoad: false,
            securityLevel: 'strict',
            theme: isLight ? 'neutral' : 'dark',
          });
          blocks.forEach(function(node, idx) {
            var pre = node.tagName === 'PRE' ? node : node.parentElement;
            if (!pre || pre.dataset.mermaidProcessed === 'true') return;
            pre.dataset.mermaidProcessed = 'true';
            var source = (pre.textContent || '').trim();
            if (!source) return;
            var wrapper = pre.closest('.expressive-code') || pre;
            var container = document.createElement('div');
            container.className = 'vox-mermaid-diagram';
            var renderId = 'vox-mermaid-svg-' + idx + '-' + Math.random().toString(36).slice(2, 7);
            mermaid.render(renderId, source)
              .then(function(res) {
                container.innerHTML = res.svg;
                wrapper.parentNode.insertBefore(container, wrapper);
                wrapper.style.display = 'none';
              })
              .catch(function() {
                // Keep clean code block visible on parse/render failure
              });
          });
        })
        .catch(function() {
          // Offline or CDN blocked: keep expressive-code mermaid block intact
        });
    }

    function initAll() {
      initTocRestore();
      initMermaidDiagrams();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAll);
    } else {
      initAll();
    }
    document.addEventListener('astro:page-load', initAll);
  })();
</script>
