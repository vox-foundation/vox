---
import type { Props } from '@astrojs/starlight/props';
import Default from '@astrojs/starlight/components/PageSidebar.astro';
---

<button
  id="vox-toc-edge"
  class="vox-edge-toggle"
  type="button"
  aria-label="Hide table of contents"
  aria-expanded="true"
  title="Hide table of contents"
>
  <svg class="vox-edge-icon-close" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M9 6 L15 12 L9 18" />
  </svg>
  <svg class="vox-edge-icon-open" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M15 6 L9 12 L15 18" />
  </svg>
</button>

<Default {...Astro.props}><slot /></Default>

<script is:inline>
  (function() {
    function initTocEdge() {
      var btn = document.getElementById('vox-toc-edge');
      if (!btn) return;

      function updateAria(state) {
        var hidden = state === 'hidden';
        btn.setAttribute('aria-expanded', hidden ? 'false' : 'true');
        btn.setAttribute('aria-label', hidden ? 'Show table of contents' : 'Hide table of contents');
        btn.setAttribute('title', hidden ? 'Show table of contents' : 'Hide table of contents');
      }

      updateAria(document.documentElement.dataset.tocState || 'visible');

      if (btn.dataset.voxBound === 'true') return;
      btn.dataset.voxBound = 'true';

      btn.addEventListener('click', function() {
        var hidden = document.documentElement.dataset.tocState === 'hidden';
        var nextState = hidden ? 'visible' : 'hidden';
        document.documentElement.dataset.tocState = nextState;
        try {
          localStorage.setItem('vox-toc-state', nextState);
        } catch (e) {}
        updateAria(nextState);
      });
    }

    function initMermaidDiagrams() {
      var blocks = document.querySelectorAll('pre[data-language="mermaid"], pre > code.language-mermaid');
      if (!blocks || blocks.length === 0) return;

      import('https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs')
        .then(function(mod) {
          var mermaid = mod.default;
          var isLight = document.documentElement.dataset.theme === 'light';
          mermaid.initialize({
            startOnLoad: false,
            securityLevel: 'strict',
            theme: isLight ? 'neutral' : 'dark',
          });
          blocks.forEach(function(node, idx) {
            var pre = node.tagName === 'PRE' ? node : node.parentElement;
            if (!pre || pre.dataset.mermaidProcessed === 'true') return;
            pre.dataset.mermaidProcessed = 'true';
            // Expressive Code lays each line out in its own element, so the
            // pre's textContent is one line. Mermaid then fails with
            // "Syntax error in text" because `flowchart LR` is not followed
            // by a newline. Rebuild the source from those lines.
            var lines = pre.querySelectorAll('.ec-line');
            var source = lines.length
              ? Array.prototype.map.call(lines, function(line) {
                  var code = line.querySelector('.code') || line;
                  return code.textContent || '';
                }).join('\n').trim()
              : (pre.textContent || '').trim();
            if (!source) return;
            var wrapper = pre.closest('.expressive-code') || pre;
            var container = document.createElement('div');
            container.className = 'vox-mermaid-diagram';
            var renderId = 'vox-mermaid-svg-' + idx + '-' + Math.random().toString(36).slice(2, 7);
            mermaid.render(renderId, source)
              .then(function(res) {
                container.innerHTML = res.svg;
                wrapper.parentNode.insertBefore(container, wrapper);
                wrapper.style.display = 'none';
              })
              .catch(function() {
                var failed = document.getElementById(renderId);
                if (failed) failed.remove();
              });
          });
        })
        .catch(function() {
          // Offline or CDN blocked: keep expressive-code mermaid block intact
        });
    }

    function initAll() {
      initTocEdge();
      initMermaidDiagrams();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAll);
    } else {
      initAll();
    }
    document.addEventListener('astro:page-load', initAll);
  })();
</script>
