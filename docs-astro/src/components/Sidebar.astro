---
import type { Props } from '@astrojs/starlight/props';
import Default from '@astrojs/starlight/components/Sidebar.astro';
---

<div class="vox-sidebar-toggle-container">
  <button
    id="vox-sidebar-pin-toggle"
    type="button"
    aria-label="Collapse sidebar"
    aria-expanded="true"
    title="Collapse sidebar navigation"
  >
    <!-- Icon when pinned/expanded (collapse left arrow) -->
    <svg class="vox-pin-icon-collapse" viewBox="0 0 24 24" aria-hidden="true">
      <rect x="3" y="3" width="18" height="18" rx="2" ry="2" />
      <line x1="9" y1="3" x2="9" y2="21" />
      <path d="M15 15l-3-3 3-3" />
    </svg>
    <!-- Icon when collapsed (expand/pin right arrow) -->
    <svg class="vox-pin-icon-expand" viewBox="0 0 24 24" aria-hidden="true">
      <rect x="3" y="3" width="18" height="18" rx="2" ry="2" />
      <line x1="9" y1="3" x2="9" y2="21" />
      <path d="M13 9l3 3-3 3" />
    </svg>
  </button>
  <button
    id="vox-sidebar-hide-btn"
    type="button"
    aria-label="Hide navigation sidebar"
    aria-expanded="true"
    title="Hide navigation sidebar"
  >
    <span class="vox-sidebar-hide-text">Hide</span>
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M18 6L6 18M6 6l12 12" />
    </svg>
  </button>
</div>

<Default {...Astro.props}><slot /></Default>

<script is:inline>
  (function() {
    function initSidebarToggle() {
      var btn = document.getElementById('vox-sidebar-pin-toggle');
      var hideBtn = document.getElementById('vox-sidebar-hide-btn');
      var restoreBtn = document.getElementById('vox-sidebar-restore-btn');
      if (!btn) return;

      function updateAria(state) {
        var isCollapsed = state === 'collapsed';
        var isHidden = state === 'hidden';
        btn.setAttribute('aria-expanded', (isCollapsed || isHidden) ? 'false' : 'true');
        btn.setAttribute('aria-label', isCollapsed ? 'Pin sidebar' : 'Collapse sidebar');
        btn.setAttribute('title', isCollapsed ? 'Pin sidebar navigation' : 'Collapse sidebar navigation');
        if (hideBtn) {
          hideBtn.setAttribute('aria-expanded', isHidden ? 'false' : 'true');
        }
        if (restoreBtn) {
          restoreBtn.setAttribute('aria-expanded', isHidden ? 'false' : 'true');
        }
      }

      var current = document.documentElement.dataset.sidebarState || 'pinned';
      updateAria(current);

      if (btn.dataset.voxBound !== 'true') {
        btn.dataset.voxBound = 'true';
        btn.addEventListener('click', function() {
          var isCurrentlyCollapsed = document.documentElement.dataset.sidebarState === 'collapsed';
          var nextState = isCurrentlyCollapsed ? 'pinned' : 'collapsed';
          document.documentElement.dataset.sidebarState = nextState;
          try {
            localStorage.setItem('vox-sidebar-state', nextState);
          } catch (e) {}
          updateAria(nextState);
          if (nextState === 'collapsed') {
            btn.blur();
          }
        });
      }

      if (hideBtn && hideBtn.dataset.voxBound !== 'true') {
        hideBtn.dataset.voxBound = 'true';
        hideBtn.addEventListener('click', function() {
          document.documentElement.dataset.sidebarState = 'hidden';
          try {
            localStorage.setItem('vox-sidebar-state', 'hidden');
          } catch (e) {}
          updateAria('hidden');
          hideBtn.blur();
        });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initSidebarToggle);
    } else {
      initSidebarToggle();
    }
    document.addEventListener('astro:page-load', initSidebarToggle);
  })();
</script>
