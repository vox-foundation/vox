{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vox/contracts/python/ecosystem-support.schema.json",
  "title": "Vox Python std.array ecosystem support",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "module", "engine", "ops"],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "module": {
      "type": "string",
      "minLength": 1
    },
    "engine": {
      "type": "string",
      "minLength": 1
    },
    "ops": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "kind", "signature", "handler", "expected"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": ["plan", "materializer"]
          },
          "signature": {
            "type": "string",
            "minLength": 1
          },
          "handler": {
            "type": "string",
            "minLength": 1
          },
          "required_named": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "expected": {
            "type": "object"
          }
        }
      }
    }
  }
}
