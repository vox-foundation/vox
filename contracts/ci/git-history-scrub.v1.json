{
  "x-vox-version": 1,
  "schema_version": 1,
  "description": "Deterministic git filter-repo path-inversion and commit-log scrub contract for public vox repository release hygiene (SCRUB-02, SCRUB-03, SCRUB-04).",
  "filter_repo_invert_paths": [
    "server/telemetry/",
    "crates/vox-publisher/src/adapters/twitter.rs",
    "crates/vox-publisher/src/adapters/reddit.rs",
    "crates/vox-publisher/src/adapters/youtube.rs",
    "crates/vox-publisher/src/adapters/discord.rs",
    "crates/vox-publisher/src/adapters/bluesky.rs",
    "crates/vox-publisher/src/adapters/mastodon.rs",
    "crates/vox-publisher/src/adapters/linkedin.rs",
    "crates/vox-publisher/src/adapters/hacker_news.rs",
    "crates/vox-publisher/src/adapters/opencollective.rs",
    "crates/vox-gamify/src/db/hint_telemetry.rs",
    "crates/vox-gamify/src/lsp_telemetry.rs",
    "crates/vox-gamify/src/collegium.rs",
    "crates/vox-gamify/src/arena.rs",
    "crates/vox-gamify/src/disputes.rs",
    "crates/vox-gamify/src/ludus/auth.rs",
    "crates/vox-gamify/src/ludus/sync.rs"
  ],
  "commit_message_replacements": [
    {
      "pattern": "gamify_hint_telemetry",
      "replacement": "ops_agent_telemetry"
    },
    {
      "pattern": "gamify_lsp_telemetry",
      "replacement": "ops_agent_telemetry"
    },
    {
      "pattern": "server/telemetry",
      "replacement": "vox-ops-ingest"
    }
  ],
  "preserved_transparency_surfaces": [
    "crates/vox-telemetry/",
    "crates/vox-telemetry-otlp/",
    "docs/src/adr/023-optional-telemetry-remote-upload.md",
    "docs/src/architecture/telemetry-trust-ssot.md"
  ]
}
