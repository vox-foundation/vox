{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voxlang.org/contracts/intelligence/community-intelligence-bundle.v1.schema.json",
  "title": "CommunityIntelligenceBundleV1",
  "description": "Ed25519-signed, k>=20 / n>=50 Laplace-noised 7-domain Community Intelligence Bundle (INTEL-01, TYPING-04).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "bundle_version",
    "generated_at_ms",
    "expires_at_ms",
    "k_anonymity_floor",
    "min_events_floor",
    "laplace_epsilon",
    "signer_public_key_hex",
    "ed25519_signature_hex",
    "model_routing_priors",
    "model_bench_spoke_priors",
    "error_surface_priors",
    "default_decision_priors",
    "prompt_profile_priors",
    "skill_reliability_priors",
    "training_throughput_priors",
    "domain_misguidance_hotspots"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "bundle_version": { "type": "string", "minLength": 1 },
    "generated_at_ms": { "type": "integer", "minimum": 1 },
    "expires_at_ms": { "type": "integer", "minimum": 1 },
    "k_anonymity_floor": { "type": "integer", "minimum": 20 },
    "min_events_floor": { "type": "integer", "minimum": 50 },
    "laplace_epsilon": { "type": "number", "exclusiveMinimum": 0 },
    "signer_public_key_hex": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "ed25519_signature_hex": { "type": "string", "pattern": "^[0-9a-f]{128}$" },
    "model_routing_priors": { "type": "array", "items": { "type": "object" } },
    "model_bench_spoke_priors": { "type": "array", "items": { "type": "object" } },
    "error_surface_priors": { "type": "array", "items": { "type": "object" } },
    "default_decision_priors": { "type": "array", "items": { "type": "object" } },
    "prompt_profile_priors": { "type": "array", "items": { "type": "object" } },
    "skill_reliability_priors": { "type": "array", "items": { "type": "object" } },
    "training_throughput_priors": { "type": "array", "items": { "type": "object" } },
    "domain_misguidance_hotspots": { "type": "array", "items": { "type": "object" } }
  }
}
