{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voxlang.org/schemas/capability-index.v1.schema.json",
  "title": "Vox capability index (v1)",
  "description": "Generated by `vox ci capability-index --write`. One row per CLI / MCP projection of the operations catalog; later plans add surface, crate, skill and doc rows. Unknown values stay null; the index never invents data absent from its sources.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generator", "coverage_snapshot", "domains", "rows"],
  "properties": {
    "schema_version": { "const": 1 },
    "generator": { "type": "string", "minLength": 1 },
    "coverage_snapshot": {
      "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/coverage_snapshot_meta" }]
    },
    "domains": { "type": "array", "items": { "$ref": "#/$defs/domain_def" } },
    "rows": { "type": "array", "items": { "$ref": "#/$defs/capability_index_row" } }
  },
  "$defs": {
    "nullable_string": { "type": ["string", "null"] },
    "coverage_snapshot_meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["corpus_id", "git_sha", "built_at"],
      "properties": {
        "corpus_id": { "type": "string" },
        "git_sha": { "type": "string" },
        "built_at": { "type": "string" }
      }
    },
    "domain_def": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 }
      }
    },
    "cli_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "invocation", "feature_gate"],
      "properties": {
        "path": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
        "invocation": { "type": "string", "minLength": 1 },
        "feature_gate": { "$ref": "#/$defs/nullable_string" }
      }
    },
    "mcp_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "gui_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["view_key", "nav_label", "representation_tier", "catalog_form"],
      "properties": {
        "view_key": { "$ref": "#/$defs/nullable_string" },
        "nav_label": { "$ref": "#/$defs/nullable_string" },
        "representation_tier": { "$ref": "#/$defs/nullable_string" },
        "catalog_form": { "type": "boolean" }
      }
    },
    "owner_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["crate", "layer", "rule"],
      "properties": {
        "crate": { "type": "string", "minLength": 1 },
        "layer": { "type": ["integer", "null"], "minimum": 0, "maximum": 255 },
        "rule": { "type": "string", "minLength": 1 }
      }
    },
    "doc_link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "origin"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "origin": { "enum": ["default", "claim", "pinned"] }
      }
    },
    "coverage_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "basis", "ambiguous", "reason"],
      "properties": {
        "kind": { "$ref": "#/$defs/nullable_string" },
        "basis": { "type": "string", "minLength": 1 },
        "ambiguous": { "type": "boolean" },
        "reason": { "$ref": "#/$defs/nullable_string" }
      }
    },
    "capability_index_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "kind", "title", "summary", "op_id", "status", "domain", "product_lane",
        "side_effect_class", "tier", "cli", "mcp", "gui", "owner", "source_path",
        "docs", "skills", "equivalents", "refs", "coverage"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["cli", "mcp_tool", "surface", "crate", "skill", "doc"] },
        "title": { "type": "string" },
        "summary": { "$ref": "#/$defs/nullable_string" },
        "op_id": { "$ref": "#/$defs/nullable_string" },
        "status": { "$ref": "#/$defs/nullable_string" },
        "domain": { "$ref": "#/$defs/nullable_string" },
        "product_lane": { "$ref": "#/$defs/nullable_string" },
        "side_effect_class": { "$ref": "#/$defs/nullable_string" },
        "tier": { "$ref": "#/$defs/nullable_string" },
        "cli": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/cli_ref" }] },
        "mcp": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/mcp_ref" }] },
        "gui": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/gui_ref" }] },
        "owner": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/owner_ref" }] },
        "source_path": { "$ref": "#/$defs/nullable_string" },
        "docs": { "type": "array", "items": { "$ref": "#/$defs/doc_link" } },
        "skills": { "type": "array", "items": { "type": "string" } },
        "equivalents": { "type": "array", "items": { "type": "string" } },
        "refs": { "type": "array", "items": { "type": "string" } },
        "coverage": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/coverage_ref" }] }
      }
    }
  }
}
