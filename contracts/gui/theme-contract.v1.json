  "banned_hardcoded_dark_brown_hexes": [
    "#0a0805",
    "#0d0a07",
    "#0e0b08",
    "#100c08",
    "#120e0a",
    "#14100b",
    "#16120c",
    "#18120c",
    "#1a140e",
    "#1c160f",
    "#1e1710",
    "#201810",
    "#221a11",
    "#241c14",
    "#261d13",
    "#281f14",
    "#2a2011"
  ],
  "banned_romanesque_font_literals": [
    "Courier New",
    "Courier",
    "Arial",
    "Consolas",
    "Menlo",
    "Monaco"
  ],
  "font_literal_allowlist_paths": [
    "src/index.css",
    "src/styles/tokens.slate.generated.css",
    "src/lib/themeContract.ts"
  ],
  "dark_brown_hex_allowlist_paths": [
    "src/index.css",
    "src/lib/themeContract.ts"
  ],
  "interactive_invariants": {
    "single_line_buttons_and_badges": true,
    "max_clipped_interactive_controls": 0,
    "max_overlapping_control_pairs": 0,
    "min_wcag_contrast_ratio": 4.5,
    "auto_enroll_surface_registry": true,
    "auto_enroll_chat_dock_panels": true
  }
}
