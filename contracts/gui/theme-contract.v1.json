      "mode": "dark",
      "selector": "[data-theme=\"high-contrast\"]",
      "description": "Maximum WCAG AAA contrast obsidian black (#000000 / #0a0a0a) with pure white typography (#ffffff) and high-luminance gold & emerald accents.",
      "tokens": {
        "--brass": "212 175 55",
        "--color-bg-base": "#000000",
        "--color-bg-surface": "#000000",
        "--color-bg-elevated": "#0a0a0a",
        "--color-text-primary": "#ffffff",
