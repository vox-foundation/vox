{
  "schema_version": 1,
  "contract_id": "vox-gui-theme-contract-v1",
  "default_theme": "arcane",
  "supported_themes": [
    "arcane",
    "slate",
    "void",
    "high-contrast",
    "glacier"
  ],
  "required_semantic_css_vars": [
    "--brass",
    "--color-bg-base",
    "--color-bg-surface",
    "--color-bg-elevated",
    "--color-text-primary",
    "--color-text-secondary",
    "--color-text-muted",
