        "--font-display": "'Cinzel', 'Palatino', 'Palatino Linotype', 'Book Antiqua', Georgia, serif",
        "--font-mono": "'Palatino', 'Palatino Linotype', 'Book Antiqua', 'EB Garamond', Georgia, serif"
