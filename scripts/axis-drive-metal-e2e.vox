// vox:caps subprocess fs
import fs
import process
import env

fn vox_binary_path() to str {
    // Prefer debug when present so local agent/Drive e2e picks up uncommitted
    // workspace builds (release is often stale).
    if fs.exists("./target/debug/vox.exe") {
        return "./target/debug/vox.exe"
    }
    if fs.exists("./target/debug/vox") {
        return "./target/debug/vox"
    }
    if fs.exists("./target/release/vox.exe") {
        return "./target/release/vox.exe"
    }
    if fs.exists("./target/release/vox") {
        return "./target/release/vox"
    }
    return "./target/debug/vox"
}

fn fail(bin: str, message: str) {
    print("Metal Drive e2e failed: " + message)
    log.error("Metal Drive e2e failed: " + message)
    let _ = process.run(bin, ["gui", "drive", "stop"])
    process.exit(1)
}

fn run_json(bin: str, args: list[str]) to Json {
    let result_opt = process.run(bin, args)
    if result_opt is null {
        fail(bin, "could not execute " + bin)
    }
    let result = result_opt.unwrap()
    if result.code is not 0 {
        fail(bin, "command failed (" + str(result.code) + "): " + result.stderr)
    }
    let parsed = json.parse(result.stdout)
    if parsed.is_err() {
        fail(bin, "invalid JSON: " + parsed.unwrap_err())
    }
    return parsed.unwrap()
}

fn state_view(response: Json) to Json {
    return response.get("state").unwrap_or(response)
}

fn string_field(value: Json, key: str) to str {
    return value.get(key).and_then(fn(x: Json) to Option[str] { x.as_str() }).unwrap_or("")
}

// Last assistant bubble's text, or "" if the bubble list is empty — used by
// both the demo turn and the nonce-echo turn so neither has to duplicate the
// bubbles/get/unwrap_or chain.
fn last_assistant_text(drive_state_json: Json) to str {
    let bubbles = drive_state_json.get("bubbles").and_then(fn(x: Json) to Option[list[Json]] { x.as_array() }).unwrap_or([])
    if bubbles.len() is 0 {
        return ""
    }
    let last_bubble = bubbles.get(bubbles.len() - 1).unwrap()
    return string_field(last_bubble, "content")
}

// Extraction rule (Task B3 step 5): the FIRST ```vox fenced code block in the
// model's reply. Returns None when no fence opens, or when one opens but
// never closes — both are extraction failures, not "nothing to extract".
// Callers MUST fail() on None; "no fence found -> skip" is the exact
// false-green shape this repo has shipped before (see task-B3-brief.md).
fn first_vox_fence(text: str) to Option[str] {
    let lines = text.split("\n")
    let mut in_fence = false
    let mut collected = ""
    for line in lines {
        let trimmed = line.trim()
        if in_fence {
            if trimmed.starts_with("```") {
                return Some(collected)
            }
            if collected == "" {
                collected = line
            } else {
                collected = collected + "\n" + line
            }
        } else {
            if trimmed.starts_with("```vox") {
                in_fence = true
            }
        }
    }
    return None
}

// Minimal OpenAI-chat-shaped POST against a `mens serve` (or compatible)
// endpoint, greedy (temperature 0) so two calls against the same weights are
// deterministic and comparable. Returns None on any transport/parse failure
// so callers can fail() with their own context.
fn chat_completion_text(url: str, prompt: str) to Option[str] {
    let escaped = prompt.replace("\"", "\\\"")
    let body = "{\"model\":\"probe\",\"temperature\":0,\"max_tokens\":64,\"messages\":[{\"role\":\"user\",\"content\":\"" + escaped + "\"}]}"
    let result = process.run("curl", [
        "--fail", "--silent", "--show-error",
        "-X", "POST", url,
        "-H", "Content-Type: application/json",
        "-d", body
    ])
    if result is null {
        return None
    }
    let completed = result.unwrap()
    if completed.code is not 0 {
        return None
    }
    let parsed = json.parse(completed.stdout)
    if parsed.is_err() {
        return None
    }
    let j = parsed.unwrap()
    let choices = j.get("choices").and_then(fn(x: Json) to Option[list[Json]] { x.as_array() }).unwrap_or([])
    if choices.len() is 0 {
        return None
    }
    let choice = choices.get(0).unwrap()
    let msg = choice.get("message").unwrap_or(choice)
    return Some(string_field(msg, "content"))
}

fn main() {
    let uname = process.run("uname", ["-s"])
    if uname is null {
        print("Axis Drive Metal e2e requires Darwin; skipping with exit 2.")
        process.exit(2)
    }
    let osname = uname.unwrap().stdout.trim()
    if osname != "Darwin" {
        print("Axis Drive Metal e2e requires Darwin; skipping with exit 2.")
        process.exit(2)
    }

    let pin = "mens/qwen35-08b-metal-e2e"
    let port = "11435"
    let bin = vox_binary_path()

    // Step 0: stop prior Drive + foreign orch so spawn gets VOX_GUI_DRIVE env.
    let _ = process.run(bin, ["gui", "drive", "stop"])
    let _ = process.run("pkill", ["-x", "vox-orchestrator-d"])

    // Prefer a fresh Drive profile so LegacySchema (schema_max > binary baseline)
    // on `default` cannot block listener bind. Parent must export
    // VOX_GUI_DRIVE_ALLOW_STORE_RESET=1 and VOX_LOCAL_ENDPOINT=http://127.0.0.1:11435.
    let start = process.run(bin, ["gui", "drive", "start", "--profile", "metal-e2e"])
    if start is null {
        fail(bin, "could not execute drive start")
    }
    let start_result = start.unwrap()
    if start_result.code is not 0 {
        fail(bin, "drive start failed (" + str(start_result.code) + "): " + start_result.stderr)
    }

    let _ = run_json(bin, ["gui", "drive", "set", "--knob", "execution=sync"])
    let _ = run_json(bin, ["gui", "drive", "set", "--knob", "model_override=" + pin])

    let state_response = run_json(bin, ["gui", "drive", "state"])
    let drive_state = state_view(state_response)

    // Step 6: assert the GUI's OWN view of reachability, not a direct curl to
    // /v1/models. `gui drive state` already carries `probe.reachable` and
    // `probe.models` (crates/vox-gui/src/drive/protocol.rs::DriveProbe) — this
    // is what Axis itself believes about the serve leg, which is the thing an
    // operator/agent actually looks at, not the raw HTTP transport.
    let probe = drive_state.get("probe").unwrap_or(drive_state)
    let probe_reachable = probe.get("reachable").and_then(fn(x: Json) to Option[bool] { x.as_bool() }).unwrap_or(false)
    if not probe_reachable {
        fail(bin, "gui drive state probe.reachable=false; run scripts/mens-macos-metal-e2e.vox first")
    }
    let probe_models = probe.get("models").and_then(fn(x: Json) to Option[list[Json]] { x.as_array() }).unwrap_or([])
    let mut probe_has_pin = false
    for m in probe_models {
        if m.as_str().unwrap_or("") == pin {
            probe_has_pin = true
        }
    }
    if not probe_has_pin {
        fail(bin, "gui drive state probe.models does not contain " + pin + " — the GUI's own probe does not see the pinned model")
    }

    let orch_fresh = drive_state.get("orch_fresh").and_then(fn(x: Json) to Option[bool] { x.as_bool() }).unwrap_or(false)
    if not orch_fresh {
        fail(bin, "orch_fresh=false after start — foreign orch may still be adopted or spawn failed")
    }
    let catalog = drive_state.get("catalog").and_then(fn(x: Json) to Option[list[Json]] { x.as_array() }).unwrap_or([])
    let pin_policy = string_field(drive_state, "pin_policy")
    let mut pin_selectable = false
    let mut pin_reason = ""
    for row in catalog {
        if string_field(row, "id") == pin {
            pin_selectable = row.get("selectable").and_then(fn(x: Json) to Option[bool] { x.as_bool() }).unwrap_or(false)
            pin_reason = row.get("reason").and_then(fn(x: Json) to Option[str] { x.as_str() }).unwrap_or("")
        }
    }
    if not pin_selectable and pin_policy == "fail" {
        fail(bin, "catalog pin " + pin + " not selectable under pin_policy=fail; reason=" + pin_reason)
    }

    // Step 2: nonce echo. A fixed prompt string would let a cache, a stubbed
    // handler, or a hardcoded fallback pass every time — a per-run token that
    // only a live model turn can see and echo back rules that out.
    let nonce = "vx" + str(std.time.now_ms())
    let _ = run_json(bin, ["gui", "drive", "send", "--text",
        "Reply with exactly this token and nothing else: " + nonce])
    let nonce_wait = process.run(bin, ["gui", "drive", "wait", "--until", "reply_ok", "--timeout", "180s"])
    if nonce_wait is null or nonce_wait.unwrap().code is not 0 {
        fail(bin, "nonce echo turn did not reach reply_ok")
    }
    let nonce_state = state_view(run_json(bin, ["gui", "drive", "state"]))
    let nonce_text = last_assistant_text(nonce_state)
    if not nonce_text.contains(nonce) {
        fail(bin, "reply did not echo the per-run nonce — cached or canned response")
    }

    // Step 1: demo prompt provably absent from the training corpus (previous
    // revision used "Write a Vox function named add" — `fn_add` is a held-out
    // bench task whose name appears in the training corpus, so that prompt
    // would showcase a memorized answer as if it proved novel codegen; see
    // task-B3-report.md for the zero-count grep evidence for the name below).
    let _ = run_json(bin, ["gui", "drive", "send", "--text",
        "Write a Vox function named zephyroid_lattice_fold that takes a list[int] and returns the sum of its elements. Reply with only a ```vox fenced code block containing the function."])
    let wait = process.run(bin, ["gui", "drive", "wait", "--until", "reply_ok", "--timeout", "180s"])
    if wait is null {
        fail(bin, "could not execute reply_ok wait")
    }
    let wait_result = wait.unwrap()
    if wait_result.code is not 0 {
        fail(bin, "reply_ok wait failed (" + str(wait_result.code) + "): " + wait_result.stderr)
    }

    let final_response = run_json(bin, ["gui", "drive", "state"])
    let final_state = state_view(final_response)
    let plane = string_field(final_state, "plane")
    let last_error = final_state.get("last_error")
    if not (plane == "live") {
        fail(bin, "state is not live")
    }
    if not (last_error is null) and not last_error.unwrap().is_null() {
        fail(bin, "last_error is set: " + last_error.unwrap().to_string())
    }

    let bubbles = final_state.get("bubbles").and_then(fn(x: Json) to Option[list[Json]] { x.as_array() }).unwrap_or([])
    if bubbles.len() is 0 {
        fail(bin, "reply_ok returned no assistant bubble")
    }
    let last_bubble = bubbles.get(bubbles.len() - 1).unwrap()
    let assistant_text = last_bubble.get("content").and_then(fn(x: Json) to Option[str] { x.as_str() }).unwrap_or("")
    let bubble_role = last_bubble.get("role").and_then(fn(x: Json) to Option[str] { x.as_str() }).unwrap_or("")
    let bubble_error = last_bubble.get("error").and_then(fn(x: Json) to Option[bool] { x.as_bool() }).unwrap_or(false)
    if not (bubble_role == "assistant") or assistant_text.trim() == "" or bubble_error {
        fail(bin, "reply_ok returned an empty or error assistant bubble")
    }

    // Step 5: extract-and-compile. Extraction failure is a HARD failure, not
    // a silent skip — "no fence found -> skip" is documented theater.
    let fence = first_vox_fence(assistant_text)
    if fence is null {
        fail(bin, "no ```vox fenced code block found in the assistant reply — treating this as a hard failure, not a skip")
    }
    let extracted = fence.unwrap()
    let extracted_path = "target/axis-drive-metal-e2e-extracted-" + nonce + ".vox"
    let write_res = fs.write(extracted_path, extracted)
    if not write_res.is_ok() {
        fail(bin, "could not write extracted snippet to " + extracted_path)
    }
    let compile = process.run(bin, ["check", extracted_path])
    if compile is null {
        fail(bin, "could not execute " + bin + " check on extracted snippet")
    }
    let compile_result = compile.unwrap()
    if compile_result.code is not 0 {
        fail(bin, "extracted vox snippet failed to compile: " + compile_result.stderr)
    }

    // Honesty: sticky Metal pin must not silently bill OpenRouter, AND must
    // positively name the local provider — an absence assertion alone is
    // satisfied by "nothing ran", which is exactly the false-green this task
    // exists to close.
    let events = final_state.get("events").and_then(fn(x: Json) to Option[list[Json]] { x.as_array() }).unwrap_or([])
    let mut saw_openrouter_cost = false
    let mut saw_vox_local_cost = false
    for event in events {
        let kind = string_field(event, "kind")
        let raw = string_field(event, "raw")
        if kind == "cost_incurred" and raw.contains("\"provider\":\"openrouter\"") {
            saw_openrouter_cost = true
        }
        if kind == "cost_incurred" and raw.contains("\"provider\":\"vox_local\"") {
            saw_vox_local_cost = true
        }
    }
    if saw_openrouter_cost {
        fail(bin, "Metal pin routed to OpenRouter (cost_incurred provider=openrouter); VoxLocal sticky resolve failed")
    }
    if not saw_vox_local_cost {
        fail(bin, "no cost_incurred event names provider=vox_local — cannot positively confirm the reply actually came from the local VoxLocal serve leg (absence of openrouter alone does not prove this)")
    }

    let turn_id = string_field(final_state, "last_turn_id")
    let mut submit_ok = false
    let mut kinds = ""
    for event in events {
        let kind = string_field(event, "kind")
        if kinds == "" {
            kinds = kind
        } else {
            kinds = kinds + "," + kind
        }
        if kind == "submit_ok" and string_field(event, "turn_id") == turn_id {
            submit_ok = true
        }
    }
    if not submit_ok {
        fail(bin, "state.events is missing submit_ok for last_turn_id; kinds=" + kinds)
    }

    // Step 3: positive provider assertion (above) paired with the negative
    // control no absence-assertion can fake — stop the serve process this
    // turn claims to be testing, re-send, and require the turn to now fail.
    // If it still succeeds, the reply was never actually coming from serve.
    // This runs BEFORE step 4 (not after) so it always executes on every real
    // invocation: step 4 fails closed today (see below) on every run because
    // no base-only serving mode exists in this repo, and a check ordered
    // after an unconditionally-failing one would never be reached in
    // practice — see task-B3-report.md's fix-round note.
    let _ = process.run("pkill", ["-f", "mens serve"])
    let _ = process.run("sleep", ["2"])
    let control_nonce = nonce + "-control"
    let _ = run_json(bin, ["gui", "drive", "send", "--text",
        "Reply with exactly this token and nothing else: " + control_nonce])
    let control_wait = process.run(bin, ["gui", "drive", "wait", "--until", "reply_ok", "--timeout", "20s"])
    if control_wait is not null and control_wait.unwrap().code is 0 {
        fail(bin, "turn still succeeded after stopping mens serve — the reply was never actually coming from the server this e2e claims to test")
    }

    // Step 4: adapter-vs-base. Nothing else in this repo checks whether the
    // served reply actually used the trained adapter versus a silent fallback
    // to base (untrained) weights — without this, a broken adapter load would
    // pass every assertion above. The check requires a second endpoint
    // serving ONLY the base weights (no adapter) for a same-prompt, greedy
    // comparison; `crates/vox-plugin-mens-candle-metal/src/inference.rs`
    // hard-requires an adapter file and manifest to load at all (it errors if
    // either is missing — see `resolve_adapter_manifest_path` /
    // "LoRA adapter or adapter_manifest.json not found"), and neither
    // `vox mens serve` nor `vox mens eval-local` nor `vox chat` (OpenRouter
    // only) expose a "serve base weights, no adapter" mode. That is a genuine
    // infrastructure gap, not something to fake here (see task-B3-report.md).
    // Until that mode exists, an operator can point VOX_MENS_BASE_ENDPOINT at
    // a base-only OpenAI-chat-compatible endpoint to opt in; absent that, this
    // check fails closed rather than silently passing. It runs LAST (after
    // the step 3 negative control, which already killed serve) precisely
    // because it fails closed on the missing env var before ever attempting
    // to reach an endpoint — serve's state by this point doesn't matter.
    let base_endpoint = env.get("VOX_MENS_BASE_ENDPOINT")
    if base_endpoint is null {
        fail(bin, "VOX_MENS_BASE_ENDPOINT is not set — no base-only (no-adapter) serving mode exists in this repo today, so adapter-vs-base cannot be verified live; see task-B3-report.md for the gap and the code paths that would need one")
    }
    let base_url = base_endpoint.unwrap()
    let compare_prompt = "Reply with exactly this token and nothing else: " + nonce
    let adapter_reply = chat_completion_text("http://127.0.0.1:" + port + "/v1/chat/completions", compare_prompt)
    let base_reply = chat_completion_text(base_url, compare_prompt)
    if adapter_reply is null or base_reply is null {
        fail(bin, "adapter-vs-base comparison could not reach both endpoints")
    }
    if adapter_reply.unwrap() == base_reply.unwrap() {
        fail(bin, "adapter output is byte-identical to base output for the same greedy prompt — the adapter is not actually being applied (silent fallback to base weights)")
    }

    print("{\"status\":\"pass\",\"plane\":\"" + plane + "\",\"model\":\"" + pin + "\",\"turn_id\":\"" + turn_id + "\",\"event_kinds\":\"" + kinds + "\",\"event_count\":" + str(events.len()) + "}")
    let stop = process.run(bin, ["gui", "drive", "stop"])
    if stop is null {
        process.exit(1)
    }
    if stop.unwrap().code is not 0 {
        process.exit(1)
    }
    process.exit(0)
}
