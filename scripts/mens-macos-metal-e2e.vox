// vox:caps subprocess fs
import env
import fs
import process

fn fail(message: str) {
    print("MENS macOS Metal e2e failed: " + message)
    log.error("MENS macOS Metal e2e failed: " + message)
    process.exit(1)
}

fn run_vox(bin: str, args: list[str]) to bool {
    let result = process.run(bin, args)
    if result is null {
        fail("could not execute " + bin)
    }
    let completed = result.unwrap()
    if completed.code is not 0 {
        print(completed.stdout)
        print(completed.stderr)
        return false
    }
    // Soft-skip / gpu-warning-only paths must not false-green.
    let combined = completed.stdout + "\n" + completed.stderr
    if combined.contains("gpu feature") or combined.contains("GPU feature") or combined.contains("without --features gpu") {
        fail("train/serve emitted a gpu soft-skip warning; rebuild with --features gpu,execution-api")
    }
    return true
}

fn vox_binary_path() to str {
    if fs.exists("./target/debug/vox") {
        return "./target/debug/vox"
    }
    if fs.exists("./target/debug/vox.exe") {
        return "./target/debug/vox.exe"
    }
    if fs.exists("./target/release/vox") {
        return "./target/release/vox"
    }
    return "vox"
}

fn preflight_gpu_cli(bin: str) {
    // Prefer a workspace binary known to include Metal/Candle features when present.
    let probe = process.run(bin, ["mens", "train", "--help"])
    if probe is null {
        fail("vox binary missing; build with cargo build -p vox-cli --features gui and vox-ml-cli --features gpu,execution-api")
    }
    let help = probe.unwrap().stdout + probe.unwrap().stderr
    if help.contains("cuda-only") and not help.contains("metal") {
        print("warning: mens train help looks CUDA-centric; ensure Metal backend is compiled in")
    }
}

fn main() {
    let uname = process.run("uname", ["-s"])
    if uname is null or uname.unwrap().stdout.trim() is not "Darwin" {
        print("MENS macOS Metal e2e requires Darwin; skipping with exit 2.")
        process.exit(2)
    }

    let bin = vox_binary_path()
    preflight_gpu_cli(bin)

    let model = "Qwen/Qwen2.5-Coder-0.5B-Instruct"
    let run_dir = "mens/runs/qwen35-08b-metal-e2e"
    let port = "11435"
    let baseline = env.get("VOX_MENS_BASELINE")

    print("MENS macOS Metal e2e")
    print("  Model: " + model)
    print("  Run:   " + run_dir)
    print("  Bin:   " + bin)

    // Skip retrain when Candle adapter + tokenizer already exist (Drive acceptance
    // can reuse a prior green train). Soft-skip of *gpu* is still a hard fail.
    let existing_adapter = run_dir + "/candle_qlora_adapter.safetensors"
    let existing_tok = run_dir + "/tokenizer.json"
    if fs.exists(existing_adapter) and fs.exists(existing_tok) {
        print("Reusing existing Metal train artifacts under " + run_dir)
    } else {
        // --model triggers native hf-hub download; --fast-corpus keeps the
        // per-run data-dir contract from being hijacked by a workspace corpus refresh.
        let train_args = [
            "mens", "train",
            "--backend", "qlora",
            "--tokenizer", "hf",
            "--device", "metal",
            "--model", model,
            "--data-dir", "examples/mens/metal-e2e",
            "--output-dir", run_dir,
            "--epochs", "1",
            "--max-runtime-secs", "300",
            "--fast-corpus"
        ]
        if not run_vox(bin, train_args) {
            fail("Metal training failed; verify the host-aware training dispatch is present")
        }
    }

    // Artifact asserts — adapter files must exist (not just exit 0).
    // Candle QLoRA writes candle_qlora_adapter.safetensors; HF-style names are
    // kept for cross-backend compatibility.
    let adapter_candidates = [
        run_dir + "/candle_qlora_adapter.safetensors",
        run_dir + "/adapter_model.safetensors",
        run_dir + "/adapter_model.bin",
        run_dir + "/final/adapter_model.safetensors"
    ]
    let mut has_adapter = false
    for p in adapter_candidates {
        if fs.exists(p) {
            has_adapter = true
        }
    }
    if not has_adapter {
        fail("no adapter artifact under " + run_dir + " after train")
    }

    let report = run_dir + "/collateral_damage_report.json"
    if not fs.exists(report) {
        if baseline is null {
            fail("missing collateral_damage_report.json; set VOX_MENS_BASELINE to a baseline JSON path")
        }
        let baseline_path = baseline.unwrap()
        if not run_vox(bin, [
            "mens", "eval-collateral-damage",
            "--pre-score", baseline_path,
            "--post-adapter", run_dir
        ]) {
            fail("collateral-damage evaluation failed")
        }
    }
    if not fs.exists(report) {
        fail("collateral_damage_report.json was not produced")
    }
    let report_body = fs.read(report).unwrap_or("")
    if not report_body.contains("\"status\":\"pass\"") and not report_body.contains("\"status\": \"pass\"") {
        fail("collateral_damage_report.json does not assert status pass")
    }

    // Serve expects tokenizer.json beside the adapter; train may leave it on the hub snapshot only.
    let tok = run_dir + "/tokenizer.json"
    if not fs.exists(tok) {
        fail("missing tokenizer.json in run dir; copy from the Hugging Face snapshot before serve")
    }

    let serve_id = process.spawn_background(bin, [
        "mens", "serve", "--model", run_dir,
        "--host", "127.0.0.1", "--port", port
    ])
    match serve_id {
        Err(e) => fail("could not start serve worker: " + e)
        Ok(id) => print("Serve worker started with process id " + str(id))
    }

    let health = process.run("curl", [
        "--fail", "--silent", "--show-error",
        "--retry", "10", "--retry-delay", "1",
        "http://127.0.0.1:" + port + "/v1/models"
    ])
    if health is null or health.unwrap().code is not 0 {
        fail("serve health check failed on port " + port)
    }
    let body = health.unwrap().stdout
    if not body.contains("qwen35-08b-metal-e2e") {
        fail("serve /v1/models did not list qwen35-08b-metal-e2e")
    }
    print("Metal serve health passed; pin mens/qwen35-08b-metal-e2e in Axis Drive.")
}
