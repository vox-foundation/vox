// vox:caps fs process env
// scripts/quant_benchmark_matrix.vox
//
// Automated multi-tier benchmarking runner for Vox Mens 27B.
// Evaluates all 5 precision tiers:
//   1. merged_bf16  (51.24 GB BFloat16)
//   2. quant_q8_0   (30.00 GB GGML Q8_0)
//   3. quant_q6_k   (23.37 GB GGML Q6_K)
//   4. quant_q5_k_m (20.86 GB GGML Q5_K_M)
//   5. quant_q4_k_m (18.50 GB GGML Q4_K_M)
//
// Measures:
//   - Held-Out Perplexity (sliding window W=1024, S=512)
//   - 3-Tier Functional Pass Rate (Compile, AST, Runnable Exec)
//   - Multi-File Symbol Binding Accuracy (SBA)
//   - Distinct-4 Repetition Index (D4)
//   - Strict Negative Constraint Adherence
//   - Generation Throughput (prefill & decode tok/s)
//   - Peak Resident Working Set (VRAM GB)
//
// Usage:
//   vox run scripts/quant_benchmark_matrix.vox -- --smoke
//   vox run scripts/quant_benchmark_matrix.vox -- --background
//   vox run scripts/quant_benchmark_matrix.vox -- --tier <name>
//   vox run scripts/quant_benchmark_matrix.vox -- --run-daemon
//   vox run scripts/quant_benchmark_matrix.vox -- help

import json;

fn print_usage() {
    print("==================================================================")
    print(" Vox Mens 27B — Multi-Tier Quantization Benchmark Runner")
    print("==================================================================")
    print("Options:")
    print("  --smoke             Fast synthetic check (< 5s) validating harness and contract schema")
    print("  --background        Launch detached background evaluation daemon with log tracking")
    print("  --tier <name>       Evaluate single tier (merged_bf16, quant_q8_0, etc.)")
    print("  --run-daemon        Internal execution daemon invoked by --background")
    print("  --report <path>     Custom output matrix JSON destination")
    print("  help, --help        Show this usage manual")
    print("==================================================================")
}

fn find_ml_cli() to str {
    if std.fs.exists("target/release/vox-ml-cli.exe") {
        return "target/release/vox-ml-cli.exe"
    }
    if std.fs.exists("target/release/vox-ml-cli") {
        return "target/release/vox-ml-cli"
    }
    if std.fs.exists("target/debug/vox-ml-cli.exe") {
        return "target/debug/vox-ml-cli.exe"
    }
    if std.fs.exists("target/debug/vox-ml-cli") {
        return "target/debug/vox-ml-cli"
    }
    return "vox"
}

