// Install lefthook pre-commit hooks for this repo.
// Run once after cloning: vox run scripts/install-hooks.vox
//
// Lefthook reads lefthook.yml at the repo root and installs the git hooks. They never build:
// they call the installed vox / toestub / vox-drift-check (scripts/setup.vox installs them).

fn main() {
  let result_opt = process.run("lefthook", ["install"]);
  // `process.run` returns `Option[Record]` (typecheck contract; see the
  // interpreter's `"spawn" | "run"` arm in `eval/builtins.rs`), not `Null` —
  // a spawn failure is `Option(None)`, a distinct VoxValue variant from
  // `Null`. `result_opt is null` was therefore always false (Task 2 Step 11 —
  // Task 0 found this `Option.unwrap()` panic): the check silently fell
  // through to `result_opt.unwrap()` on `None`, panicking, instead of
  // printing the "install lefthook" guidance below and exiting 1.
  if result_opt is None {
    log.error("Failed to spawn lefthook. Install it first:");
    log.error("  Windows:  winget install evilmartians.lefthook");
    log.error("  macOS:    brew install lefthook");
    log.error("  Linux:    cargo install lefthook");
    log.error("  All:      https://github.com/evilmartians/lefthook#installation");
    process.exit(1);
  }
  let result = result_opt.unwrap();
  if result.code != 0 {
    log.error("lefthook install failed with exit code " + str(result.code));
    process.exit(1);
  }
  print("Git hooks installed (lefthook). They call installed binaries and never build:");
  print("  pre-commit: rustfmt on staged files, toestub tdd-guard, GUI honesty guard, CI status");
  print("  pre-push:   vox ci pre-push (fast tier; refuses a push to main)");
  print("Generated files are regenerated by PR CI (ssot-autoregen), not by hooks.");
}
