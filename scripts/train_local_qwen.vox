// vox:caps fs process env
// Local Qwen Fine-Tuning Automation Script
// Run via:
//   vox run scripts/train_local_qwen.vox             (Full training on Metal/CUDA)
//   vox run scripts/train_local_qwen.vox --dry-run   (Preflight check & dry run)
//   vox run scripts/train_local_qwen.vox --model <path>

import process
import env

fn main() {
    let output_dir = "mens/runs/qwen_local_metal"
    let data_dir = "target/dogfood"
    let default_model = "Qwen/Qwen3-8B@b968826d9c46dd6066d109eabc6255188de91218"
    let mut model = default_model
    let mut device = "metal"
    
    // Parse command line arguments
    let argv = env.args()
    let mut dry_run = false
    let mut i = 0
    while i < argv.len() {
        let arg = argv[i]
        if arg is "--dry-run" or arg is "--check-only" {
            dry_run = true
        } else if arg is "--model" and i + 1 < argv.len() {
            i = i + 1
            model = argv[i]
        } else if arg is "--device" and i + 1 < argv.len() {
            i = i + 1
            device = argv[i]
        }
        i = i + 1
    }
    
    if dry_run {
        print("--- Local Qwen Training Preflight Check & Dry Run ---")
        print("Target Model:  " + model)
        print("Device:        " + device)
        print("Data Dir:      " + data_dir)
        print("Output Dir:    " + output_dir)
        print("Running in dry-run mode (max 45 seconds to verify accelerator and model preflight)...")
        
        let args = [
            "mens", "train",
            "--model", model,
            "--device", device,
            "--backend", "qlora",
            "--data-dir", data_dir,
            "--output-dir", output_dir,
            "--epochs", "1",
            "--lr", "0.0002",
            "--preset", "auto",
            "--tokenizer", "hf",
            "--fast-corpus",
            "--checkpoint-every", "1",
            "--max-runtime-secs", "45"
        ]
        
        print("Invoking preflight training check...")
        let mut proc = process.run("./target/debug/vox-ml-cli", args)
        if proc is null {
            proc = process.run("vox-ml-cli", args)
        }
        if proc is null {
            proc = process.run("vox", args)
        }
        
        match proc {
            Some(res) => {
                print("Preflight process finished with code: " + str(res.code))
                print("Stdout:")
                print(res.stdout)
                print("Stderr:")
                print(res.stderr)
                
                if res.code is 0 or res.code is 137 or res.code is 124 {
                    print("Preflight check completed successfully.")
                } else {
                    print("Preflight check finished (non-zero code might indicate termination/timeout or error).")
                }
            }
            None => {
                print("Error: Could not execute preflight training check.")
                process.exit(1)
            }
        }
    } else {
        print("--- Launching Full Local Qwen Fine-Tuning ---")
        print("Target Model:  " + model)
        print("Device:        " + device)
        print("Data Dir:      " + data_dir)
        print("Output Dir:    " + output_dir)
        print("Epochs:        1")
        
        let args = [
            "mens", "train",
            "--model", model,
            "--device", device,
            "--backend", "qlora",
            "--data-dir", data_dir,
            "--output-dir", output_dir,
            "--epochs", "1",
            "--lr", "0.0002",
            "--preset", "auto",
            "--tokenizer", "hf",
            "--fast-corpus",
            "--checkpoint-every", "25"
        ]
        
        print("Invoking full training process...")
        let mut proc = process.run("./target/debug/vox-ml-cli", args)
        if proc is null {
            proc = process.run("vox-ml-cli", args)
        }
        if proc is null {
            proc = process.run("vox", args)
        }
        
        match proc {
            Some(res) => {
                print("Training run completed with code: " + str(res.code))
                print("Stdout:")
                print(res.stdout)
                print("Stderr:")
                print(res.stderr)
                
                if res.code is 0 {
                    print("Training run completed successfully.")
                } else {
                    print("Training run failed.")
                    process.exit(res.code)
                }
            }
            None => {
                print("Error: Could not execute training process.")
                process.exit(1)
            }
        }
    }
}
