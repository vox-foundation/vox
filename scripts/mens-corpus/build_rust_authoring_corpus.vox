// vox:caps fs process
// scripts/mens-corpus/build_rust_authoring_corpus.vox
//
// Task D2 (2026-09-12-mens-end-to-end-completion): `mens/config/mix-rust.yaml`
// requires `target/dogfood/rust_authoring.validated.jsonl` (optional: false)
// but nothing generated it, and the raw `mens/data/mix_sources/rust_source.jsonl`
// (19,664 lines) is tagged `lane: rust_context`, which isn't in mix-rust.yaml's
// `include_lanes` allow-list — so every row was filtered out
// (skipped_reason: no_lines_passed_filters).
//
// This script derives the required validated file from the raw source by
// relabeling `lane: rust_context` -> `lane: vox_rust_authoring` (the
// canonical lane for instruction->idiomatic-Rust pairs; already in
// mix-rust.yaml's include_lanes, so no config change needed for this file).
//
// NOTE on retired decorator spellings (`@query`/`@mutation`/`@component`,
// hard parse errors since 2026-06-30): a first version of this script also
// dropped rows containing those substrings, on the assumption they taught
// invalid Vox syntax as valid. Manual review of all 65 matching rows (this
// file is Rust source, mix-rust.yaml is a Rust-authoring corpus) found every
// one is real, compiling Rust *about* the Vox compiler — lexer token defs
// (`#[token("@component")] AtComponent`), `reject_retired_decorator(...)`
// call sites, EBNF/Lark grammar-export strings, and code-audit lint-fixture
// string literals demonstrating the violation for a linter. None is Vox
// source treating the retired decorators as currently valid. That purge was
// therefore wrong scope for this file and has been removed — see task-D2
// report's fix-report section for the full row-by-row review.
//
// Usage: vox run scripts/mens-corpus/build_rust_authoring_corpus.vox
//
// Fast-follow (final-review Important finding #5): a purely textual replace can silently
// match zero rows if the upstream JSONL's serialization ever adds whitespace
// (`"lane": "rust_context"` instead of `"lane":"rust_context"`) — every row then passes
// through unrelabeled, mix-rust.yaml's `include_lanes` filter drops all of them downstream,
// and `total == kept.len()` looks identical to a fully successful run (this is the exact D2
// zero-signal failure mode this script exists to prevent). So this script now counts how many
// rows it actually relabeled and hard-fails (non-zero exit) when that count is zero on a
// non-empty input, instead of silently writing a corpus with no real signal.

import fs
import process

fn main() {
    let input_path = "mens/data/mix_sources/rust_source.jsonl"
    let output_path = "target/dogfood/rust_authoring.validated.jsonl"

    let content_res = fs.read(input_path)
    if content_res.is_err() {
        print("[build_rust_authoring_corpus] failed to read " + input_path)
        return
    }
    let content = content_res.unwrap()

    let raw_lines = content.split("\n")
    let n = raw_lines.len()

    let mut kept: list[str] = []
    let mut total = 0
    let mut relabeled_count = 0

    let mut i = 0
    while i < n {
        let line = raw_lines.get(i).unwrap()
        let trimmed = line.trim()
        if trimmed.len() > 0 {
            total = total + 1
            let relabeled = trimmed.replace("\"lane\":\"rust_context\"", "\"lane\":\"vox_rust_authoring\"")
            if not (relabeled is trimmed) {
                relabeled_count = relabeled_count + 1
            }
            kept = kept.push(relabeled)
        }
        i = i + 1
    }

    print("[build_rust_authoring_corpus] input_lines=" + str(total))
    print("[build_rust_authoring_corpus] relabeled_lines=" + str(relabeled_count))

    if total > 0 and relabeled_count is 0 {
        print("[build_rust_authoring_corpus] FATAL: 0 of " + str(total) + " input lines matched the rust_context lane marker — the relabel would silently produce a zero-signal corpus (every row still tagged with a lane mix-rust.yaml's include_lanes filters out). Check whether " + input_path + "'s lane field serialization changed.")
        process.exit(1)
    }

    if not fs.exists("target/dogfood") {
        match fs.mkdir("target/dogfood") { Ok(_) => {} Error(_) => {} }
    }

    let mut body = ""
    let mut j = 0
    while j < kept.len() {
        body = body + kept.get(j).unwrap() + "\n"
        j = j + 1
    }
    fs.write_file(output_path, body)

    print("[build_rust_authoring_corpus] output_lines=" + str(kept.len()))
    print("[build_rust_authoring_corpus] wrote " + output_path)
}
