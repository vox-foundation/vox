import py sig from "scipy.signal"

@uses(python)
fn compute_psd(samples: list[float]) to list[float] {
    return sig.periodogram(samples)
}

@uses(python)
fn main() {
    let psd = compute_psd([0.0, 1.0, 0.0, -1.0])
    assert(len(psd) > 0)
}
