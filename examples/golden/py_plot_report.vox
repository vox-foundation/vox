// ---
// title: "Plot revenue by month"
// description: "Build a grouped Polars frame and render a bar chart PNG via std.plot."
// syntax_version: "0.5.0"
// status: golden
// category: example
// constructs: [fn, import, std.frame, std.plot, Result, assert]
// training_eligible: true
// difficulty: beginner
// ---

import std.frame
import std.plot

@uses(python, fs)
fn main() {
    let rows = frame.scan_csv("fixtures/py_frame_report.csv").filter(frame.col("region").eq("west")).group_by(["month"]).agg([frame.col("amount").sum().alias("revenue")]).sort("month", nulls="last")
    let out = plot.bar(rows).x("month").y("revenue").title("West revenue").legend(false).save("out_revenue.png")
    assert(out.is_ok())
}
