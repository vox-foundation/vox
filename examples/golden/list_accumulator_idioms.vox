// ---
// title: "List Accumulator, 2D Grid, and Float Ratio Idioms"
// description: "Idiomatic Vox loops with range(start, end), for val, idx in list, Option-returning index match, 2D list[list[int]] traversal, and float() division."
// syntax_version: "0.6.0"
// status: golden
// category: example
// constructs: [fn, for, range, while, match, list, float, let_mut, @test]
// last_validated: 2026-11-15
